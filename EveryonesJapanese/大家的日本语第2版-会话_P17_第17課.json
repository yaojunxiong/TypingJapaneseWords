        "jp": "あのー",
        "zh": "那个……"
    },
    {
        "start": 48.8,
        "end": 51.1,
        "jp": "明日から東京へ出張しなければなりません",
        "zh": "我明天起要去东京出差。"
    },
    {
        "start": 51.1,
        "end": 53.8,

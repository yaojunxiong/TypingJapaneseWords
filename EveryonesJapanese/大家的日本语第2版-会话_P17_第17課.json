        "end": 18.0,
        "jp": "はい",
        "zh": "在。"
    },
    {
        "start": 18.0,
        "end": 19.8,
        "jp": "診察室へどうぞ",
        "zh": "请进诊察室。"
    },
    {
        "start": 19.8,
        "end": 26.3,
        "jp": "どうしましたか",
        "zh": "您哪里不舒服？"
    },
    {
        "start": 26.3,
        "end": 28.1,
        "jp": "昨日から喉が痛くて",
        "zh": "从昨天开始喉咙就很痛。"
    },
    {
        "start": 28.1,
        "end": 29.5,
        "jp": "熱も少しあります",

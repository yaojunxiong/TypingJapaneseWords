    },
    {
        "start": 53.8,
        "end": 55.5,
        "jp": "今日は薬を飲んで",
        "zh": "今天请先吃药，"
    },
    {
        "start": 55.5,
        "end": 56.8,
        "jp": "早く寝てください",
        "zh": "早点休息吧。"
    },
    {
        "start": 56.8,
        "end": 58.1,
        "jp": "はい",
        "zh": "好的。"
    },
    {
        "start": 58.1,

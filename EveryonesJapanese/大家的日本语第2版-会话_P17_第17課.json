        "zh": "今晚请不要洗澡哦。"
    },
    {
        "start": 63.0,
        "end": 64.6,
        "jp": "はい、わかりました",
        "zh": "好的，我知道了。"
    },
    {
        "start": 64.6,
        "end": 66.1,

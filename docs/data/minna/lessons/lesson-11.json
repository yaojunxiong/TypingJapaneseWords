    {
      "type": "grammar",
      "id": "l11_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l11_g01",
          "pattern": "N が 数量 あります／います",
          "title": {
            "zh": "数量存在句",
            "en": "Existence with quantity"
          },
          "explanation": {
            "zh": "表示某处有多少人或物。",
            "en": "Expresses how many people/things are in a place."
          },
          "examples": [
            {
              "jp": "教室に学生が五人います。",
              "zh": "教室里有五个学生。",
              "en": "There are five students in the classroom."
            }
          ],
          "practice": [
            {
              "id": "l11_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“房间里有三把椅子”是？",
                "en": "How to say: There are three chairs in the room?"
              },
              "options": [
                {
                  "text": {
                    "jp": "部屋にいすが三つあります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "部屋にいすを三つあります。"
                  }
                },
                {
                  "text": {
                    "jp": "部屋でいすが三ついます。"
                  }
                },
                {
                  "text": {
                    "jp": "部屋に三ついすがいます。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示某处有多少人或物。",
                "en": "Expresses how many people/things are in a place."
              }
            },
            {
              "id": "l11_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "问“有几个人？”最自然是？",
                "en": "How do you ask how many people there are?"
              },
              "options": [
                {
                  "text": {
                    "jp": "何人いますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "何人ですか。"
                  }
                },
                {
                  "text": {
                    "jp": "何人がありますか。"
                  }
                },
                {
                  "text": {
                    "jp": "何人をいますか。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示某处有多少人或物。",
                "en": "Expresses how many people/things are in a place."
              }
            }
          ]
        },
        {
          "id": "l11_g02",
          "pattern": "N を 数量 V",
          "title": {
            "zh": "数量词放在动词前",
            "en": "Quantifier before verb"
          },
          "explanation": {
            "zh": "数量词常放在助词后、动词前。",
            "en": "Quantifiers often appear before the verb."
          },
          "examples": [
            {
              "jp": "りんごを二つ買いました。",
              "zh": "买了两个苹果。",
              "en": "I bought two apples."
            }
          ],
          "practice": [
            {
              "id": "l11_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我喝了两杯咖啡”是？",
                "en": "How to say: I drank two cups of coffee?"
              },
              "options": [
                {
                  "text": {
                    "jp": "コーヒーを二杯飲みました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "コーヒー二杯を飲みました。"
                  }
                },
                {
                  "text": {
                    "jp": "コーヒーを飲みました二杯。"
                  }
                },
                {
                  "text": {
                    "jp": "コーヒーで二杯飲みました。"
                  }
                }
              ],
              "explanation": {
                "zh": "数量词常放在助词后、动词前。",
                "en": "Quantifiers often appear before the verb."
              }
            },
            {
              "id": "l11_g02_p02",
              "skill": "grammar",
              "question": {
                "zh": "下列哪句语序更自然？",
                "en": "Which word order is most natural?"
              },
              "options": [
                {
                  "text": {
                    "jp": "本を三冊読みました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "本三冊を読みました。"
                  }
                },
                {
                  "text": {
                    "jp": "三冊本を読みました。"
                  }
                },
                {
                  "text": {
                    "jp": "本に三冊読みました。"
                  }
                }
              ],
              "explanation": {
                "zh": "数量词常放在助词后、动词前。",
                "en": "Quantifiers often appear before the verb."
              }
            }
          ]
        },
        {
          "id": "l11_g03",
          "pattern": "N から N まで 〜かかります",
          "title": {
            "zh": "所需时间",
            "en": "Duration required"
          },
          "explanation": {
            "zh": "表示从A到B需要多少时间。",
            "en": "Shows how long it takes from A to B."
          },
          "examples": [
            {
              "jp": "大阪から東京まで三時間かかります。",
              "zh": "从大阪到东京要三小时。",
              "en": "It takes three hours from Osaka to Tokyo."
            }
          ],
          "practice": [
            {
              "id": "l11_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“从家到学校要20分钟”是？",
                "en": "How to say: It takes 20 minutes from home to school?"
              },
              "options": [
                {
                  "text": {
                    "jp": "うちから学校まで二十分かかります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "うちで学校まで二十分かかります。"
                  }
                },
                {
                  "text": {
                    "jp": "うちから学校を二十分かかります。"
                  }
                },
                {
                  "text": {
                    "jp": "うちから学校まで二十分があります。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示从A到B需要多少时间。",
                "en": "Shows how long it takes from A to B."
              }
            },
            {
              "id": "l11_g03_p02",
              "skill": "grammar",
              "question": {
                "zh": "问时间长短应使用？",
                "en": "Which asks duration?"
              },
              "options": [
                {
                  "text": {
                    "jp": "どのくらいかかりますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "何時ですか。"
                  }
                },
                {
                  "text": {
                    "jp": "何人いますか。"
                  }
                },
                {
                  "text": {
                    "jp": "どこですか。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示从A到B需要多少时间。",
                "en": "Shows how long it takes from A to B."
              }
            }
          ]
        },
        {
          "id": "l11_g04",
          "pattern": "一週間に N 回",
          "title": {
            "zh": "频率表达",
            "en": "Frequency expression"
          },
          "explanation": {
            "zh": "用“单位时间+次数”表达频率。",
            "en": "Use time unit + number of times for frequency."
          },
          "examples": [
            {
              "jp": "一週間に三回ジムへ行きます。",
              "zh": "一周去三次健身房。",
              "en": "I go to the gym three times a week."
            }
          ],
          "practice": [
            {
              "id": "l11_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“一个月去一次”是？",
                "en": "How to say: once a month?"
              },
              "options": [
                {
                  "text": {
                    "jp": "一か月に一回行きます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "一か月で一回行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "一か月を一回行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "一か月に一回あります。"
                  }
                }
              ],
              "explanation": {
                "zh": "用“单位时间+次数”表达频率。",
                "en": "Use time unit + number of times for frequency."
              }
            },
            {
              "id": "l11_g04_p02",
              "skill": "grammar",
              "question": {
                "zh": "“每天学习两小时”最自然是？",
                "en": "Most natural: study 2 hours every day?"
              },
              "options": [
                {
                  "text": {
                    "jp": "毎日二時間勉強します。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "毎日を二時間勉強します。"
                  }
                },
                {
                  "text": {
                    "jp": "毎日で二時間勉強します。"
                  }
                },
                {
                  "text": {
                    "jp": "二時間毎日を勉強します。"
                  }
                }
              ],
              "explanation": {
                "zh": "用“单位时间+次数”表达频率。",
                "en": "Use time unit + number of times for frequency."
              }
            }
          ]
        }
      ]
    },

      "items": [
        {
          "id": "l24_g01",
          "pattern": "N1 は 私に N2を くれます",
          "title": {
            "zh": "给我（方）",
            "en": "Giving to me/us"
          },
          "explanation": {
            "zh": "主语给“我方”时用くれます。",
            "en": "Use kuremasu when someone gives to me/us."
          },
          "examples": [
            {
              "jp": "友だちは私に本をくれました。",
              "zh": "朋友给了我一本书。",
              "en": "My friend gave me a book."
            }
          ],
          "practice": [
            {
              "id": "l24_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“老师给了我礼物”是？",
                "en": "How to say: The teacher gave me a present?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生は私にプレゼントをくれました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生は私にプレゼントをあげました。"
                  }
                },
                {
                  "text": {
                    "jp": "先生は私がプレゼントをくれました。"
                  }
                },
                {
                  "text": {
                    "jp": "先生は私をプレゼントをくれました。"
                  }
                }
              ],
              "explanation": {
                "zh": "主语给“我方”时用くれます。",
                "en": "Use kuremasu when someone gives to me/us."
              }
            },
            {
              "id": "l24_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“妹妹给妈妈花”不该用？",
                "en": "Which should not be used for giving to me/us?"
              },
              "options": [
                {
                  "text": {
                    "jp": "あげました"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "くれました"
                  }
                },
                {
                  "text": {
                    "jp": "もらいました"
                  }
                },
                {
                  "text": {
                    "jp": "くださいました"
                  }
                }
              ],
              "explanation": {
                "zh": "主语给“我方”时用くれます。",
                "en": "Use kuremasu when someone gives to me/us."
              }
            }
          ]
        },

              "text": {
                "zh": "给我（方）",
                "en": "give (to me/us)"
              },
              "correct": true
            },
            {
              "text": {
                "zh": "带去",
                "en": "take someone along"
              }
            },
            {
              "text": {
                "zh": "带来",
                "en": "bring someone along"
              }
            },
            {
              "text": {
                "zh": "送（人/物）",
                "en": "send/escort"
              }
            }
          ],
          "explanation": {
            "zh": "「くれます」表示「给我（方）」。",
            "en": "くれます means give (to me/us)."
          }
        },
        {
          "id": "l24_q02",
          "question": {
            "zh": "哪一句最符合语法「N1 は 私に N2を くれます」？",

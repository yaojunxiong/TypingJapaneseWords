              }
            },
            {
              "text": {
                "jp": "私は友だちに宿題を手伝ってもらいました。"
              }
            }
          ],
          "explanation": {
            "zh": "正确句型是「N1 は 私に N2を くれます」。",
            "en": "The correct pattern is \"N1 は 私に N2を くれます\"."
          }
        },

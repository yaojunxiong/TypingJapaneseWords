      "type": "grammar",
      "id": "l05_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l05_g01",
          "pattern": "場所へ 行きます / 来ます / 帰ります",
          "title": {
            "zh": "去/来/回到某地",
            "en": "Go/Come/Return to a place"
          },
          "explanation": {
            "zh": "目的地后接「へ」，表示移动方向。",
            "en": "Use 「へ」 after destination to indicate direction."
          },
          "examples": [
            {
              "jp": "学校へ 行きます。",
              "zh": "去学校。",
              "en": "I go to school."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“去车站”应说？",
                "en": "How to say “go to the station”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "駅へ 行きます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "駅で 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "駅を 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "駅にで 行きます。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "表示移动方向常用？",
                "en": "Which marks destination direction?"
              },
              "options": [
                {
                  "text": {
                    "jp": "へ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "を"
                  }
                },
                {
                  "text": {
                    "jp": "が"
                  }
                },
                {
                  "text": {
                    "jp": "で"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l05_g02",
          "pattern": "交通工具で 行きます",
          "title": {
            "zh": "用交通工具去",
            "en": "Go by transportation"
          },
          "explanation": {
            "zh": "交通工具后接「で」，表示方式。",
            "en": "Use 「で」 after transportation to show means."
          },
          "examples": [
            {
              "jp": "電車で 会社へ 行きます。",
              "zh": "我坐电车去公司。",
              "en": "I go to the office by train."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“坐公交去”应说？",
                "en": "How to say “go by bus”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "バスで 行きます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "バスへ 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "バスが 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "バスを 行きます。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“步行去”可说？",
                "en": "How to say “go on foot”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "歩いて 行きます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "歩きで 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "歩くで 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "歩いてへ 行きます。"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l05_g03",
          "pattern": "人と 行きます / ひとりで 行きます",
          "title": {
            "zh": "和谁去 / 一个人去",
            "en": "Go with someone / go alone"
          },
          "explanation": {
            "zh": "与人同行常用「人と」。一个人可用「ひとりで」。",
            "en": "Use 「人と」 for companion and 「ひとりで」 for alone."
          },
          "examples": [
            {
              "jp": "友達と 学校へ 行きます。",
              "zh": "和朋友去学校。",
              "en": "I go to school with a friend."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“和朋友去”是？",
                "en": "How to say “go with a friend”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "友達と 行きます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "友達で 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "友達を 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "友達へ 行きます。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“一个人回家”是？",
                "en": "How to say “go home alone”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ひとりで うちへ 帰ります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ひとりと うちへ 帰ります。"
                  }
                },
                {
                  "text": {
                    "jp": "ひとりを うちへ 帰ります。"
                  }
                },
                {
                  "text": {
                    "jp": "ひとりへ うちへ 帰ります。"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l05_g04",
          "pattern": "いつ 〜ますか",
          "title": {
            "zh": "什么时候做某事",
            "en": "When do you ~?"
          },
          "explanation": {
            "zh": "询问时间用「いつ」。像「きのう」「あした」通常不用「に」。",
            "en": "Use 「いつ」 to ask time. Words like yesterday/tomorrow usually do not take 「に」."
          },
          "examples": [
            {
              "jp": "いつ 日本へ 来ますか。",
              "zh": "你什么时候来日本？",
              "en": "When will you come to Japan?"
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“你什么时候回家？”是？",
                "en": "How to say “When do you go home?”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "いつ うちへ 帰りますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "いつに うちへ 帰りますか。"
                  }
                },
                {
                  "text": {
                    "jp": "うちへ いつで 帰りますか。"
                  }
                },
                {
                  "text": {
                    "jp": "いつ うちで 帰りますか。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“明天去学校”是？",
                "en": "How to say “go to school tomorrow”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "あした 学校へ 行きます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "あしたに 学校へ 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "あした 学校で 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "あした 学校を 行きます。"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "examples",
      "id": "l05_examples",
      "title": {
        "zh": "核心例句",
        "en": "Core Examples",
        "ja": "基本例文"
      },
      "items": [
        {
          "id": "l05_e01",
          "jp": "きのう 会社へ 行きました。",
          "zh": "昨天去了公司。",
          "en": "I went to the office yesterday."
        },
        {
          "id": "l05_e02",
          "jp": "毎朝 電車で 学校へ 行きます。",
          "zh": "每天早上坐电车去学校。",
          "en": "I go to school by train every morning."
        },
        {
          "id": "l05_e03",
          "jp": "日曜日に 友達と 京都へ 行きます。",
          "zh": "星期天和朋友去京都。",
          "en": "I will go to Kyoto with a friend on Sunday."
        },
        {
          "id": "l05_e04",
          "jp": "あした ひとりで うちへ 帰ります。",
          "zh": "明天一个人回家。",
          "en": "I will go home alone tomorrow."
        },
        {
          "id": "l05_e05",
          "jp": "いつ 日本へ 来ますか。",
          "zh": "你什么时候来日本？",
          "en": "When will you come to Japan?"
        }
      ]
    },

    {
      "type": "grammar",
      "id": "l03_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l03_g01",
          "pattern": "ここ / そこ / あそこ",
          "title": {
            "zh": "这里 / 那里 / 那边",
            "en": "here / there / over there"
          },
          "explanation": {
            "zh": "表示地点的指示词：近说话人用「ここ」，近听话人用「そこ」，离双方都远用「あそこ」。",
            "en": "Place demonstratives: 「ここ」 near speaker, 「そこ」 near listener, 「あそこ」 far from both."
          },
          "examples": [
            {
              "jp": "ここは 教室です。",
              "zh": "这里是教室。",
              "en": "This is the classroom."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "离双方都远的地点用？",
                "en": "Which refers to a place far from both?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ここ"
                  }
                },
                {
                  "text": {
                    "jp": "そこ"
                  }
                },
                {
                  "text": {
                    "jp": "あそこ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "どこ"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "靠近听话人的地点用？",
                "en": "Which refers to a place near the listener?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ここ"
                  }
                },
                {
                  "text": {
                    "jp": "そこ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "あそこ"
                  }
                },
                {
                  "text": {
                    "jp": "どちら"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l03_g02",
          "pattern": "～は どこですか",
          "title": {
            "zh": "～在哪里？",
            "en": "Where is ~?"
          },
          "explanation": {
            "zh": "询问地点时，用「名词は どこですか」。",
            "en": "Use 「Noun は どこですか」 to ask location."
          },
          "examples": [
            {
              "jp": "トイレは どこですか。",
              "zh": "洗手间在哪里？",
              "en": "Where is the toilet?"
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“食堂在哪里？”怎么说？",
                "en": "How do you say “Where is the cafeteria?”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "食堂は どこですか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "食堂は どちらです。"
                  }
                },
                {
                  "text": {
                    "jp": "食堂は ここですか。"
                  }
                },
                {
                  "text": {
                    "jp": "食堂 どこですか。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "询问地点时关键疑问词是？",
                "en": "Which question word asks place?"
              },
              "options": [
                {
                  "text": {
                    "jp": "だれ"
                  }
                },
                {
                  "text": {
                    "jp": "どこ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "なに"
                  }
                },
                {
                  "text": {
                    "jp": "いつ"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l03_g03",
          "pattern": "こちら / そちら / あちら / どちら",
          "title": {
            "zh": "礼貌说法：这边/那边/哪边",
            "en": "Polite forms: this way/that way/which way"
          },
          "explanation": {
            "zh": "「こちら・そちら・あちら・どちら」是更礼貌的说法，也可用于指人方向。",
            "en": "These are more polite alternatives and can refer to direction/person side."
          },
          "examples": [
            {
              "jp": "受付は こちらです。",
              "zh": "前台在这边。",
              "en": "Reception is this way."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "「どこ」的礼貌说法是？",
                "en": "Polite form of 「どこ」 is?"
              },
              "options": [
                {
                  "text": {
                    "jp": "どちら"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "こちら"
                  }
                },
                {
                  "text": {
                    "jp": "そちら"
                  }
                },
                {
                  "text": {
                    "jp": "あちら"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“前台在这边”可说？",
                "en": "How to say “Reception is this way”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "受付は こちらです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "受付は ここですか。"
                  }
                },
                {
                  "text": {
                    "jp": "受付は どちらです。"
                  }
                },
                {
                  "text": {
                    "jp": "受付 こちらですか。"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l03_g04",
          "pattern": "～も",
          "title": {
            "zh": "～也",
            "en": "~ too / also"
          },
          "explanation": {
            "zh": "表示“也”时，可以把「は」换成「も」。",
            "en": "Use 「も」 to mean “also/too”, often replacing 「は」."
          },
          "examples": [
            {
              "jp": "会議室も 2階です。",
              "zh": "会议室也在2楼。",
              "en": "The meeting room is also on the 2nd floor."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "表示“也”应使用？",
                "en": "Which particle means “also”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "は"
                  }
                },
                {
                  "text": {
                    "jp": "も"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "を"
                  }
                },
                {
                  "text": {
                    "jp": "で"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“教室也在这里”可说？",
                "en": "How to say “The classroom is also here”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "教室も ここです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "教室は も ここです。"
                  }
                },
                {
                  "text": {
                    "jp": "教室を ここです。"
                  }
                },
                {
                  "text": {
                    "jp": "教室どこも ここです。"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "examples",

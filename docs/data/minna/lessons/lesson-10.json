      "type": "grammar",
      "id": "l10_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l10_g01",
          "pattern": "場所に 物/人が あります・います",
          "title": {
            "zh": "某处有某物/某人",
            "en": "There is ~ at ~"
          },
          "explanation": {
            "zh": "物品用「あります」，人和动物用「います」。",
            "en": "Use 「あります」 for things, 「います」 for people/animals."
          },
          "examples": [
            {
              "jp": "つくえの 上に 本が あります。",
              "zh": "桌子上有书。",
              "en": "There is a book on the desk."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“椅子下面有猫”是？",
                "en": "How to say “There is a cat under the chair”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "いすの したに ねこが います。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "いすの したに ねこが あります。"
                  }
                },
                {
                  "text": {
                    "jp": "いすの したで ねこが います。"
                  }
                },
                {
                  "text": {
                    "jp": "いすの したを ねこが います。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“书在桌上”应使用？",
                "en": "For books on desk, which verb?"
              },
              "options": [
                {
                  "text": {
                    "jp": "あります"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "います"
                  }
                },
                {
                  "text": {
                    "jp": "です"
                  }
                },
                {
                  "text": {
                    "jp": "します"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l10_g02",
          "pattern": "N1は N2に あります・います",
          "title": {
            "zh": "N1在N2",
            "en": "N1 is in/at N2"
          },
          "explanation": {
            "zh": "已知话题做主语时常用「N1は N2に あります/います」。",
            "en": "Use topic pattern 「N1 は N2 に あります/います」 for known subjects."
          },
          "examples": [
            {
              "jp": "トイレは あそこに あります。",
              "zh": "洗手间在那边。",
              "en": "The toilet is over there."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“老师在教室里”是？",
                "en": "How to say “The teacher is in the classroom”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生は 教室に います。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生は 教室に あります。"
                  }
                },
                {
                  "text": {
                    "jp": "先生が 教室を います。"
                  }
                },
                {
                  "text": {
                    "jp": "先生は 教室で あります。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“银行在车站前”是？",
                "en": "How to say “The bank is in front of station”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "銀行は 駅の 前に あります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "銀行は 駅の 前に います。"
                  }
                },
                {
                  "text": {
                    "jp": "銀行が 駅の 前を あります。"
                  }
                },
                {
                  "text": {
                    "jp": "銀行で 駅の 前に あります。"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l10_g03",
          "pattern": "どこに ありますか / いますか",
          "title": {
            "zh": "在哪里有〜",
            "en": "Where is ~?"
          },
          "explanation": {
            "zh": "询问位置用「どこに」。",
            "en": "Use 「どこに」 to ask location."
          },
          "examples": [
            {
              "jp": "かぎは どこに ありますか。",
              "zh": "钥匙在哪里？",
              "en": "Where is the key?"
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "问“猫在哪里？”是？",
                "en": "How to ask “Where is the cat?”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ねこは どこに いますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ねこは どこで いますか。"
                  }
                },
                {
                  "text": {
                    "jp": "ねこは どこを いますか。"
                  }
                },
                {
                  "text": {
                    "jp": "ねこは どこが いますか。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "问“书在哪里？”是？",
                "en": "How to ask “Where is the book?”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "本は どこに ありますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "本は どこに いますか。"
                  }
                },
                {
                  "text": {
                    "jp": "本は どこで ありますか。"
                  }
                },
                {
                  "text": {
                    "jp": "本は どこを ありますか。"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l10_g04",
          "pattern": "N1やN2（など）があります",
          "title": {
            "zh": "并列列举有〜",
            "en": "Listing with や"
          },
          "explanation": {
            "zh": "列举不完整项目可用「N1やN2（など）」。",
            "en": "Use 「や」 to list representative items (non-exhaustive)."
          },
          "examples": [
            {
              "jp": "かばんの 中に 本や てがみが あります。",
              "zh": "包里有书和信等。",
              "en": "There are books and letters in the bag."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“箱子里有照片和信”是？",
                "en": "How to say “There are photos and letters in the box”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "箱の 中に 写真や 手紙が あります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "箱の 中に 写真と 手紙を あります。"
                  }
                },
                {
                  "text": {
                    "jp": "箱の 中で 写真や 手紙が あります。"
                  }
                },
                {
                  "text": {
                    "jp": "箱の 中に 写真や 手紙が います。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "并列举例常用？",
                "en": "Which particle lists sample items?"
              },
              "options": [
                {
                  "text": {
                    "jp": "や"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "を"
                  }
                },
                {
                  "text": {
                    "jp": "に"
                  }
                },
                {
                  "text": {
                    "jp": "が"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "examples",
      "id": "l10_examples",
      "title": {

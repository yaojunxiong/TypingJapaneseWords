      "type": "grammar",
      "id": "l06_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l06_g01",
          "pattern": "名词を 動词",
          "title": {
            "zh": "宾语 + 动词",
            "en": "Object + verb"
          },
          "explanation": {
            "zh": "动作对象后用「を」。",
            "en": "Use 「を」 after the object of an action."
          },
          "examples": [
            {
              "jp": "映画を 見ます。",
              "zh": "看电影。",
              "en": "I watch a movie."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“喝水”是？",
                "en": "How to say “drink water”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "水を 飲みます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "水で 飲みます。"
                  }
                },
                {
                  "text": {
                    "jp": "水が 飲みます。"
                  }
                },
                {
                  "text": {
                    "jp": "水に 飲みます。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "宾语后应接？",
                "en": "Which particle marks object?"
              },
              "options": [
                {
                  "text": {
                    "jp": "を"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "で"
                  }
                },
                {
                  "text": {
                    "jp": "に"
                  }
                },
                {
                  "text": {
                    "jp": "と"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l06_g02",
          "pattern": "何を 〜ますか",
          "title": {
            "zh": "问做什么",
            "en": "What do you do?"
          },
          "explanation": {
            "zh": "询问动作对象用「何を〜ますか」。",
            "en": "Use 「何を〜ますか」 to ask action object."
          },
          "examples": [
            {
              "jp": "何を 食べますか。",
              "zh": "吃什么？",
              "en": "What will you eat?"
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“你看什么？”是？",
                "en": "How to ask “What do you watch?”"
              },
              "options": [
                {
                  "text": {
                    "jp": "何を 見ますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "何が 見ますか。"
                  }
                },
                {
                  "text": {
                    "jp": "何で 見ますか。"
                  }
                },
                {
                  "text": {
                    "jp": "何に 見ますか。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“写信”是？",
                "en": "How to say “write a letter”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "手紙を 書きます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "手紙で 書きます。"
                  }
                },
                {
                  "text": {
                    "jp": "手紙に 書きます。"
                  }
                },
                {
                  "text": {
                    "jp": "手紙が 書きます。"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l06_g03",
          "pattern": "〜ませんか",
          "title": {
            "zh": "一起做吗（邀请）",
            "en": "Won’t you ~? (invitation)"
          },
          "explanation": {
            "zh": "「〜ませんか」用于较礼貌地邀请对方。",
            "en": "Use 「〜ませんか」 for polite invitations."
          },
          "examples": [
            {
              "jp": "いっしょに 映画を 見ませんか。",
              "zh": "一起看电影吗？",
              "en": "Would you like to watch a movie together?"
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“一起吃饭吗？”是？",
                "en": "How to invite “Shall we eat together?”"
              },
              "options": [
                {
                  "text": {
                    "jp": "いっしょに ご飯を 食べませんか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "いっしょに ご飯を 食べますか。"
                  }
                },
                {
                  "text": {
                    "jp": "いっしょに ご飯が 食べませんか。"
                  }
                },
                {
                  "text": {
                    "jp": "いっしょに ご飯を 食べましょうか。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "邀请句尾常用？",
                "en": "Invitation ending is?"
              },
              "options": [
                {
                  "text": {
                    "jp": "〜ませんか"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "〜でした"
                  }
                },
                {
                  "text": {
                    "jp": "〜ですか"
                  }
                },
                {
                  "text": {
                    "jp": "〜ませんでした"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l06_g04",
          "pattern": "〜ましょう",
          "title": {
            "zh": "我们来做吧",
            "en": "Let’s ~"
          },
          "explanation": {
            "zh": "「〜ましょう」表示说话者提议一起做。",
            "en": "「〜ましょう」 is used to suggest doing something together."
          },
          "examples": [
            {
              "jp": "写真を 撮りましょう。",
              "zh": "我们来拍照吧。",
              "en": "Let’s take a picture."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“来听音乐吧”是？",
                "en": "How to say “Let’s listen to music”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "音楽を 聞きましょう。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "音楽を 聞きませんか。"
                  }
                },
                {
                  "text": {
                    "jp": "音楽で 聞きましょう。"
                  }
                },
                {
                  "text": {
                    "jp": "音楽を 聞きました。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“我们来做作业吧”是？",
                "en": "How to say “Let’s do homework”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "宿題を しましょう。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "宿題を します。"
                  }
                },
                {
                  "text": {
                    "jp": "宿題で しましょう。"
                  }
                },
                {
                  "text": {
                    "jp": "宿題を しませんでした。"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {

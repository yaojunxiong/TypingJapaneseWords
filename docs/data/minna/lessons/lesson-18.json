                    "jp": "仕事でまえにコーヒーを飲みます。"
                  }
                },
                {
                  "text": {
                    "jp": "仕事をまえにコーヒーを飲みます。"
                  }
                },
                {
                  "text": {
                    "jp": "仕事まえにコーヒーを飲みます。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示在某动作之前。",
                "en": "Indicates an action done before another one."
              }
            }
          ]
        },
        {
          "id": "l18_g04",
          "pattern": "N の まえに",
          "title": {
            "zh": "名词前",
            "en": "Before a noun event"
          },
          "explanation": {
            "zh": "名词后接「のまえに」。",
            "en": "Use no mae ni after nouns."
          },
          "examples": [
            {
              "jp": "会議のまえに資料を見ます。",
              "zh": "开会前看资料。",
              "en": "I check materials before the meeting."
            }
          ],
          "practice": [
            {

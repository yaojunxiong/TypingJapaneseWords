      "type": "grammar",
      "id": "l18_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l18_g01",
          "pattern": "V辞書形 ことができます",
          "title": {
            "zh": "能力表达",
            "en": "Can do~"
          },
          "explanation": {
            "zh": "表示会做某事。",
            "en": "Expresses one's ability."
          },
          "examples": [
            {
              "jp": "私はギターを弾くことができます。",
              "zh": "我会弹吉他。",
              "en": "I can play the guitar."
            }
          ],
          "practice": [
            {
              "id": "l18_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我会开车”是？",
                "en": "How to say: I can drive?"
              },
              "options": [
                {
                  "text": {
                    "jp": "私は車を運転することができます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "私は車を運転してことができます。"
                  }
                },
                {
                  "text": {
                    "jp": "私は車を運転しますことができます。"
                  }
                },
                {
                  "text": {
                    "jp": "私は車が運転ことができます。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示会做某事。",
                "en": "Expresses one's ability."
              }
            },
            {
              "id": "l18_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“你会做日本菜吗”是？",
                "en": "How to ask: Can you cook Japanese food?"
              },
              "options": [
                {
                  "text": {
                    "jp": "日本料理を作ることができますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "日本料理を作ってことができますか。"
                  }
                },
                {
                  "text": {
                    "jp": "日本料理を作りますことができますか。"
                  }
                },
                {
                  "text": {
                    "jp": "日本料理が作ることですか。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示会做某事。",
                "en": "Expresses one's ability."
              }
            }
          ]
        },
        {
          "id": "l18_g02",
          "pattern": "趣味は V辞書形 ことです",
          "title": {
            "zh": "爱好表达",
            "en": "Stating a hobby"
          },
          "explanation": {
            "zh": "用「ことです」把动词名词化。",
            "en": "Nominalize verbs with koto for hobbies."
          },
          "examples": [
            {
              "jp": "私の趣味は写真を撮ることです。",
              "zh": "我的爱好是拍照。",
              "en": "My hobby is taking photos."
            }
          ],
          "practice": [
            {
              "id": "l18_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我的爱好是听音乐”是？",
                "en": "How to say: My hobby is listening to music?"
              },
              "options": [
                {
                  "text": {
                    "jp": "私の趣味は音楽を聞くことです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "私の趣味は音楽を聞いてことです。"
                  }
                },
                {
                  "text": {
                    "jp": "私の趣味は音楽を聞きますことです。"
                  }
                },
                {
                  "text": {
                    "jp": "私の趣味は音楽が聞くことです。"
                  }
                }
              ],
              "explanation": {
                "zh": "用「ことです」把动词名词化。",
                "en": "Nominalize verbs with koto for hobbies."
              }
            },
            {
              "id": "l18_g02_p02",
              "skill": "grammar",
              "question": {
                "zh": "“她的爱好是做饭”是？",
                "en": "How to say: Her hobby is cooking?"
              },
              "options": [
                {
                  "text": {
                    "jp": "彼女の趣味は料理することです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "彼女の趣味は料理してことです。"
                  }
                },
                {
                  "text": {
                    "jp": "彼女の趣味は料理しますことです。"
                  }
                },
                {
                  "text": {
                    "jp": "彼女の趣味は料理がことです。"
                  }
                }
              ],
              "explanation": {
                "zh": "用「ことです」把动词名词化。",
                "en": "Nominalize verbs with koto for hobbies."
              }
            }
          ]
        },
        {
          "id": "l18_g03",
          "pattern": "V辞書形 まえに",
          "title": {
            "zh": "动作前",
            "en": "Before doing~"
          },
          "explanation": {
            "zh": "表示在某动作之前。",
            "en": "Indicates an action done before another one."
          },
          "examples": [
            {
              "jp": "寝るまえに本を読みます。",
              "zh": "睡觉前看书。",
              "en": "I read a book before sleeping."
            }
          ],
          "practice": [
            {
              "id": "l18_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“吃饭前洗手”是？",
                "en": "How to say: wash hands before eating?"
              },
              "options": [
                {
                  "text": {
                    "jp": "食事するまえに手を洗います。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "食事してまえに手を洗います。"
                  }
                },
                {
                  "text": {
                    "jp": "食事しますまえに手を洗います。"
                  }
                },
                {
                  "text": {
                    "jp": "食事のまえに手を洗いです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示在某动作之前。",
                "en": "Indicates an action done before another one."
              }
            },
            {
              "id": "l18_g03_p02",
              "skill": "grammar",
              "question": {
                "zh": "“上班前喝咖啡”是？",
                "en": "How to say: drink coffee before work?"

        {
          "id": "l18_q01",
          "question": {
            "zh": "「できます」的意思是？",
            "en": "What does できます mean?"
          },
          "options": [
            {
              "text": {
                "zh": "会；能",
                "en": "can / be able to"
              },
              "correct": true
            },
            {
              "text": {
                "zh": "弹奏",
                "en": "play (instrument)"
              }
            },
            {
              "text": {
                "zh": "驾驶",
                "en": "drive"
              }
            },
            {
              "text": {
                "zh": "做饭",
                "en": "cook"
              }
            }
          ],
          "explanation": {
            "zh": "「できます」表示「会；能」。",
            "en": "できます means can / be able to."
          }
        },
        {
          "id": "l18_q02",
          "question": {
            "zh": "哪一句最符合语法「V辞書形 ことができます」？",

      "type": "grammar",
      "id": "l17_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l17_g01",
          "pattern": "Vないで ください",
          "title": {
            "zh": "否定请求",
            "en": "Negative request"
          },
          "explanation": {
            "zh": "礼貌要求对方不要做某事。",
            "en": "Politely ask someone not to do something."
          },
          "examples": [
            {
              "jp": "ここにごみを捨てないでください。",
              "zh": "请不要在这里扔垃圾。",
              "en": "Please do not throw trash here."
            }
          ],
          "practice": [
            {
              "id": "l17_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“请不要忘记作业”是？",
                "en": "How to say: Please do not forget homework?"
              },
              "options": [
                {
                  "text": {
                    "jp": "宿題を忘れないでください。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "宿題を忘れてください。"
                  }
                },
                {
                  "text": {
                    "jp": "宿題を忘れなくてください。"
                  }
                },
                {
                  "text": {
                    "jp": "宿題が忘れないでください。"
                  }
                }
              ],
              "explanation": {
                "zh": "礼貌要求对方不要做某事。",
                "en": "Politely ask someone not to do something."
              }
            },
            {
              "id": "l17_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“请不要在这里停车”是？",
                "en": "How to say: Please do not park here?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ここに車を止めないでください。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ここに車を止めてください。"
                  }
                },
                {
                  "text": {
                    "jp": "ここで車を止めないです。"
                  }
                },
                {
                  "text": {
                    "jp": "ここに車が止めないでください。"
                  }
                }
              ],
              "explanation": {
                "zh": "礼貌要求对方不要做某事。",
                "en": "Politely ask someone not to do something."
              }
            }
          ]
        },
        {
          "id": "l17_g02",
          "pattern": "Vなければ なりません",
          "title": {
            "zh": "必须表达",
            "en": "Obligation"
          },
          "explanation": {
            "zh": "表示必须做某事。",
            "en": "Indicates necessity/obligation."
          },
          "examples": [
            {
              "jp": "明日早く起きなければなりません。",
              "zh": "明天必须早起。",
              "en": "I must wake up early tomorrow."
            }
          ],
          "practice": [
            {
              "id": "l17_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“今天必须交文件”是？",
                "en": "How to say: Must submit documents today?"
              },
              "options": [
                {
                  "text": {
                    "jp": "今日書類を出さなければなりません。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "今日書類を出してはいけません。"
                  }
                },
                {
                  "text": {
                    "jp": "今日書類を出さないでください。"
                  }
                },
                {
                  "text": {
                    "jp": "今日書類を出さなくてもいいです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示必须做某事。",
                "en": "Indicates necessity/obligation."
              }
            },
            {
              "id": "l17_g02_p02",
              "skill": "grammar",
              "question": {
                "zh": "“必须还书”是？",
                "en": "How to say: Must return the book?"
              },
              "options": [
                {
                  "text": {
                    "jp": "本を返さなければなりません。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "本を返してもいいです。"
                  }
                },
                {
                  "text": {
                    "jp": "本を返さないでください。"
                  }
                },
                {
                  "text": {
                    "jp": "本を返すないといけません。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示必须做某事。",
                "en": "Indicates necessity/obligation."
              }
            }
          ]
        },
        {
          "id": "l17_g03",
          "pattern": "Vなくても いいです",
          "title": {
            "zh": "不必表达",
            "en": "Not necessary"
          },
          "explanation": {
            "zh": "表示不做也没关系。",
            "en": "Says something is optional."
          },
          "examples": [
            {
              "jp": "明日は来なくてもいいです。",
              "zh": "明天不来也可以。",
              "en": "You do not have to come tomorrow."
            }
          ],
          "practice": [
            {
              "id": "l17_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“今天不用加班”是？",
                "en": "How to say: You do not have to work overtime today?"
              },
              "options": [
                {
                  "text": {
                    "jp": "今日は残業しなくてもいいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "今日は残業しなければなりません。"
                  }
                },
                {
                  "text": {
                    "jp": "今日は残業しないでください。"
                  }
                },
                {
                  "text": {
                    "jp": "今日は残業してはいけません。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示不做也没关系。",
                "en": "Says something is optional."
              }
            },
            {
              "id": "l17_g03_p02",
              "skill": "grammar",
              "question": {
                "zh": "“作业可以不交吗？”是？",
                "en": "How to ask: May I not submit homework?"
              },
              "options": [
                {
                  "text": {
                    "jp": "宿題を出さなくてもいいですか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "宿題を出さないでくださいか。"
                  }
                },
                {
                  "text": {
                    "jp": "宿題を出してもいいですか。"
                  }
                },
                {
                  "text": {
                    "jp": "宿題を出さなくてくださいか。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示不做也没关系。",
                "en": "Says something is optional."
              }
            }
          ]
        },
        {
          "id": "l17_g04",
          "pattern": "〜ないと いけません",
          "title": {
            "zh": "口语必须",
            "en": "Spoken obligation"
          },
          "explanation": {
            "zh": "与「なければなりません」意义相近，更口语。",
            "en": "Casual spoken equivalent of obligation."
          },
          "examples": [
            {
              "jp": "もう帰らないといけません。",
              "zh": "我得回去了。",
              "en": "I have to go home now."
            }
          ],
          "practice": [
            {
              "id": "l17_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我得付款了”是？",
                "en": "How to say: I have to pay now?"
              },
              "options": [
                {
                  "text": {
                    "jp": "もう払わないといけません。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "もう払ってはいけません。"
                  }
                },
                {
                  "text": {
                    "jp": "もう払わなくてもいいです。"
                  }
                },
                {
                  "text": {
                    "jp": "もう払いないといけません。"
                  }
                }
              ],
              "explanation": {
                "zh": "与「なければなりません」意义相近，更口语。",
                "en": "Casual spoken equivalent of obligation."
              }
            },
            {
              "id": "l17_g04_p02",
              "skill": "grammar",
              "question": {
                "zh": "“今天得早睡”是？",
                "en": "How to say: I have to sleep early today?"
              },
              "options": [
                {
                  "text": {
                    "jp": "今日は早く寝ないといけません。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "今日は早く寝てはいけません。"
                  }
                },
                {
                  "text": {
                    "jp": "今日は早く寝なくてもいいです。"
                  }
                },
                {
                  "text": {
                    "jp": "今日は早く寝ないでください。"
                  }
                }
              ],
              "explanation": {
                "zh": "与「なければなりません」意义相近，更口语。",
                "en": "Casual spoken equivalent of obligation."
              }
            }
          ]
        }
      ]

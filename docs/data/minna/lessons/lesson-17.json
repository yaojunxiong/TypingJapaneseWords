      },
      "items": [
        {
          "id": "l17_q01",
          "question": {
            "zh": "「ないでください」的意思是？",
            "en": "What does ないでください mean?"
          },
          "options": [
            {
              "text": {
                "zh": "请不要〜",
                "en": "please don't~"
              },
              "correct": true
            },
            {
              "text": {
                "zh": "必须〜",
                "en": "must~"
              }
            },
            {
              "text": {
                "zh": "不做也可以",
                "en": "do not have to~"
              }
            },
            {
              "text": {
                "zh": "支付",
                "en": "pay"
              }
            }
          ],
          "explanation": {
            "zh": "「ないでください」表示「请不要〜」。",
            "en": "ないでください means please don't~."
          }
        },
        {
          "id": "l17_q02",
          "question": {
            "zh": "哪一句最符合语法「Vないで ください」？",
            "en": "Which sentence best matches pattern \"Vないで ください\"?"
          },
          "options": [
            {
              "text": {
                "jp": "ここにごみを捨てないでください。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "明日早く起きなければなりません。"
              }
            },
            {
              "text": {
                "jp": "明日は来なくてもいいです。"
              }
            },
            {
              "text": {
                "jp": "もう帰らないといけません。"
              }
            }
          ],
          "explanation": {
            "zh": "正确句型是「Vないで ください」。",
            "en": "The correct pattern is \"Vないで ください\"."
          }
        },
        {
          "id": "l17_q03",
          "question": {
            "zh": "关于「Vなければ なりません」最恰当的是？",
            "en": "Which usage best fits \"Vなければ なりません\"?"
          },
          "options": [
            {
              "text": {
                "jp": "今日書類を出さなければなりません。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "今日書類を出してはいけません。"
              }
            },
            {
              "text": {
                "jp": "今日書類を出さないでください。"
              }
            },
            {
              "text": {
                "jp": "今日書類を出さなくてもいいです。"
              }
            }
          ],
          "explanation": {
            "zh": "表示必须做某事。",
            "en": "Indicates necessity/obligation."
          }
        },
        {
          "id": "l17_q04",
          "question": {
            "zh": "与「图书馆请不要大声说话。」对应的日语句子是？",
            "en": "Which Japanese sentence matches \"Please do not speak loudly in the library.\"?"
          },
          "options": [
            {
              "text": {
                "jp": "図書館では大きい声で話さないでください。"
              },
              "correct": true
            },
            {
              "text": {

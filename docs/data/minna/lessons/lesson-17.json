      "items": [
        {
          "id": "l17_e01",
          "jp": "図書館では大きい声で話さないでください。",
          "zh": "图书馆请不要大声说话。",
          "en": "Please do not speak loudly in the library."
        },
        {
          "id": "l17_e02",
          "jp": "この書類は今日中に出さなければなりません。",
          "zh": "这份文件今天之内必须提交。",
          "en": "This document must be submitted today."
        },
        {
          "id": "l17_e03",
          "jp": "明日の会議は出なくてもいいです。",
          "zh": "明天的会议不参加也可以。",
          "en": "You do not have to attend tomorrow's meeting."
        },
        {
          "id": "l17_e04",
          "jp": "薬を飲まないといけません。",
          "zh": "我得吃药。",
          "en": "I have to take medicine."
        },
        {
          "id": "l17_e05",
          "jp": "約束を忘れないでください。",
          "zh": "请不要忘记约定。",
          "en": "Please do not forget the promise."
        }
      ]
    },
    {
      "type": "quiz",
      "id": "l17_quiz",

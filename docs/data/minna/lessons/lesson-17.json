              }
            },
            {
              "text": {
                "jp": "明日の会議は出なくてもいいです。"
              }
            },
            {
              "text": {
                "jp": "薬を飲まないといけません。"
              }
            }
          ],
          "explanation": {
            "zh": "对应句子是「図書館では大きい声で話さないでください。」。",
            "en": "The matching sentence is \"図書館では大きい声で話さないでください。\"."
          }
        }
      ]
    }
  ]

  {
    "lineId": "l30-conv-002",
    "order": 2,
    "speaker": "鈴木",
    "ja": "いらっしゃい。さあ、どうぞ。",
    "kana": "いらっしゃい。さあ、どうぞ。",
    "ttsText": "いらっしゃい。さあ、どうぞ。",
    "zh": "欢迎，请进。",

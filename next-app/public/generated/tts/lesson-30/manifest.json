    "voice": "鈴木_male / ja-JP-KeitaNeural / rate -15%",
    "duration": 0.9,
    "audioType": "tts-practice"
  },
  {
    "lineId": "l30-conv-011",
    "order": 11,
    "speaker": "ミラー",
    "ja": "そうですか。じゃ、買っておきます。",

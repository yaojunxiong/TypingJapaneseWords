    "voice": "ミラー_male / ja-JP-KeitaNeural / rate -15%",
    "duration": 1.179,
    "audioType": "tts-practice"
  },
  {
    "lineId": "l27-conv-004",
    "order": 4,
    "speaker": "鈴木",
    "ja": "これはわたしが作ったんですよ。",
    "kana": "これはわたしがつくったんですよ。",
    "ttsText": "これはわたしがつくったんですよ。",
    "zh": "这是我做的。",

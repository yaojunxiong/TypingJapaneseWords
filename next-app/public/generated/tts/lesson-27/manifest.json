    "duration": 0.675,
    "audioType": "tts-practice"
  },
  {
    "lineId": "l27-conv-007",
    "order": 7,
    "speaker": "ミラー",
    "ja": "へえ。じゃ、あの本棚も作ったんですか。",
    "kana": "へえ。じゃ、あのほんだなもつくったんですか。",
    "ttsText": "へえ。じゃ、あのほんだなもつくったんですか。",
    "zh": "哦，那么那个书架也是你做的吗？",

    "duration": 0.792,
    "audioType": "tts-practice"
  },
  {
    "lineId": "l27-conv-005",
    "order": 5,
    "speaker": "ミラー",
    "ja": "えっ、ほんとうですか。",
    "kana": "えっ、ほんとうですか。",
    "ttsText": "えっ、ほんとうですか。",
    "zh": "咦，真的吗？",

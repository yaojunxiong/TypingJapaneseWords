    "audioType": "tts-practice"
  },
  {
    "lineId": "l17-conv-010",
    "order": 10,
    "speaker": "医者",
    "ja": "じゃ、お大事に。",
    "kana": "じゃ、おだいじに。",
    "ttsText": "じゃ、おだいじに。",

[
  {
    "lineId": "l17-conv-001",
    "order": 1,
    "speaker": "医者",
    "ja": "どうしましたか。",
    "kana": "どうしましたか。",
    "ttsText": "どうしましたか。",
    "zh": "怎么了？",
    "file": "l17-01.mp3",

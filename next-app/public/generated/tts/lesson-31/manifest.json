    "audioType": "tts-practice"
  },
  {
    "lineId": "l31-conv-006",
    "order": 6,
    "speaker": "小川",
    "ja": "妻と子どもは東京に残るんです。",
    "kana": "つまとこどもはとうきょうにのこるんです。",
    "ttsText": "つまとこどもはとうきょうにのこるんです。",

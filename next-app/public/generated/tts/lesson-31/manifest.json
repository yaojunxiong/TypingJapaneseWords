    "audioType": "tts-practice"
  },
  {
    "lineId": "l31-conv-007",
    "order": 7,
    "speaker": "ミラー",
    "ja": "えっ、いっしょに行かないんですか。",
    "kana": "えっ、いっしょにいかないんですか。",
    "ttsText": "えっ、いっしょにいかないんですか。",

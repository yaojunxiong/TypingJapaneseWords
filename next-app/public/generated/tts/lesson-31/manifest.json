    "audioType": "tts-practice"
  },
  {
    "lineId": "l31-conv-005",
    "order": 5,
    "speaker": "ミラー",
    "ja": "でも、どうして独身になるんですか。",
    "kana": "でも、どうしてどくしんになるんですか。",
    "ttsText": "でも、どうしてどくしんになるんですか。",

    {
      "id": "l46-mistakes",
      "type": "mistakes",
      "title": {
        "zh": "常见错误 Common Mistakes",
        "en": "Common Mistakes"
      },
      "items": [
        {
          "id": "l46-mistake-01",
          "wrong": "今出かけているところです。",
          "correct": "今出かけるところです。",
          "reason": {
            "zh": "正要出门用辞书形 + ところです；ているところです 表示正在进行。",
            "en": "Use dictionary form + ところです for 'about to'; ているところです means in progress."
          }
        },
        {
          "id": "l46-mistake-02",
          "wrong": "先月日本へ来たところです。",
          "correct": "先月日本へ来たばかりです。",
          "reason": {
            "zh": "先月不再是刚刚那一刻，更自然用 ばかりです。",
            "en": "Last month is not the immediate moment, so ばかりです is more natural."
          }
        },
        {
          "id": "l46-mistake-03",
          "wrong": "今日は休みなはずです。",
          "correct": "今日は休みのはずです。",
          "reason": {
            "zh": "名词接 はずです 要用 の。",
            "en": "Use の before はずです after nouns."
          }
        }
      ]
    },

    {
      "id": "l46-grammar",
      "type": "grammar",
      "title": {
        "zh": "语法 Grammar",
        "en": "Grammar"
      },
      "items": [
        {
          "id": "l46-grammar-01",
          "pattern": "V辞書形 + ところです",
          "zh": "表示正要做某事，动作即将开始。",
          "en": "Shows that an action is just about to start.",
          "example": "今から昼ご飯を食べるところです。",
          "practice": [
            {
              "id": "l46-practice-01",
              "skill": "grammar",
              "question": {
                "zh": "表达：我正要出门。",
                "en": "Say: I am just about to go out."
              },
              "options": [
                {
                  "text": {
                    "jp": "今出かけるところです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "今会議の準備をしているところです。"
                  }
                },
                {
                  "text": {
                    "jp": "今家に帰って来たところです。"
                  }
                },
                {
                  "text": {
                    "jp": "入学したばかりです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示正要做某事，动作即将开始。",
                "en": "Shows that an action is just about to start."
              }
            }
          ]
        },
        {
          "id": "l46-grammar-02",
          "pattern": "Vている + ところです",
          "zh": "表示某动作正在进行中。",
          "en": "Shows that an action is currently in progress.",
          "example": "今レポートを書いているところです。",
          "practice": [
            {
              "id": "l46-practice-02",
              "skill": "grammar",
              "question": {
                "zh": "表达：我正在准备会议。",
                "en": "Say: I am preparing for the meeting right now."
              },
              "options": [
                {
                  "text": {
                    "jp": "今出かけるところです。"
                  }
                },
                {
                  "text": {
                    "jp": "今会議の準備をしているところです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "今家に帰って来たところです。"
                  }
                },
                {
                  "text": {
                    "jp": "入学したばかりです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示某动作正在进行中。",
                "en": "Shows that an action is currently in progress."
              }
            }
          ]
        },
        {
          "id": "l46-grammar-03",
          "pattern": "Vた形 + ところです",
          "zh": "表示动作刚刚完成，强调完成的瞬间。",
          "en": "Shows that an action has just been completed, emphasizing the immediate moment.",
          "example": "今宿題が終わったところです。",
          "practice": [
            {
              "id": "l46-practice-03",
              "skill": "grammar",
              "question": {
                "zh": "表达：我刚回到家。",
                "en": "Say: I just got home."
              },
              "options": [
                {
                  "text": {
                    "jp": "今会議の準備をしているところです。"
                  }
                },
                {
                  "text": {
                    "jp": "今出かけるところです。"
                  }
                },
                {
                  "text": {
                    "jp": "今家に帰って来たところです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "入学したばかりです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示动作刚刚完成，强调完成的瞬间。",
                "en": "Shows that an action has just been completed, emphasizing the immediate moment."
              }
            }
          ]
        },
        {
          "id": "l46-grammar-04",
          "pattern": "Vた形 + ばかりです",
          "zh": "表示刚做完某事，时间感觉上很近，可比 ところです 范围更宽。",
          "en": "Shows that something was done recently; the sense of recentness can be broader than ところです.",
          "example": "先月日本へ来たばかりです。",
          "practice": [
            {
              "id": "l46-practice-04",
              "skill": "grammar",
              "question": {
                "zh": "表达：我刚入学不久。",
                "en": "Say: I just entered school recently."
              },
              "options": [
                {
                  "text": {
                    "jp": "今家に帰って来たところです。"
                  }
                },
                {
                  "text": {
                    "jp": "入学したばかりです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "今出かけるところです。"
                  }
                },
                {
                  "text": {
                    "jp": "今会議の準備をしているところです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示刚做完某事，时间感觉上很近，可比 ところです 范围更宽。",
                "en": "Shows that something was done recently; the sense of recentness can be broader than ところです."
              }
            }
          ]
        },
        {
          "id": "l46-grammar-05",
          "pattern": "ところです vs ばかりです",
          "zh": "ところです更强调刚刚那一刻；ばかりです强调说话人觉得时间不久。",
          "en": "ところです emphasizes the immediate moment; ばかりです emphasizes the speaker's feeling that it was recent.",
          "example": "今着いたところです。先週引っ越したばかりです。",
          "practice": [
            {
              "id": "l46-practice-05",
              "skill": "grammar",
              "question": {
                "zh": "选择自然表达：上个月刚搬家。",
                "en": "Choose a natural expression: I moved just last month."
              },
              "options": [
                {
                  "text": {
                    "jp": "今会議の準備をしているところです。"
                  }
                },
                {
                  "text": {
                    "jp": "今家に帰って来たところです。"
                  }
                },
                {
                  "text": {
                    "jp": "今出かけるところです。"
                  }
                },
                {
                  "text": {
                    "jp": "先月引っ越したばかりです。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "ところです更强调刚刚那一刻；ばかりです强调说话人觉得时间不久。",
                "en": "ところです emphasizes the immediate moment; ばかりです emphasizes the speaker's feeling that it was recent."
              }
            }
          ]
        },
        {
          "id": "l46-grammar-06",
          "pattern": "普通形 + はずです",
          "zh": "根据事实或推断，表示理应如此。",
          "en": "Shows expectation based on facts or reasoning.",
          "example": "田中さんはもう駅に着いたはずです。",
          "practice": [
            {
              "id": "l46-practice-06",
              "skill": "grammar",
              "question": {
                "zh": "表达：包裹应该已经到了。",
                "en": "Say: The package should have arrived already."
              },
              "options": [
                {
                  "text": {
                    "jp": "今会議の準備をしているところです。"
                  }
                },
                {
                  "text": {
                    "jp": "荷物はもう届いたはずです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "今出かけるところです。"
                  }
                },
                {
                  "text": {
                    "jp": "今家に帰って来たところです。"
                  }
                }
              ],
              "explanation": {
                "zh": "根据事实或推断，表示理应如此。",
                "en": "Shows expectation based on facts or reasoning."
              }
            }
          ]
        },
        {
          "id": "l46-grammar-07",
          "pattern": "い形容詞 / な形容詞な / 名詞の + はずです",
          "zh": "形容词和名词也可接 はずです，な形容词用 な，名词用 の。",
          "en": "Adjectives and nouns can attach to はずです; use な for na-adjectives and の for nouns.",
          "example": "この店は安いはずです。今日は休みのはずです。",
          "practice": [
            {
              "id": "l46-practice-07",
              "skill": "grammar",
              "question": {
                "zh": "表达：今天应该是休息日。",
                "en": "Say: Today should be a day off."
              },
              "options": [
                {
                  "text": {
                    "jp": "今会議の準備をしているところです。"
                  }
                },
                {
                  "text": {
                    "jp": "今出かけるところです。"
                  }
                },
                {
                  "text": {
                    "jp": "今日は休みのはずです。"
                  },

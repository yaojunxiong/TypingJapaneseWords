    {
      "type": "grammar",
      "id": "l22_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l22_g01",
          "pattern": "普通形 + 名词",
          "title": {
            "zh": "名词前修饰",
            "en": "Plain-form noun modifier"
          },
          "explanation": {
            "zh": "把句子放到名词前面作修饰。",
            "en": "Place a plain-form clause before a noun."
          },
          "examples": [
            {
              "jp": "私は昨日買った本を読みます。",
              "zh": "我读昨天买的书。",
              "en": "I read the book I bought yesterday."
            }
          ],
          "practice": [
            {
              "id": "l22_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我想找便宜的房间”是？",
                "en": "How to say: I am looking for a cheap room?"
              },
              "options": [
                {
                  "text": {
                    "jp": "安い部屋を探しています。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "安いの部屋を探しています。"
                  }
                },
                {
                  "text": {
                    "jp": "部屋が安いを探しています。"
                  }
                },
                {
                  "text": {
                    "jp": "安い部屋が探しています。"
                  }
                }
              ],
              "explanation": {
                "zh": "把句子放到名词前面作修饰。",
                "en": "Place a plain-form clause before a noun."
              }
            },
            {
              "id": "l22_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“昨天见到的人”是？",
                "en": "How to say: the person I met yesterday?"
              },
              "options": [
                {
                  "text": {
                    "jp": "昨日会った人"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "昨日会います人"
                  }
                },
                {
                  "text": {
                    "jp": "昨日会って人"
                  }
                },
                {
                  "text": {
                    "jp": "昨日に会ったの人"
                  }
                }
              ],
              "explanation": {
                "zh": "把句子放到名词前面作修饰。",
                "en": "Place a plain-form clause before a noun."
              }
            }
          ]
        },
        {
          "id": "l22_g02",
          "pattern": "Vた + 名词",
          "title": {
            "zh": "过去动作修饰名词",
            "en": "Past action modifier"
          },
          "explanation": {
            "zh": "强调已经发生过的动作。",
            "en": "Use ta-form to modify nouns with completed actions."
          },
          "examples": [
            {

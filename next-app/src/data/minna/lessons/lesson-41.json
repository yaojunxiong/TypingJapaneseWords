    {
      "id": "l41-grammar",
      "type": "grammar",
      "title": {
        "zh": "语法 Grammar",
        "en": "Grammar"
      },
      "items": [
        {
          "id": "l41-grammar-01",
          "pattern": "Nをいただきます",
          "zh": "从上级或需要尊敬的人那里领受物品。",
          "en": "Humbly receive an item from a superior or respected person.",
          "example": "社長にお土産をいただきました。",
          "practice": [
            {
              "id": "l41-practice-01",
              "skill": "grammar",
              "question": {
                "zh": "表达：我从老师那里得到了书。",
                "en": "Say: I received a book from my teacher."
              },
              "options": [
                {
                  "text": {
                    "jp": "先生に本をいただきました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "部長が切符をくださいました。"
                  }
                },
                {
                  "text": {
                    "jp": "花に水をやります。"
                  }
                },
                {
                  "text": {
                    "jp": "先生にレポートを見ていただきました。"
                  }
                }
              ],
              "explanation": {
                "zh": "从上级或需要尊敬的人那里领受物品。",
                "en": "Humbly receive an item from a superior or respected person."
              }
            }
          ]
        },
        {
          "id": "l41-grammar-02",
          "pattern": "Nをくださいます",
          "zh": "上级或尊敬的人给我方某物。",
          "en": "A superior or respected person gives something to me/us.",
          "example": "先生が資料をくださいました。",
          "practice": [
            {
              "id": "l41-practice-02",
              "skill": "grammar",
              "question": {
                "zh": "表达：部长给了我票。",
                "en": "Say: The department manager gave me a ticket."
              },
              "options": [
                {
                  "text": {
                    "jp": "部長が切符をくださいました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生に本をいただきました。"
                  }
                },
                {
                  "text": {
                    "jp": "花に水をやります。"
                  }
                },
                {
                  "text": {
                    "jp": "先生にレポートを見ていただきました。"
                  }
                }
              ],
              "explanation": {
                "zh": "上级或尊敬的人给我方某物。",
                "en": "A superior or respected person gives something to me/us."
              }
            }
          ]
        },
        {
          "id": "l41-grammar-03",
          "pattern": "Nをやります",
          "zh": "给植物、动物、小孩等下位对象某物。",
          "en": "Give something to plants, animals, children, or lower-status recipients.",
          "example": "犬にえさをやります。",
          "practice": [
            {
              "id": "l41-practice-03",
              "skill": "grammar",
              "question": {
                "zh": "表达：给花浇水。",
                "en": "Say: I give water to the flowers."
              },
              "options": [
                {
                  "text": {
                    "jp": "花に水をやります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生にレポートを見ていただきました。"
                  }
                },
                {
                  "text": {
                    "jp": "部長が切符をくださいました。"
                  }
                },
                {
                  "text": {
                    "jp": "先生に本をいただきました。"
                  }
                }
              ],
              "explanation": {
                "zh": "给植物、动物、小孩等下位对象某物。",
                "en": "Give something to plants, animals, children, or lower-status recipients."
              }
            }
          ]
        },
        {
          "id": "l41-grammar-04",
          "pattern": "Vていただきます",
          "zh": "请上级或他人为我方做某事，表达领受帮助。",
          "en": "Receive the favor of someone, often a superior, doing something for me/us.",
          "example": "先生に作文を直していただきました。",
          "practice": [
            {
              "id": "l41-practice-04",
              "skill": "grammar",
              "question": {
                "zh": "表达：请老师检查了我的报告。",

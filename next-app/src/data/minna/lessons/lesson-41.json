              }
            }
          ]
        },
        {
          "id": "l41-grammar-07",
          "pattern": "Vてくださいませんか",
          "zh": "礼貌地请求上级或不熟的人帮忙。",
          "en": "Politely ask a respected or less familiar person to do something.",
          "example": "この漢字を読んでくださいませんか。",

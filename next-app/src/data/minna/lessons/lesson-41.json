          "kana": "いただきます",
          "zh": "领受、得到",
          "en": "humbly receive",
          "example": "先生に本をいただきました。",
          "practice": [
            {
              "id": "l41-vocab-01_p01",
              "skill": "vocab",
              "question": {
                "zh": "「いただきます」的词汇意思是？",
                "en": "What does いただきます mean?"
              },
              "options": [
                {
                  "text": {
                    "zh": "领受、得到",
                    "en": "humbly receive"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "zh": "给我、给我们",
                    "en": "give to me/us honorifically"
                  }
                },
                {
                  "text": {
                    "zh": "给、做给下位对象",
                    "en": "give to younger/lower beings"
                  }
                },
                {
                  "text": {
                    "zh": "表扬",
                    "en": "praise"
                  }
                }
              ],
              "explanation": {
                "zh": "「いただきます」= 领受、得到。",
                "en": "いただきます means humbly receive."
              }

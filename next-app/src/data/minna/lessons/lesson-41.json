      "items": [
        {
          "id": "l41-quiz-01",
          "question": {
            "zh": "「我从老师那里得到了书。」正确的是？",
            "en": "Which means: I received a book from my teacher?"
          },
          "options": [
            {
              "text": "先生に本をいただきました。",
              "correct": true
            },
            {
              "text": "先生に本をくださいました。",
              "correct": false
            },
            {
              "text": "先生を本にいただきました。",
              "correct": false
            },
            {
              "text": "部長が駅まで送っていただきました。"
            }
          ],
          "explanation": {
            "zh": "以我为主语，从老师那里领受，用 先生に...いただきました。",
            "en": "When I receive from the teacher, use 先生に...いただきました."
          }
        },
        {
          "id": "l41-quiz-02",
          "question": {
            "zh": "「老师给了我资料。」正确的是？",
            "en": "Which means: The teacher gave me materials?"
          },
          "options": [
            {
              "text": "先生が資料をくださいました。",
              "correct": true
            },
            {
              "text": "先生に資料をくださいました。",
              "correct": false
            },
            {
              "text": "先生が資料をいただきました。",
              "correct": false
            },
            {
              "text": "先生がレポートを見ていただきました。"
            }
          ],
          "explanation": {
            "zh": "给我方的人作主语时用 が + くださいます。",
            "en": "The giver is marked with が when using くださいます."
          }
        },

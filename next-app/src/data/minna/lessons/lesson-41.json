              "explanation": {
                "zh": "请上级或他人为我方做某事，表达领受帮助。",
                "en": "Receive the favor of someone, often a superior, doing something for me/us."
              }
            }
          ]
        },
        {
          "id": "l41-grammar-05",
          "pattern": "Vてくださいます",
          "zh": "上级或尊敬的人为我方做某事。",
          "en": "A superior or respected person does something for me/us.",
          "example": "部長が駅まで送ってくださいました。",
          "practice": [
            {
              "id": "l41-practice-05",
              "skill": "grammar",
              "question": {

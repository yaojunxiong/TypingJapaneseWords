                    "jp": "先生にレポートを見ていただきました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生に本をいただきました。"
                  }
                },
                {
                  "text": {
                    "jp": "部長が切符をくださいました。"
                  }
                },
                {
                  "text": {
                    "jp": "花に水をやります。"
                  }
                }

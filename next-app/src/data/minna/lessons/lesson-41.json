    {
      "id": "l41-mistakes",
      "type": "mistakes",
      "title": {
        "zh": "常见错误 Common Mistakes",
        "en": "Common Mistakes"
      },
      "items": [
        {
          "id": "l41-mistake-01",
          "wrong": "先生に本をくださいました。",
          "correct": "先生が本をくださいました。 / 私は先生に本をいただきました。",
          "reason": {
            "zh": "くださいます 的主语是给我方的人；以我为主语时用 いただきます。",
            "en": "With くださいます, the giver is the subject. Use いただきます when I am the subject."
          }
        },
        {
          "id": "l41-mistake-02",
          "wrong": "社長にお土産をやりました。",
          "correct": "社長にお土産を差し上げました。",
          "reason": {
            "zh": "やります 不能用于尊敬对象。这里应使用更礼貌的给与表达。",
            "en": "Do not use やります for respected people. Use a polite giving expression."
          }
        },
        {
          "id": "l41-mistake-03",
          "wrong": "先生が作文を直していただきました。",
          "correct": "先生が作文を直してくださいました。",
          "reason": {
            "zh": "主语是老师时，用 てくださいます；以我为主语领受帮助时用 ていただきます。",
            "en": "Use てくださいます when the teacher is the subject; use ていただきます when I receive the favor."
          }
        }
      ]
    },
    {
      "id": "l41-quiz",

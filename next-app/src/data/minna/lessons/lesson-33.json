    {
      "type": "grammar",
      "id": "l33_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l33_g01",
          "pattern": "一类动词命令形：う段 → え段",
          "explanation": {
            "zh": "行きます→行け、話します→話せ、飲みます→飲め。",
            "en": "Group 1 command form changes the final u-sound to e-sound: ike, hanase, nome."
          },
          "examples": [
            {
              "jp": "急げ。",
              "zh": "快点！",
              "en": "Hurry up!"
            }
          ],
          "practice": [
            {
              "id": "l33_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "「行きます」的命令形是？",
                "en": "Command form of ikimasu?"
              },
              "options": [
                {
                  "text": {
                    "jp": "行け"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "行ろ"
                  }
                },
                {
                  "text": {
                    "jp": "行きろ"
                  }
                },
                {
                  "text": {
                    "jp": "行こう"
                  }
                }
              ],
              "explanation": {
                "zh": "一类动词变え段。",
                "en": "Group 1 changes to e-sound."
              }
            }
          ]
        },
        {
          "id": "l33_g02",
          "pattern": "二类动词命令形：ます形去ます + ろ",
          "explanation": {
            "zh": "食べます→食べろ、見ます→見ろ。",
            "en": "Group 2 command form uses the masu-stem plus ro."
          },
          "examples": [
            {
              "jp": "早く寝ろ。",
              "zh": "快睡！",
              "en": "Go to bed!"
            }
          ],
          "practice": [
            {
              "id": "l33_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "「食べます」的命令形是？",
                "en": "Command form of tabemasu?"
              },
              "options": [
                {
                  "text": {
                    "jp": "食べろ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "食べれ"
                  }
                },
                {
                  "text": {
                    "jp": "食べよう"
                  }
                },
                {
                  "text": {
                    "jp": "食べるな"
                  }
                }
              ],
              "explanation": {
                "zh": "二类动词去ます加ろ。",
                "en": "Group 2 uses masu-stem + ro."
              }
            }
          ]
        },
        {
          "id": "l33_g03",
          "pattern": "三类命令形：しろ / 来い",
          "explanation": {
            "zh": "します→しろ、来ます→来い（こい）。",
            "en": "Irregular commands: shiro and koi."
          },
          "examples": [
            {
              "jp": "勉強しろ。",
              "zh": "学习！",
              "en": "Study!"
            }
          ],
          "practice": [
            {
              "id": "l33_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "「します」的命令形是？",
                "en": "Command form of shimasu?"
              },
              "options": [
                {
                  "text": {
                    "jp": "しろ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "せよます"
                  }
                },
                {
                  "text": {
                    "jp": "するな"
                  }
                },
                {
                  "text": {
                    "jp": "しよう"
                  }
                }
              ],
              "explanation": {
                "zh": "常用命令形是「しろ」。",
                "en": "The common command form is shiro."
              }
            }
          ]
        },
        {
          "id": "l33_g04",
          "pattern": "辞书形 + な",
          "explanation": {
            "zh": "表示禁止：“不要……”。语气强，多用于标识、口号、紧急场景。",
            "en": "Prohibition: do not... It is strong and often used on signs or in urgent situations."
          },
          "examples": [
            {
              "jp": "ここに入るな。",
              "zh": "不要进这里。",
              "en": "Do not enter here."
            }
          ],
          "practice": [
            {
              "id": "l33_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“不要跑”是？",
                "en": "How do you say 'Do not run'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "走るな"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "走りな"
                  }
                },
                {
                  "text": {
                    "jp": "走らないな"
                  }
                },
                {
                  "text": {
                    "jp": "走ってな"
                  }
                }
              ],
              "explanation": {
                "zh": "禁止形是辞书形+な。",
                "en": "Prohibition is dictionary form + na."
              }
            }
          ]
        },
        {
          "id": "l33_g05",
          "pattern": "命令形 / 禁止形は強い",
          "explanation": {
            "zh": "命令形和禁止形语气强，日常礼貌请求通常不用。",
            "en": "Command and prohibition forms are strong; they are not polite everyday requests."
          },
          "examples": [
            {
              "jp": "危ない！逃げろ。",
              "zh": "危险！快逃！",
              "en": "Danger! Run!"
            }
          ],
          "practice": [
            {
              "id": "l33_g05_p01",
              "skill": "grammar",
              "question": {
                "zh": "哪个场景更适合用命令形？",
                "en": "Which situation fits command form better?"
              },
              "options": [
                {
                  "text": {
                    "zh": "紧急危险时",
                    "en": "In urgent danger"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "zh": "给老师发邮件"
                  }
                },
                {
                  "text": {
                    "zh": "餐厅点餐"
                  }
                },
                {
                  "text": {
                    "zh": "初次见面寒暄"
                  }
                }
              ],
              "explanation": {
                "zh": "命令形语气强。",
                "en": "Command form is strong."
              }
            }
          ]
        },
        {
          "id": "l33_g06",
          "pattern": "普通形 + と言っていました",
          "explanation": {
            "zh": "转述别人说过的话：“他说……”。",
            "en": "Reports what someone said: said that..."
          },
          "examples": [
            {
              "jp": "先生は明日テストがあると言っていました。",
              "zh": "老师说过明天有考试。",
              "en": "The teacher said there is a test tomorrow."
            }
          ],
          "practice": [
            {
              "id": "l33_g06_p01",
              "skill": "grammar",
              "question": {
                "zh": "“老师说要读书”正确的是？",
                "en": "How do you say 'The teacher said to read the book'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生は本を読めと言っていました"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生は本を読みろと言っていました"
                  }
                },
                {
                  "text": {
                    "jp": "先生は本を読むなと言っていました"
                  }
                },
                {
                  "text": {
                    "jp": "先生は本を読んでと言っていましたです"
                  }
                }
              ],
              "explanation": {
                "zh": "转述命令可用命令形+と言っていました。",
                "en": "A command can be quoted before to itte imashita."
              }
            }
          ]
        },
        {
          "id": "l33_g07",
          "pattern": "〜という意味です",
          "explanation": {
            "zh": "说明标识或词语的意思：“是……的意思”。",
            "en": "Explains the meaning of a sign or word: means..."
          },
          "examples": [
            {
              "jp": "これは使用禁止という意味です。",
              "zh": "这是禁止使用的意思。",
              "en": "This means use is prohibited."
            }
          ],
          "practice": [
            {
              "id": "l33_g07_p01",
              "skill": "grammar",
              "question": {
                "zh": "“禁止进入的意思”是？",
                "en": "How do you say 'It means no entry'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "立入禁止という意味です"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "立入禁止と読みます意味です"
                  }
                },
                {
                  "text": {
                    "jp": "立入禁止だと言って意味です"
                  }
                },
                {
                  "text": {
                    "jp": "立入禁止になります意味です"
                  }
                }
              ],
              "explanation": {
                "zh": "说明意思用「という意味です」。",
                "en": "Use to iu imi desu to explain meaning."
              }
            }
          ]
        },
        {
          "id": "l33_g08",
          "pattern": "〜と読みます",
          "explanation": {
            "zh": "说明读法：“读作……”。",
            "en": "Explains how something is read: is read as..."
          },
          "examples": [
            {
              "jp": "この漢字は『止まれ』と読みます。",
              "zh": "这个汉字读作“止まれ”。",
              "en": "This kanji is read as 'tomare'."
            }
          ],
          "practice": [
            {
              "id": "l33_g08_p01",
              "skill": "grammar",
              "question": {
                "zh": "说明读法时用？",
                "en": "Which phrase explains how to read something?"
              },
              "options": [
                {
                  "text": {
                    "jp": "〜と読みます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "〜という意味です"
                  }
                },
                {
                  "text": {
                    "jp": "〜と言っていました"
                  }
                },
                {
                  "text": {
                    "jp": "〜な"
                  }
                }
              ],
              "explanation": {
                "zh": "读法用「と読みます」。",
                "en": "Use to yomimasu for reading."
              }
            }
          ]
        }
      ]
    },

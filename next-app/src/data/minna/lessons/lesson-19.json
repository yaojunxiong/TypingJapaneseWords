      "type": "grammar",
      "id": "l19_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l19_g01",
          "pattern": "Vた ことが あります",
          "title": {
            "zh": "经验表达",
            "en": "Experience expression"
          },
          "explanation": {
            "zh": "表示曾经有过某种经历。",
            "en": "Expresses past experience."
          },
          "examples": [
            {
              "jp": "私は京都へ行ったことがあります。",
              "zh": "我去过京都。",
              "en": "I have been to Kyoto."
            }
          ],
          "practice": [
            {
              "id": "l19_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“你爬过富士山吗？”是？",
                "en": "How to ask: Have you climbed Mt. Fuji?"
              },
              "options": [
                {
                  "text": {
                    "jp": "富士山に登ったことがありますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "富士山に登ることがありますか。"
                  }
                },
                {
                  "text": {
                    "jp": "富士山に登りましたことがありますか。"
                  }
                },
                {
                  "text": {
                    "jp": "富士山を登ったことがありますか。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示曾经有过某种经历。",
                "en": "Expresses past experience."
              }
            },
            {
              "id": "l19_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“我没去过北海道”是？",
                "en": "How to say: I have not been to Hokkaido?"
              },
              "options": [
                {
                  "text": {
                    "jp": "北海道へ行ったことがありません。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "北海道へ行きませんでした。"
                  }
                },
                {
                  "text": {
                    "jp": "北海道へ行くことがありません。"
                  }
                },
                {
                  "text": {
                    "jp": "北海道へ行ったことはないです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示曾经有过某种经历。",
                "en": "Expresses past experience."
              }
            }
          ]
        },
        {
          "id": "l19_g02",
          "pattern": "N に なります",
          "title": {
            "zh": "变化为…",
            "en": "Become~"
          },
          "explanation": {
            "zh": "表示状态变化结果。",
            "en": "Indicates change into a new state."
          },
          "examples": [
            {
              "jp": "将来、医者になりたいです。",
              "zh": "将来想当医生。",
              "en": "I want to become a doctor in the future."
            }
          ],
          "practice": [
            {

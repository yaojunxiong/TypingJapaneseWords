      "items": [
        {
          "id": "l19_q01",
          "question": {
            "zh": "「たことがあります」的意思是？",
            "en": "What does たことがあります mean?"
          },
          "options": [
            {
              "text": {
                "zh": "有过……经验",
                "en": "have experienced~"
              },
              "correct": true
            },
            {
              "text": {
                "zh": "攀登",
                "en": "climb"
              }
            },
            {
              "text": {
                "zh": "住宿",
                "en": "stay overnight"
              }
            },
            {
              "text": {
                "zh": "打扫",
                "en": "clean"
              }
            }
          ],
          "explanation": {
            "zh": "「たことがあります」表示「有过……经验」。",
            "en": "たことがあります means have experienced~."
          }
        },
        {
          "id": "l19_q02",
          "question": {
            "zh": "哪一句最符合语法「Vた ことが あります」？",
            "en": "Which sentence best matches pattern \"Vた ことが あります\"?"
          },
          "options": [
            {
              "text": {
                "jp": "私は京都へ行ったことがあります。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "将来、医者になりたいです。"
              }
            },
            {
              "text": {
                "jp": "飲み物はお茶にします。"
              }
            },
            {
              "text": {
                "jp": "もう宿題をしました。"
              }
            }
          ],
          "explanation": {
            "zh": "正确句型是「Vた ことが あります」。",
            "en": "The correct pattern is \"Vた ことが あります\"."
          }
        },
        {
          "id": "l19_q03",
          "question": {
            "zh": "关于「N に なります」最恰当的是？",
            "en": "Which usage best fits \"N に なります\"?"
          },
          "options": [
            {
              "text": {
                "jp": "暖かくなりました。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "暖かいになりました。"
              }
            },
            {
              "text": {
                "jp": "暖かくしました。"
              }
            },
            {
              "text": {
                "jp": "暖かくあります。"
              }
            }
          ],
          "explanation": {
            "zh": "表示状态变化结果。",
            "en": "Indicates change into a new state."
          }
        },
        {
          "id": "l19_q04",
          "question": {
            "zh": "与「我爬过富士山。」对应的日语句子是？",
            "en": "Which Japanese sentence matches \"I have climbed Mt. Fuji.\"?"
          },
          "options": [
            {
              "text": {
                "jp": "私は富士山に登ったことがあります。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "会議はもう始まりました。"
              }
            },
            {
              "text": {
                "jp": "飲み物はコーヒーにします。"
              }
            },
            {
              "text": {
                "jp": "春になって、暖かくなりました。"
              }
            }
          ],
          "explanation": {
            "zh": "对应句子是「私は富士山に登ったことがあります。」。",
            "en": "The matching sentence is \"私は富士山に登ったことがあります。\"."
          }
        }
      ]
    }

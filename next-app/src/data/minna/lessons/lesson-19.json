    {
      "type": "grammar",
      "id": "l19_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l19_g01",
          "pattern": "Vた ことが あります",
          "title": {
            "zh": "经验表达",
            "en": "Experience expression"
          },
          "explanation": {
            "zh": "表示曾经有过某种经历。",
            "en": "Expresses past experience."
          },
          "examples": [
            {
              "jp": "私は京都へ行ったことがあります。",
              "zh": "我去过京都。",
              "en": "I have been to Kyoto."
            }
          ],
          "practice": [
            {
              "id": "l19_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“你爬过富士山吗？”是？",
                "en": "How to ask: Have you climbed Mt. Fuji?"
              },
              "options": [
                {
                  "text": {
                    "jp": "富士山に登ったことがありますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "富士山に登ることがありますか。"
                  }
                },
                {
                  "text": {
                    "jp": "富士山に登りましたことがありますか。"
                  }
                },
                {
                  "text": {
                    "jp": "富士山を登ったことがありますか。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示曾经有过某种经历。",
                "en": "Expresses past experience."
              }
            },
            {
              "id": "l19_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“我没去过北海道”是？",

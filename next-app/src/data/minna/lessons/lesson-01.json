    {
      "type": "grammar",
      "id": "l01_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l01_g01",
          "pattern": "A は B です",
          "title": {
            "zh": "A 是 B",
            "en": "A is B"
          },
          "explanation": {
            "zh": "「は」提示主题，「です」表示礼貌判断：A 是 B。",
            "en": "は marks the topic, and です makes a polite statement: A is B."
          },
          "examples": [
            {
              "jp": "わたしは 学生です。",
              "zh": "我是学生。",
              "en": "I am a student."
            }
          ],
          "practice": [
            {
              "id": "l01_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "「N1 は N2 です」表示什么？",
                "en": "What does N1 は N2 です express?"
              },
              "options": [
                {
                  "text": {
                    "zh": "N1 是 N2",
                    "en": "N1 is N2"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "zh": "N1 不是 N2",
                    "en": "N1 is not N2"
                  }
                },
                {
                  "text": {
                    "zh": "N1 去 N2",
                    "en": "N1 goes to N2"
                  }
                },
                {
                  "text": {
                    "zh": "A 是 B",
                    "en": "A is B"
                  }
                }
              ],
              "explanation": {
                "zh": "AはBです = A 是 B。",
                "en": "A は B です means A is B."
              }
            },
            {
              "id": "l01_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "「は」作主题助词时读作？",
                "en": "How is topic particle は pronounced?"
              },
              "options": [
                {
                  "text": {
                    "zh": "wa",
                    "en": "wa"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "zh": "ha",
                    "en": "ha"
                  }
                },
                {
                  "text": {
                    "zh": "ga",
                    "en": "ga"
                  }
                },
                {

    {
      "id": "l44-grammar",
      "type": "grammar",
      "title": {
        "zh": "语法 Grammar",
        "en": "Grammar"
      },
      "items": [
        {
          "id": "l44-grammar-01",
          "pattern": "Vます形語幹 + すぎます",
          "zh": "表示动作做得过度。",
          "en": "Shows that an action is done too much.",
          "example": "昨日飲みすぎました。",
          "practice": [
            {
              "id": "l44-practice-01",
              "skill": "grammar",
              "question": {
                "zh": "表达：昨天吃太多了。",
                "en": "Say: I ate too much yesterday."
              },
              "options": [
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "この本は読みやすいです。"
                  }
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "表示动作做得过度。",
                "en": "Shows that an action is done too much."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-02",
          "pattern": "い形容詞語幹 + すぎます",
          "zh": "表示性质过度，去掉 い 后接 すぎます。",
          "en": "Remove い from an i-adjective and add すぎます to show excess.",
          "example": "この服は高すぎます。",
          "practice": [
            {
              "id": "l44-practice-02",
              "skill": "grammar",
              "question": {
                "zh": "表达：这个房间太冷了。",
                "en": "Say: This room is too cold."
              },
              "options": [
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "この本は読みやすいです。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示性质过度，去掉 い 后接 すぎます。",
                "en": "Remove い from an i-adjective and add すぎます to show excess."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-03",
          "pattern": "な形容詞 + すぎます",
          "zh": "な形容词直接接 すぎます。",
          "en": "Attach すぎます directly to a na-adjective.",
          "example": "この説明は複雑すぎます。",
          "practice": [
            {
              "id": "l44-practice-03",
              "skill": "grammar",
              "question": {
                "zh": "表达：这个问题太简单了。",
                "en": "Say: This question is too easy."
              },
              "options": [
                {
                  "text": {
                    "jp": "この本は読みやすいです。"
                  }
                },
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "な形容词直接接 すぎます。",
                "en": "Attach すぎます directly to a na-adjective."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-04",
          "pattern": "Vます形語幹 + やすいです",
          "zh": "表示某动作容易做或容易发生。",
          "en": "Shows that an action is easy to do or likely to happen.",
          "example": "このペンは書きやすいです。",
          "practice": [
            {
              "id": "l44-practice-04",
              "skill": "grammar",
              "question": {
                "zh": "表达：这本书容易读。",
                "en": "Say: This book is easy to read."
              },
              "options": [
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                },
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "この本は読みやすいです。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "表示某动作容易做或容易发生。",
                "en": "Shows that an action is easy to do or likely to happen."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-05",
          "pattern": "Vます形語幹 + にくいです",
          "zh": "表示某动作难做或不容易发生。",
          "en": "Shows that an action is hard to do or unlikely to happen.",
          "example": "この漢字は覚えにくいです。",
          "practice": [
            {
              "id": "l44-practice-05",
              "skill": "grammar",
              "question": {
                "zh": "表达：这个字很难写。",
                "en": "Say: This character is hard to write."
              },

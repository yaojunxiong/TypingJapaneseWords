                  }
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                },
                {
                  "text": {
                    "jp": "ルールを簡単にしてください。"
                  },
                  "correct": true

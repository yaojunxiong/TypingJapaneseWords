    {
      "id": "l44-grammar",
      "type": "grammar",
      "title": {
        "zh": "语法 Grammar",
        "en": "Grammar"
      },
      "items": [
        {
          "id": "l44-grammar-01",
          "pattern": "Vます形語幹 + すぎます",
          "zh": "表示动作做得过度。",
          "en": "Shows that an action is done too much.",
          "example": "昨日飲みすぎました。",
          "practice": [
            {
              "id": "l44-practice-01",
              "skill": "grammar",
              "question": {
                "zh": "表达：昨天吃太多了。",
                "en": "Say: I ate too much yesterday."
              },
              "options": [
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "この本は読みやすいです。"
                  }
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "表示动作做得过度。",
                "en": "Shows that an action is done too much."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-02",
          "pattern": "い形容詞語幹 + すぎます",
          "zh": "表示性质过度，去掉 い 后接 すぎます。",
          "en": "Remove い from an i-adjective and add すぎます to show excess.",
          "example": "この服は高すぎます。",
          "practice": [
            {
              "id": "l44-practice-02",
              "skill": "grammar",
              "question": {
                "zh": "表达：这个房间太冷了。",
                "en": "Say: This room is too cold."
              },
              "options": [
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "この本は読みやすいです。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示性质过度，去掉 い 后接 すぎます。",
                "en": "Remove い from an i-adjective and add すぎます to show excess."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-03",
          "pattern": "な形容詞 + すぎます",
          "zh": "な形容词直接接 すぎます。",
          "en": "Attach すぎます directly to a na-adjective.",
          "example": "この説明は複雑すぎます。",
          "practice": [
            {
              "id": "l44-practice-03",
              "skill": "grammar",
              "question": {
                "zh": "表达：这个问题太简单了。",
                "en": "Say: This question is too easy."
              },
              "options": [
                {
                  "text": {
                    "jp": "この本は読みやすいです。"
                  }
                },
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "な形容词直接接 すぎます。",
                "en": "Attach すぎます directly to a na-adjective."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-04",
          "pattern": "Vます形語幹 + やすいです",
          "zh": "表示某动作容易做或容易发生。",
          "en": "Shows that an action is easy to do or likely to happen.",
          "example": "このペンは書きやすいです。",
          "practice": [
            {
              "id": "l44-practice-04",
              "skill": "grammar",
              "question": {
                "zh": "表达：这本书容易读。",
                "en": "Say: This book is easy to read."
              },
              "options": [
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                },
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "この本は読みやすいです。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "表示某动作容易做或容易发生。",
                "en": "Shows that an action is easy to do or likely to happen."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-05",
          "pattern": "Vます形語幹 + にくいです",
          "zh": "表示某动作难做或不容易发生。",
          "en": "Shows that an action is hard to do or unlikely to happen.",
          "example": "この漢字は覚えにくいです。",
          "practice": [
            {
              "id": "l44-practice-05",
              "skill": "grammar",
              "question": {
                "zh": "表达：这个字很难写。",
                "en": "Say: This character is hard to write."
              },
              "options": [
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                },
                {
                  "text": {
                    "jp": "この字は書きにくいです。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "表示某动作难做或不容易发生。",
                "en": "Shows that an action is hard to do or unlikely to happen."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-06",
          "pattern": "い形容詞くします",
          "zh": "表示人为地把某物变成某种い形容词状态。",
          "en": "Shows making something into an i-adjective state.",
          "example": "音を小さくしてください。",
          "practice": [
            {
              "id": "l44-practice-06",
              "skill": "grammar",
              "question": {
                "zh": "表达：请把房间弄暖和。",
                "en": "Say: Please make the room warm."
              },
              "options": [
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "部屋を暖かくしてください。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "表示人为地把某物变成某种い形容词状态。",
                "en": "Shows making something into an i-adjective state."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-07",
          "pattern": "な形容詞 / 名詞 + にします",
          "zh": "表示人为地把某物变成某个状态或选定某物。",
          "en": "Shows making something into a na-adjective/noun state or choosing something.",
          "example": "説明を簡単にします。会議は月曜日にします。",
          "practice": [
            {
              "id": "l44-practice-07",
              "skill": "grammar",
              "question": {
                "zh": "表达：请把规则变简单。",
                "en": "Say: Please make the rules simple."
              },
              "options": [
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                },
                {
                  "text": {
                    "jp": "ルールを簡単にしてください。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "表示人为地把某物变成某个状态或选定某物。",
                "en": "Shows making something into a na-adjective/noun state or choosing something."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-08",
          "pattern": "Vやすく / Vにくくなります",
          "zh": "表示动作变得容易或困难。",
          "en": "Shows that an action becomes easier or harder.",
          "example": "新しい画面は使いやすくなりました。",
          "practice": [
            {
              "id": "l44-practice-08",
              "skill": "grammar",
              "question": {
                "zh": "表达：这个网站变得更容易看了。",
                "en": "Say: This website became easier to view."
              },
              "options": [
                {
                  "text": {
                    "jp": "このサイトは見やすくなりました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                },
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示动作变得容易或困难。",
                "en": "Shows that an action becomes easier or harder."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "l44-examples",
      "type": "examples",
      "title": {
        "zh": "例句 Examples",
        "en": "Examples"
      },
      "items": [
        {
          "id": "l44-example-01",
          "jp": "昨日ゲームをしすぎて、目が疲れました。",
          "zh": "昨天游戏玩太多，眼睛累了。",
          "en": "I played games too much yesterday, so my eyes got tired."
        },
        {
          "id": "l44-example-02",
          "jp": "このコーヒーは苦すぎます。",
          "zh": "这杯咖啡太苦了。",
          "en": "This coffee is too bitter."
        },
        {
          "id": "l44-example-03",
          "jp": "この説明は複雑すぎて、わかりません。",
          "zh": "这个说明太复杂，我不懂。",
          "en": "This explanation is too complicated, so I do not understand."
        },
        {
          "id": "l44-example-04",
          "jp": "この辞書は例文が多くて、使いやすいです。",
          "zh": "这本词典例句多，很好用。",
          "en": "This dictionary has many examples and is easy to use."
        },
        {
          "id": "l44-example-05",
          "jp": "この道は暗くて、歩きにくいです。",
          "zh": "这条路很暗，不好走。",
          "en": "This road is dark and hard to walk on."
        },
        {
          "id": "l44-example-06",
          "jp": "すみません、音を小さくしてください。",
          "zh": "不好意思，请把声音调小。",
          "en": "Excuse me, please turn the sound down."
        },
        {
          "id": "l44-example-07",
          "jp": "この資料をもっと見やすくしましょう。",
          "zh": "我们把这份资料做得更容易看吧。",
          "en": "Let's make this document easier to read."
        },
        {
          "id": "l44-example-08",
          "jp": "新しいアプリは前より使いやすくなりました。",
          "zh": "新的应用比以前更容易用了。",
          "en": "The new app became easier to use than before."
        }
      ]
    },
    {
      "id": "l44-mistakes",
      "type": "mistakes",
      "title": {
        "zh": "常见错误 Common Mistakes",
        "en": "Common Mistakes"
      },
      "items": [
        {
          "id": "l44-mistake-01",
          "wrong": "この服は高いすぎます。",
          "correct": "この服は高すぎます。",
          "reason": {
            "zh": "い形容词接 すぎます 时去掉 い。",
            "en": "Remove い before すぎます."
          }
        },
        {
          "id": "l44-mistake-02",
          "wrong": "この本は読むやすいです。",
          "correct": "この本は読みやすいです。",
          "reason": {
            "zh": "やすい/にくい 前接动词ます形语干。",
            "en": "Use the masu-stem before やすい/にくい."
          }
        },
        {
          "id": "l44-mistake-03",
          "wrong": "部屋を暖かいにしてください。",
          "correct": "部屋を暖かくしてください。",
          "reason": {
            "zh": "い形容词变状态用 くします。",
            "en": "Use くします with i-adjectives."
          }
        }
      ]
    },
    {
      "id": "l44-quiz",
      "type": "quiz",
      "title": {
        "zh": "最终测试 Final Test",
        "en": "Final Test"
      },
      "items": [
        {
          "id": "l44-quiz-01",
          "question": {
            "zh": "「昨天吃太多了。」正确的是？",
            "en": "Which means: I ate too much yesterday?"
          },
          "options": [
            {
              "text": "昨日食べすぎました。",
              "correct": true
            },
            {
              "text": "昨日食べるすぎました。",
              "correct": false
            },
            {
              "text": "昨日食べてすぎました。",
              "correct": false
            },
            {
              "text": "滑ります"
            }
          ],
          "explanation": {
            "zh": "动词ます形语干 + すぎます。",
            "en": "Use masu-stem + すぎます."
          }
        },
        {
          "id": "l44-quiz-02",
          "question": {
            "zh": "「这件衣服太贵。」正确的是？",
            "en": "Which means: These clothes are too expensive?"
          },
          "options": [
            {
              "text": "この服は高すぎます。",
              "correct": true
            },
            {
              "text": "この服は高いすぎます。",
              "correct": false
            },
            {
              "text": "この服は高くすぎます。",
              "correct": false
            },
            {
              "text": "雨で服がぬれました。"
            }
          ],
          "explanation": {
            "zh": "高い 去 い 后接 すぎます。",
            "en": "Remove い from 高い before すぎます."
          }
        },
        {
          "id": "l44-quiz-03",
          "question": {
            "zh": "「这个问题太简单。」正确的是？",
            "en": "Which means: This question is too easy?"

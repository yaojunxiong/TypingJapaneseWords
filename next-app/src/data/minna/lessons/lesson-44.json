      "id": "l44-mistakes",
      "type": "mistakes",
      "title": {
        "zh": "常见错误 Common Mistakes",
        "en": "Common Mistakes"
      },
      "items": [
        {
          "id": "l44-mistake-01",
          "wrong": "この服は高いすぎます。",
          "correct": "この服は高すぎます。",
          "reason": {
            "zh": "い形容词接 すぎます 时去掉 い。",
            "en": "Remove い before すぎます."
          }
        },
        {
          "id": "l44-mistake-02",
          "wrong": "この本は読むやすいです。",
          "correct": "この本は読みやすいです。",
          "reason": {
            "zh": "やすい/にくい 前接动词ます形语干。",
            "en": "Use the masu-stem before やすい/にくい."
          }
        },
        {
          "id": "l44-mistake-03",
          "wrong": "部屋を暖かいにしてください。",
          "correct": "部屋を暖かくしてください。",
          "reason": {
            "zh": "い形容词变状态用 くします。",
            "en": "Use くします with i-adjectives."
          }
        }
      ]
    },

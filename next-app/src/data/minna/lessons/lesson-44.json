  "topic": {
    "zh": "すぎます",
    "en": "Sugimasu"
  },
  "summary": {
    "zh": "学习过度表达 すぎます、难易表达 やすい/にくい，以及把状态变成某样的 くします/にします。",
    "en": "Learn excess with すぎます, ease/difficulty with やすい/にくい, and changes with くします/にします."
  },
  "sections": [
    {
      "id": "l44-vocab",
      "type": "vocab",
      "title": {
        "zh": "词汇 Vocabulary",
        "en": "Vocabulary"
      },
      "items": [
        {
          "id": "l44-vocab-01",
          "jp": "泣きます",
          "kana": "なきます",
          "zh": "哭",
          "en": "cry",

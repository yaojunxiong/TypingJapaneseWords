                  }
                },
                {
                  "text": {
                    "jp": "この問題は簡単すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }
                },
                {
                  "text": {
                    "jp": "この字は書きにくいです。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "表示某动作难做或不容易发生。",
                "en": "Shows that an action is hard to do or unlikely to happen."
              }
            }
          ]
        },
        {
          "id": "l44-grammar-06",
          "pattern": "い形容詞くします",
          "zh": "表示人为地把某物变成某种い形容词状态。",
          "en": "Shows making something into an i-adjective state.",
          "example": "音を小さくしてください。",
          "practice": [
            {
              "id": "l44-practice-06",
              "skill": "grammar",
              "question": {
                "zh": "表达：请把房间弄暖和。",
                "en": "Say: Please make the room warm."
              },
              "options": [
                {
                  "text": {
                    "jp": "この部屋は寒すぎます。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日食べすぎました。"
                  }

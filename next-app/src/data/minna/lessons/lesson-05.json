    {
      "type": "grammar",
      "id": "l05_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l05_g01",
          "pattern": "場所へ 行きます / 来ます / 帰ります",
          "title": {
            "zh": "去/来/回到某地",
            "en": "Go/Come/Return to a place"
          },
          "explanation": {
            "zh": "目的地后接「へ」，表示移动方向。",
            "en": "Use 「へ」 after destination to indicate direction."
          },
          "examples": [
            {
              "jp": "学校へ 行きます。",
              "zh": "去学校。",
              "en": "I go to school."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“去车站”应说？",
                "en": "How to say “go to the station”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "駅へ 行きます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "駅で 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "駅を 行きます。"
                  }
                },
                {
                  "text": {
                    "jp": "駅にで 行きます。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "表示移动方向常用？",
                "en": "Which marks destination direction?"
              },
              "options": [
                {
                  "text": {
                    "jp": "へ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "を"
                  }
                },
                {
                  "text": {
                    "jp": "が"
                  }
                },
                {
                  "text": {
                    "jp": "で"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l05_g02",
          "pattern": "交通工具で 行きます",
          "title": {
            "zh": "用交通工具去",
            "en": "Go by transportation"
          },
          "explanation": {
            "zh": "交通工具后接「で」，表示方式。",
            "en": "Use 「で」 after transportation to show means."
          },
          "examples": [
            {
              "jp": "電車で 会社へ 行きます。",
              "zh": "我坐电车去公司。",
              "en": "I go to the office by train."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“坐公交去”应说？",
                "en": "How to say “go by bus”?"
              },
              "options": [

    {
      "type": "grammar",
      "id": "l36_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l36_g01",
          "pattern": "可能形 + ように",
          "explanation": {
            "zh": "表示为了达到某种能力状态而努力。前项常是可能形。",
            "en": "Expresses effort toward an ability or state; the first verb is often potential form."
          },
          "examples": [
            {
              "jp": "日本語が話せるように、毎日練習します。",
              "zh": "为了能说日语，每天练习。",
              "en": "I practice every day so that I can speak Japanese."
            }
          ],
          "practice": [
            {
              "id": "l36_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“为了能读新闻”正确的是？",
                "en": "How do you say 'so that I can read newspapers'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "新聞が読めるように"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "新聞を読むためにできる"
                  }
                },
                {
                  "text": {
                    "jp": "新聞が読むように"
                  }
                },
                {
                  "text": {
                    "jp": "新聞を読めますように"
                  }
                }
              ],
              "explanation": {
                "zh": "能力目标用可能形 + ように。",
                "en": "Use potential form + you ni for ability goals."
              }
            }
          ]
        },
        {
          "id": "l36_g02",
          "pattern": "ない形 + ように",
          "explanation": {
            "zh": "表示为了避免某状态或动作发生：“为了不……”。",
            "en": "Expresses avoidance: so that something does not happen."
          },
          "examples": [
            {
              "jp": "忘れないように、メモします。",
              "zh": "为了不忘，做笔记。",
              "en": "I take notes so that I do not forget."
            }
          ],
          "practice": [
            {
              "id": "l36_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“为了不迟到”是？",
                "en": "How do you say 'so that I will not be late'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "遅れないように"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "遅れなくために"
                  }
                },
                {
                  "text": {
                    "jp": "遅れないためにように"
                  }
                },
                {
                  "text": {
                    "jp": "遅れませんように"
                  }
                }
              ],
              "explanation": {
                "zh": "避免目标用ない形+ように。",
                "en": "Use nai-form + you ni."
              }
            }
          ]
        },
        {
          "id": "l36_g03",
          "pattern": "辞书形 / ない形 + ようになります",
          "explanation": {
            "zh": "表示能力、习惯或状态逐渐发生变化。",
            "en": "Shows a change in ability, habit, or state."
          },
          "examples": [
            {
              "jp": "日本語の新聞が読めるようになりました。",
              "zh": "变得能读日语报纸了。",
              "en": "I became able to read Japanese newspapers."
            }
          ],
          "practice": [
            {
              "id": "l36_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“变得能游泳了”是？",
                "en": "How do you say 'I became able to swim'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "泳げるようになりました"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "泳ぐようになれました"
                  }
                },
                {
                  "text": {
                    "jp": "泳げますようになりました"
                  }
                },
                {
                  "text": {
                    "jp": "泳ぐためになりました"
                  }
                }
              ],
              "explanation": {
                "zh": "能力变化用可能形+ようになりました。",
                "en": "Ability change uses potential form + you ni narimashita."
              }
            }
          ]
        },
        {
          "id": "l36_g04",
          "pattern": "辞书形 / ない形 + ようにしています",
          "explanation": {
            "zh": "表示平时努力坚持做或不做某事。",
            "en": "Shows regular effort to do or avoid something."
          },
          "examples": [
            {
              "jp": "毎日運動するようにしています。",
              "zh": "我尽量每天运动。",
              "en": "I try to exercise every day."
            }
          ],
          "practice": [
            {
              "id": "l36_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“尽量不吃太多甜食”是？",
                "en": "How do you say 'I try not to eat too many sweets'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "甘い物を食べすぎないようにしています"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "甘い物を食べすぎなくしています"
                  }
                },
                {
                  "text": {
                    "jp": "甘い物を食べすぎないためにしています"
                  }
                },
                {
                  "text": {
                    "jp": "甘い物を食べすぎませんようにします"
                  }
                }
              ],
              "explanation": {
                "zh": "平时努力用ようにしています。",
                "en": "Use you ni shite imasu for regular effort."
              }
            }
          ]
        },
        {
          "id": "l36_g05",
          "pattern": "辞书形 / ない形 + ようにしてください",
          "explanation": {
            "zh": "委婉要求对方尽量保持某动作或避免某动作。",
            "en": "Politely asks someone to make an effort to do or avoid something."
          },
          "examples": [
            {
              "jp": "明日は遅れないようにしてください。",
              "zh": "明天请不要迟到。",
              "en": "Please make sure not to be late tomorrow."
            }
          ],
          "practice": [
            {
              "id": "l36_g05_p01",
              "skill": "grammar",
              "question": {
                "zh": "“请每天复习”是？",
                "en": "How do you say 'Please review every day'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "毎日復習するようにしてください"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "毎日復習してようにしてください"
                  }
                },
                {
                  "text": {
                    "jp": "毎日復習しますようにしてください"
                  }
                },
                {
                  "text": {
                    "jp": "毎日復習するためにください"
                  }
                }
              ],
              "explanation": {
                "zh": "要求习惯用辞书形+ようにしてください。",
                "en": "Use dictionary form + you ni shite kudasai."
              }
            }
          ]
        },
        {
          "id": "l36_g06",
          "pattern": "ために vs ように",
          "explanation": {
            "zh": "意志动作目标多用「ために」；能力、状态、无意志变化多用「ように」。",
            "en": "Tame ni often marks intentional goals; you ni often marks ability, state, or non-volitional goals."
          },
          "examples": [
            {
              "jp": "日本語が話せるように、練習します。",
              "zh": "为了能说日语而练习。",
              "en": "I practice so that I can speak Japanese."
            }
          ],
          "practice": [
            {
              "id": "l36_g06_p01",
              "skill": "grammar",
              "question": {
                "zh": "“为了能看懂电影”更自然的是？",
                "en": "Which is more natural for 'so I can understand movies'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "映画がわかるように、勉強します"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "映画がわかるために、勉強します"
                  }
                },
                {
                  "text": {
                    "jp": "映画をわかるために、勉強します"
                  }
                },
                {
                  "text": {
                    "jp": "映画がわかりますように、勉強します"
                  }
                }
              ],
              "explanation": {
                "zh": "能力/状态目标用ように。",
                "en": "Use you ni for ability/state goals."
              }
            }
          ]
        },
        {
          "id": "l36_g07",
          "pattern": "見える / 聞こえる + ように",
          "explanation": {
            "zh": "无意志动词也常接「ように」，表示让某状态实现。",
            "en": "Non-volitional verbs like mieru/kikoeru often use you ni for state goals."
          },
          "examples": [
            {
              "jp": "後ろの人にも見えるように、大きく書いてください。",
              "zh": "请写大一点，让后面的人也看得见。",
              "en": "Please write large so that people in the back can see."
            }
          ],

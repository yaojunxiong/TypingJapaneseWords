    {
      "type": "grammar",
      "id": "l34_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l34_g01",
          "pattern": "名词 の とおりに",
          "explanation": {
            "zh": "按照说明、图、范例等去做。",
            "en": "Do something according to a manual, diagram, model, or plan."
          },
          "examples": [
            {
              "jp": "説明書のとおりに組み立てます。",
              "zh": "按说明书组装。",
              "en": "Assemble it according to the manual."
            }
          ],
          "practice": [
            {
              "id": "l34_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“按说明书做”是？",
                "en": "How do you say 'do it according to the manual'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "説明書のとおりにします"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "説明書とおりにします"
                  }
                },
                {
                  "text": {
                    "jp": "説明書にとおりします"
                  }
                },
                {
                  "text": {
                    "jp": "説明書をとおりにします"
                  }
                }
              ],
              "explanation": {
                "zh": "名词后接「のとおりに」。",
                "en": "Use noun + no toori ni."
              }
            }
          ]
        },
        {
          "id": "l34_g02",
          "pattern": "动词辞书形 + とおりに",
          "explanation": {
            "zh": "按照将要说明、指示的内容去做。",
            "en": "Do something as someone will explain or instruct."
          },
          "examples": [
            {
              "jp": "わたしが言うとおりに書いてください。",
              "zh": "请按我说的写。",
              "en": "Please write as I say."
            }
          ],
          "practice": [
            {
              "id": "l34_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“请按我说的做”是？",
                "en": "How do you say 'Please do as I say'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "わたしが言うとおりにしてください"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "わたしが言ってとおりにしてください"
                  }
                },
                {
                  "text": {
                    "jp": "わたしが言うのとおりしてください"
                  }
                },
                {
                  "text": {
                    "jp": "わたしが言いますとおりにしてください"
                  }
                }
              ],
              "explanation": {
                "zh": "动词辞书形直接接とおりに。",
                "en": "Dictionary form attaches directly to toori ni."
              }
            }
          ]
        },
        {
          "id": "l34_g03",
          "pattern": "动词た形 + とおりに",
          "explanation": {
            "zh": "按照已经说过、看过、写好的内容做。",
            "en": "Do something as was already said, shown, or written."
          },
          "examples": [
            {
              "jp": "先生が説明したとおりに練習します。",
              "zh": "按老师说明的那样练习。",
              "en": "Practice as the teacher explained."
            }
          ],
          "practice": [
            {
              "id": "l34_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“按老师说过的做”是？",
                "en": "How do you say 'do as the teacher said'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生が言ったとおりにします"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生が言ってとおりにします"
                  }
                },
                {
                  "text": {
                    "jp": "先生が言ったのとおりします"
                  }
                },
                {
                  "text": {
                    "jp": "先生が言いましたとおりにします"
                  }
                }
              ],
              "explanation": {
                "zh": "已经说过用た形+とおりに。",
                "en": "Use past plain form + toori ni."
              }
            }
          ]
        },
        {
          "id": "l34_g04",
          "pattern": "动词た形 + あとで",
          "explanation": {
            "zh": "表示一个动作完成之后再做另一个动作。",
            "en": "After completing one action, do another."
          },
          "examples": [
            {
              "jp": "ご飯を食べたあとで、薬を飲みます。",
              "zh": "吃饭后吃药。",
              "en": "I take medicine after eating."
            }
          ],
          "practice": [
            {
              "id": "l34_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“看电影后回家”是？",
                "en": "How do you say 'go home after watching a movie'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "映画を見たあとで、帰ります"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "映画を見てあとで、帰ります"
                  }
                },
                {
                  "text": {
                    "jp": "映画を見るあとで、帰ります"
                  }
                },
                {
                  "text": {
                    "jp": "映画を見ますあとで、帰ります"
                  }
                }
              ],
              "explanation": {
                "zh": "动词た形+あとで。",
                "en": "Past plain form + ato de."
              }
            }
          ]
        },
        {
          "id": "l34_g05",
          "pattern": "名词 の あとで",
          "explanation": {
            "zh": "名词后接「のあとで」，表示“……之后”。",
            "en": "Noun + no ato de means after..."
          },
          "examples": [
            {
              "jp": "授業のあとで、図書館へ行きます。",
              "zh": "下课后去图书馆。",
              "en": "I go to the library after class."
            }
          ],
          "practice": [
            {
              "id": "l34_g05_p01",
              "skill": "grammar",
              "question": {
                "zh": "“会议后”是？",
                "en": "How do you say 'after the meeting'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "会議のあとで"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "会議あとで"
                  }
                },
                {
                  "text": {
                    "jp": "会議にあとで"
                  }
                },
                {
                  "text": {
                    "jp": "会議をあとで"
                  }
                }
              ],
              "explanation": {
                "zh": "名词+のあとで。",
                "en": "Noun + no ato de."
              }
            }
          ]
        },
        {
          "id": "l34_g06",
          "pattern": "动词て形 + 动词",
          "explanation": {
            "zh": "表示伴随状态：带着、穿着、戴着等。",
            "en": "Shows an accompanying state: wearing, carrying, holding, etc."
          },
          "examples": [
            {
              "jp": "傘を持って出かけます。",
              "zh": "带着伞出门。",
              "en": "I go out carrying an umbrella."
            }
          ],
          "practice": [
            {
              "id": "l34_g06_p01",
              "skill": "grammar",
              "question": {
                "zh": "“戴着帽子去”是？",
                "en": "How do you say 'go wearing a hat'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "帽子をかぶって行きます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "帽子をかぶるで行きます"
                  }
                },
                {
                  "text": {
                    "jp": "帽子をかぶらないで行きます"
                  }
                },
                {
                  "text": {
                    "jp": "帽子をかぶったあとで行きますだけ"
                  }
                }
              ],
              "explanation": {
                "zh": "伴随状态用て形。",
                "en": "Use te-form for accompanying state."
              }
            }
          ]
        },
        {
          "id": "l34_g07",
          "pattern": "ない形 + ないで",
          "explanation": {
            "zh": "表示不做A而做B。",
            "en": "Do B without doing A."
          },
          "examples": [
            {
              "jp": "朝ご飯を食べないで学校へ行きました。",
              "zh": "没吃早饭就去学校了。",
              "en": "I went to school without eating breakfast."
            }
          ],
          "practice": [
            {
              "id": "l34_g07_p01",
              "skill": "grammar",
              "question": {
                "zh": "“不看字典写”是？",
                "en": "How do you say 'write without looking at the dictionary'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "辞書を見ないで書きます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "辞書を見なくて書きます"
                  }
                },
                {
                  "text": {
                    "jp": "辞書を見てないで書きます"
                  }
                },
                {
                  "text": {
                    "jp": "辞書を見ないあとで書きます"
                  }
                }
              ],
              "explanation": {
                "zh": "不做A而做B用ない形+ないで。",
                "en": "Use nai-form + nai de."
              }
            }
          ]
        },
        {
          "id": "l34_g08",
          "pattern": "て vs ないで",
          "explanation": {
            "zh": "「て」表示带着某状态做；「ないで」表示不做某事而做。",
            "en": "Te indicates doing with a state; nai de indicates doing without something."
          },
          "examples": [
            {
              "jp": "靴を脱いで入ります。 / 靴を脱がないで入ってはいけません。",
              "zh": "脱鞋进去。/ 不脱鞋不能进去。",
              "en": "Enter after taking off shoes. / You must not enter without taking off shoes."
            }
          ],
          "practice": [
            {
              "id": "l34_g08_p01",
              "skill": "grammar",
              "question": {
                "zh": "“不带钱就出门了”是？",
                "en": "How do you say 'I went out without bringing money'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "お金を持たないで出かけました"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "お金を持って出かけませんでした"
                  }
                },
                {
                  "text": {
                    "jp": "お金を持たなくて出かけました"
                  }
                },
                {
                  "text": {
                    "jp": "お金を持ったあとで出かけません"
                  }
                }
              ],
              "explanation": {
                "zh": "without doing 用ないで。",
                "en": "Use nai de for 'without doing'."
              }
            }
          ]
        }
      ]
    },

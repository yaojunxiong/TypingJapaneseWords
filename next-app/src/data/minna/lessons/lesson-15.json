    {
      "type": "grammar",
      "id": "l15_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l15_g01",
          "pattern": "Vても いいです",
          "title": {
            "zh": "许可表达",
            "en": "Permission"
          },
          "explanation": {
            "zh": "表示被允许做某事。",
            "en": "Expresses permission."
          },
          "examples": [
            {
              "jp": "ここで写真を撮ってもいいです。",
              "zh": "这里可以拍照。",
              "en": "You may take photos here."
            }
          ],
          "practice": [
            {
              "id": "l15_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“可以坐这里吗？”是？",
                "en": "How to ask: May I sit here?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ここに座ってもいいですか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ここに座りてもいいですか。"
                  }
                },
                {
                  "text": {
                    "jp": "ここで座ってはいけませんか。"
                  }
                },
                {
                  "text": {
                    "jp": "ここに座ってくださいか。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示被允许做某事。",
                "en": "Expresses permission."
              }
            },
            {
              "id": "l15_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“可以开门”是？",
                "en": "How to say: You may open the door?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ドアを開けてもいいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ドアを開けてください。"
                  }
                },
                {
                  "text": {
                    "jp": "ドアを開けてはいけません。"
                  }
                },
                {
                  "text": {
                    "jp": "ドアが開けてもいいです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示被允许做某事。",
                "en": "Expresses permission."
              }
            }
          ]
        },
        {
          "id": "l15_g02",
          "pattern": "Vては いけません",
          "title": {
            "zh": "禁止表达",
            "en": "Prohibition"
          },
          "explanation": {
            "zh": "表示不允许。",
            "en": "Expresses prohibition."
          },
          "examples": [
            {
              "jp": "ここでたばこを吸ってはいけません。",
              "zh": "这里不能吸烟。",
              "en": "You must not smoke here."
            }
          ],
          "practice": [
            {
              "id": "l15_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“这里不能拍照”是？",
                "en": "How to say: You must not take photos here?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ここで写真を撮ってはいけません。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ここで写真を撮ってもいいです。"
                  }
                },
                {
                  "text": {
                    "jp": "ここで写真を撮らないでください。"
                  }
                },
                {
                  "text": {
                    "jp": "ここで写真が撮ってはいけません。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示不允许。",
                "en": "Expresses prohibition."
              }
            },
            {
              "id": "l15_g02_p02",
              "skill": "grammar",
              "question": {
                "zh": "“会议中不能说话”是？",
                "en": "How to say: Must not talk during meeting?"
              },
              "options": [
                {
                  "text": {
                    "jp": "会議中に話してはいけません。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "会議中に話してもいいです。"
                  }
                },
                {
                  "text": {
                    "jp": "会議中に話しないでください。"
                  }
                },
                {
                  "text": {
                    "jp": "会議中は話します。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示不允许。",
                "en": "Expresses prohibition."
              }
            }
          ]
        },
        {
          "id": "l15_g03",
          "pattern": "Vています",
          "title": {
            "zh": "进行或状态",
            "en": "Ongoing action/state"
          },
          "explanation": {
            "zh": "表示正在进行或持续状态。",
            "en": "Indicates ongoing action or resulting state."
          },
          "examples": [
            {
              "jp": "私は東京に住んでいます。",
              "zh": "我住在东京。",
              "en": "I live in Tokyo."
            }
          ],
          "practice": [
            {
              "id": "l15_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我现在在工作”是？",
                "en": "How to say: I am working now?"
              },
              "options": [
                {
                  "text": {
                    "jp": "今、働いています。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "今、働きます。"
                  }
                },
                {
                  "text": {
                    "jp": "今、働いてです。"
                  }
                },
                {
                  "text": {
                    "jp": "今、働くています。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示正在进行或持续状态。",
                "en": "Indicates ongoing action or resulting state."
              }
            },
            {
              "id": "l15_g03_p02",
              "skill": "grammar",
              "question": {
                "zh": "“我知道他的名字”是？",
                "en": "How to say: I know his name?"
              },
              "options": [
                {
                  "text": {
                    "jp": "彼の名前を知っています。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "彼の名前を知りです。"
                  }
                },
                {
                  "text": {
                    "jp": "彼の名前が知ります。"
                  }
                },
                {
                  "text": {
                    "jp": "彼の名前を知ってもいいです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示正在进行或持续状态。",
                "en": "Indicates ongoing action or resulting state."
              }
            }
          ]
        },
        {
          "id": "l15_g04",
          "pattern": "〜ていますか",
          "title": {
            "zh": "询问持续状态",
            "en": "Ask ongoing state"
          },
          "explanation": {
            "zh": "询问对方是否处于某状态。",
            "en": "Ask whether someone is in an ongoing state."
          },
          "examples": [
            {
              "jp": "パスポートを持っていますか。",
              "zh": "你有护照吗？",
              "en": "Do you have a passport?"
            }
          ],
          "practice": [
            {
              "id": "l15_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“你住在大阪吗？”是？",
                "en": "How to ask: Do you live in Osaka?"
              },
              "options": [
                {
                  "text": {
                    "jp": "大阪に住んでいますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "大阪に住みますか。"
                  }
                },
                {
                  "text": {
                    "jp": "大阪で住んでいますか。"
                  }
                },
                {
                  "text": {
                    "jp": "大阪に住んでもいいですか。"
                  }
                }
              ],
              "explanation": {
                "zh": "询问对方是否处于某状态。",
                "en": "Ask whether someone is in an ongoing state."
              }
            },
            {
              "id": "l15_g04_p02",
              "skill": "grammar",
              "question": {
                "zh": "“你知道地址吗？”是？",
                "en": "How to ask: Do you know the address?"
              },
              "options": [
                {
                  "text": {
                    "jp": "住所を知っていますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "住所が知りいますか。"
                  }
                },
                {
                  "text": {
                    "jp": "住所を知りますか。"
                  }
                },
                {
                  "text": {
                    "jp": "住所を知ってはいけませんか。"
                  }
                }
              ],
              "explanation": {
                "zh": "询问对方是否处于某状态。",
                "en": "Ask whether someone is in an ongoing state."
              }
            }
          ]
        }
      ]

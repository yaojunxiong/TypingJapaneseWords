    {
      "type": "grammar",
      "id": "l15_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l15_g01",
          "pattern": "Vても いいです",
          "title": {
            "zh": "许可表达",
            "en": "Permission"
          },
          "explanation": {
            "zh": "表示被允许做某事。",
            "en": "Expresses permission."
          },
          "examples": [
            {
              "jp": "ここで写真を撮ってもいいです。",
              "zh": "这里可以拍照。",
              "en": "You may take photos here."
            }
          ],
          "practice": [
            {
              "id": "l15_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“可以坐这里吗？”是？",
                "en": "How to ask: May I sit here?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ここに座ってもいいですか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ここに座りてもいいですか。"
                  }
                },
                {
                  "text": {
                    "jp": "ここで座ってはいけませんか。"
                  }
                },
                {
                  "text": {
                    "jp": "ここに座ってくださいか。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示被允许做某事。",
                "en": "Expresses permission."
              }
            },
            {
              "id": "l15_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“可以开门”是？",
                "en": "How to say: You may open the door?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ドアを開けてもいいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ドアを開けてください。"
                  }
                },

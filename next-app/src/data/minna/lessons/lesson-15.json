      "items": [
        {
          "id": "l15_q01",
          "question": {
            "zh": "「てもいいです」的意思是？",
            "en": "What does てもいいです mean?"
          },
          "options": [
            {
              "text": {
                "zh": "可以做〜",
                "en": "may do~"
              },
              "correct": true
            },
            {
              "text": {
                "zh": "不可以做〜",
                "en": "must not do~"
              }
            },
            {
              "text": {
                "zh": "知道",
                "en": "know"
              }
            },
            {
              "text": {
                "zh": "居住",
                "en": "live"
              }
            }
          ],
          "explanation": {
            "zh": "「てもいいです」表示「可以做〜」。",
            "en": "てもいいです means may do~."
          }
        },
        {
          "id": "l15_q02",
          "question": {
            "zh": "哪一句最符合语法「Vても いいです」？",
            "en": "Which sentence best matches pattern \"Vても いいです\"?"
          },
          "options": [
            {
              "text": {
                "jp": "ここで写真を撮ってもいいです。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "ここでたばこを吸ってはいけません。"
              }
            },
            {
              "text": {
                "jp": "私は東京に住んでいます。"
              }
            },
            {
              "text": {
                "jp": "パスポートを持っていますか。"
              }
            }
          ],
          "explanation": {
            "zh": "正确句型是「Vても いいです」。",
            "en": "The correct pattern is \"Vても いいです\"."
          }
        },
        {
          "id": "l15_q03",
          "question": {
            "zh": "关于「Vては いけません」最恰当的是？",
            "en": "Which usage best fits \"Vては いけません\"?"
          },
          "options": [
            {
              "text": {
                "jp": "ここで写真を撮ってはいけません。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "ここで写真を撮ってもいいです。"
              }
            },
            {
              "text": {
                "jp": "ここで写真を撮らないでください。"
              }
            },
            {
              "text": {
                "jp": "ここで写真が撮ってはいけません。"
              }
            }
          ],
          "explanation": {
            "zh": "表示不允许。",
            "en": "Expresses prohibition."
          }
        },
        {
          "id": "l15_q04",
          "question": {
            "zh": "与「这里可以用手机吗？」对应的日语句子是？",
            "en": "Which Japanese sentence matches \"May I use my phone here?\"?"
          },
          "options": [
            {
              "text": {
                "jp": "ここで携帯を使ってもいいですか。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "図書館で大きい声で話してはいけません。"
              }
            },
            {
              "text": {
                "jp": "妹は今薬を飲んでいます。"
              }
            },
            {
              "text": {
                "jp": "田中さんは会社で働いています。"
              }
            }
          ],
          "explanation": {
            "zh": "对应句子是「ここで携帯を使ってもいいですか。」。",
            "en": "The matching sentence is \"ここで携帯を使ってもいいですか。\"."
          }
        }
      ]

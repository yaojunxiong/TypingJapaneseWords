    {
      "id": "l47-grammar",
      "type": "grammar",
      "title": {
        "zh": "语法 Grammar",
        "en": "Grammar"
      },
      "items": [
        {
          "id": "l47-grammar-01",
          "pattern": "普通形 + そうです",
          "zh": "表示听说、据说，传达从别人或新闻获得的信息。",
          "en": "Hearsay: reports information heard from someone or the news.",
          "example": "天気予報によると、明日は雨が降るそうです。",
          "practice": [
            {
              "id": "l47-practice-01",
              "skill": "grammar",
              "question": {
                "zh": "表达：听天气预报说明天会下雨。",
                "en": "Say: According to the weather forecast, it will rain tomorrow."
              },
              "options": [
                {
                  "text": {
                    "jp": "天気予報によると、明日は雨が降るそうです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ニュースによると、電車が止まったそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "明日は休みだそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "北海道は寒いそうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示听说、据说，传达从别人或新闻获得的信息。",
                "en": "Hearsay: reports information heard from someone or the news."
              }
            }
          ]
        },
        {
          "id": "l47-grammar-02",
          "pattern": "い形容詞普通形 + そうです",
          "zh": "传闻里的い形容词不去掉 い。",
          "en": "For hearsay, keep the full i-adjective form.",
          "example": "この町は冬とても寒いそうです。",
          "practice": [
            {
              "id": "l47-practice-02",
              "skill": "grammar",
              "question": {
                "zh": "表达：听说北海道很冷。",
                "en": "Say: I hear Hokkaido is cold."
              },
              "options": [
                {
                  "text": {
                    "jp": "北海道は寒いそうです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "天気予報によると、明日は雨が降るそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "ニュースによると、電車が止まったそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "明日は休みだそうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "传闻里的い形容词不去掉 い。",
                "en": "For hearsay, keep the full i-adjective form."
              }
            }
          ]
        },
        {
          "id": "l47-grammar-03",
          "pattern": "な形容詞 / 名詞 + だそうです",
          "zh": "传闻里的な形容词和名词保留 だ。",
          "en": "For hearsay, keep だ after na-adjectives and nouns.",
          "example": "田中さんは元気だそうです。明日は休みだそうです。",
          "practice": [
            {
              "id": "l47-practice-03",
              "skill": "grammar",
              "question": {
                "zh": "表达：听说明天是休息日。",
                "en": "Say: I hear tomorrow is a day off."
              },
              "options": [
                {
                  "text": {
                    "jp": "明日は休みだそうです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "天気予報によると、明日は雨が降るそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "ニュースによると、電車が止まったそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "北海道は寒いそうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "传闻里的な形容词和名词保留 だ。",
                "en": "For hearsay, keep だ after na-adjectives and nouns."
              }
            }
          ]
        },
        {
          "id": "l47-grammar-04",
          "pattern": "情報源 + によると、〜そうです",
          "zh": "说明消息来源时常用 によると。",
          "en": "Use によると to state the information source.",
          "example": "新聞によると、駅前に新しい店ができるそうです。",
          "practice": [
            {
              "id": "l47-practice-04",
              "skill": "grammar",
              "question": {
                "zh": "表达：据新闻说，电车停了。",
                "en": "Say: According to the news, the train stopped."
              },
              "options": [
                {
                  "text": {
                    "jp": "天気予報によると、明日は雨が降るそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "明日は休みだそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "ニュースによると、電車が止まったそうです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "北海道は寒いそうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "说明消息来源时常用 によると。",
                "en": "Use によると to state the information source."
              }
            }
          ]
        },
        {
          "id": "l47-grammar-05",
          "pattern": "普通形 + ようです",
          "zh": "根据看到、听到、感觉到的迹象作推断。",
          "en": "Makes an inference based on signs, sounds, or impressions.",
          "example": "外が暗いです。雨が降っているようです。",
          "practice": [
            {
              "id": "l47-practice-05",
              "skill": "grammar",
              "question": {
                "zh": "表达：外面有声音，好像有人来了。",
                "en": "Say: There is a sound outside; it seems someone came."
              },
              "options": [
                {
                  "text": {
                    "jp": "北海道は寒いそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "明日は休みだそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "外で音がします。だれか来たようです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "天気予報によると、明日は雨が降るそうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "根据看到、听到、感觉到的迹象作推断。",
                "en": "Makes an inference based on signs, sounds, or impressions."
              }
            }
          ]
        },
        {
          "id": "l47-grammar-06",
          "pattern": "い形容詞 / な形容詞な / 名詞の + ようです",
          "zh": "ようです 接续：い形容词直接接，な形容词用 な，名词用 の。",
          "en": "With ようです: attach directly to i-adjectives, use な for na-adjectives, and の for nouns.",
          "example": "この問題は難しいようです。あの人は学生のようです。",
          "practice": [
            {
              "id": "l47-practice-06",
              "skill": "grammar",
              "question": {
                "zh": "表达：那个人好像是医生。",
                "en": "Say: That person seems to be a doctor."
              },
              "options": [
                {
                  "text": {
                    "jp": "あの人は医者のようです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "天気予報によると、明日は雨が降るそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "北海道は寒いそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "明日は休みだそうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "ようです 接续：い形容词直接接，な形容词用 な，名词用 の。",
                "en": "With ようです: attach directly to i-adjectives, use な for na-adjectives, and の for nouns."
              }
            }
          ]
        },
        {
          "id": "l47-grammar-07",
          "pattern": "〜ような + N / 〜ように + V",
          "zh": "ようです 可修饰名词或动词，表示像某样。",
          "en": "よう can modify nouns or verbs to mean 'like' or 'as if'.",
          "example": "夢のような話です。子どものように笑いました。",
          "practice": [
            {
              "id": "l47-practice-07",
              "skill": "grammar",
              "question": {
                "zh": "表达：像梦一样的故事。",
                "en": "Say: a story like a dream."
              },
              "options": [
                {
                  "text": {
                    "jp": "明日は休みだそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "夢のような話です。"
                  },
                  "correct": true
                },

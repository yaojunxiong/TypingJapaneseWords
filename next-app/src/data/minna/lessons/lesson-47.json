    {
      "id": "l47-mistakes",
      "type": "mistakes",
      "title": {
        "zh": "常见错误 Common Mistakes",
        "en": "Common Mistakes"
      },
      "items": [
        {
          "id": "l47-mistake-01",
          "wrong": "明日は雨が降りそうです。",
          "correct": "明日は雨が降るそうです。",
          "reason": {
            "zh": "表示听说时用普通形 + そうです；降りそうです 是看起来要下雨。",
            "en": "For hearsay, use plain form + そうです; 降りそうです means it looks like it will rain."
          }
        },
        {
          "id": "l47-mistake-02",
          "wrong": "明日は休みそうです。",
          "correct": "明日は休みだそうです。",
          "reason": {
            "zh": "名词传闻要保留 だ。",
            "en": "Keep だ for noun hearsay."
          }
        },
        {
          "id": "l47-mistake-03",
          "wrong": "あの人は医者ようです。",
          "correct": "あの人は医者のようです。",
          "reason": {
            "zh": "名词接 ようです 要用 の。",
            "en": "Use の before ようです after nouns."
          }
        }
      ]
    },

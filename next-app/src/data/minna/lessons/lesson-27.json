    {
      "type": "grammar",
      "id": "l27_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l27_g01",
          "pattern": "一类动词可能形：う段 → え段 + ます",
          "explanation": {
            "zh": "一类动词把ます形前的音变到え段：話します→話せます、泳ぎます→泳げます。",
            "en": "For group 1 verbs, change the final u-sound to the e-sound: hanashimasu to hanasemasu."
          },
          "examples": [
            {
              "jp": "日本語が話せます。",
              "zh": "会说日语。",
              "en": "I can speak Japanese."
            }
          ],
          "practice": [
            {
              "id": "l27_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "「泳ぎます」的可能形是？",
                "en": "What is the potential form of oyogimasu?"
              },
              "options": [
                {
                  "text": {
                    "jp": "泳げます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "泳ぎられます"
                  }
                },
                {
                  "text": {
                    "jp": "泳がれます"
                  }
                },
                {
                  "text": {
                    "jp": "泳ぎできます"
                  }
                }
              ],
              "explanation": {
                "zh": "ぎ变成げ。",
                "en": "gi changes to ge."
              }
            }
          ]
        },
        {
          "id": "l27_g02",
          "pattern": "二类动词可能形：ます形去ます + られます",
          "explanation": {
            "zh": "二类动词如「食べます→食べられます」「見ます→見られます」。",
            "en": "Group 2 verbs add raremasu: tabemasu to taberaremasu."
          },
          "examples": [
            {
              "jp": "この映画は子どもも見られます。",
              "zh": "这部电影孩子也能看。",
              "en": "Children can also watch this movie."
            }
          ],
          "practice": [
            {
              "id": "l27_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "「食べます」的可能形是？",
                "en": "What is the potential form of tabemasu?"
              },
              "options": [
                {
                  "text": {
                    "jp": "食べられます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "食べれます"
                  }
                },
                {
                  "text": {
                    "jp": "食べますできます"
                  }
                },
                {
                  "text": {
                    "jp": "食べされます"
                  }
                }
              ],
              "explanation": {
                "zh": "标准形是「食べられます」。",
                "en": "The standard form is taberaremasu."
              }
            }
          ]
        },
        {
          "id": "l27_g03",
          "pattern": "三类动词：します→できます、来ます→来られます",
          "explanation": {
            "zh": "「します」的可能形不是「しられます」，而是「できます」。",
            "en": "The potential of shimasu is dekimasu; kimasu becomes koraremasu."
          },
          "examples": [
            {
              "jp": "漢字が勉強できます。",
              "zh": "能学习汉字。",
              "en": "I can study kanji."
            }
          ],
          "practice": [
            {
              "id": "l27_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "「します」的可能形是？",
                "en": "What is the potential form of shimasu?"
              },
              "options": [
                {
                  "text": {
                    "jp": "できます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "しられます"
                  }
                },
                {
                  "text": {
                    "jp": "しますできます"
                  }
                },
                {
                  "text": {
                    "jp": "されます"
                  }
                }
              ],
              "explanation": {
                "zh": "三类动词特殊变化。",
                "en": "This is an irregular verb."
              }
            }
          ]
        },
        {
          "id": "l27_g04",
          "pattern": "对象常用 が",
          "explanation": {
            "zh": "可能形里，原来「を」标记的对象常改用「が」。",
            "en": "With potential verbs, the object often changes from o to ga."
          },
          "examples": [
            {
              "jp": "漢字が読めます。",
              "zh": "能读汉字。",
              "en": "I can read kanji."
            }
          ],
          "practice": [
            {
              "id": "l27_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“会说英语”最自然的是？",
                "en": "Which naturally means 'I can speak English'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "英語が話せます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "英語を話せます"
                  }
                },
                {
                  "text": {
                    "jp": "英語に話せます"
                  }
                },
                {
                  "text": {
                    "jp": "英語で話せます"
                  }
                }
              ],
              "explanation": {
                "zh": "可能形对象常用「が」。",
                "en": "The object of a potential verb often takes ga."
              }
            }
          ]
        },
        {
          "id": "l27_g05",
          "pattern": "〜が見えます",
          "explanation": {
            "zh": "表示自然进入视野的“看得见”，不是主动看。",
            "en": "Miemasu means something is visible naturally, not actively watching."
          },
          "examples": [
            {
              "jp": "窓から海が見えます。",
              "zh": "从窗户看得见海。",
              "en": "The sea is visible from the window."
            }
          ],
          "practice": [
            {
              "id": "l27_g05_p01",
              "skill": "grammar",
              "question": {
                "zh": "“看得见山”应说？",
                "en": "How do you say 'The mountain is visible'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "山が見えます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "山を見ます"
                  }
                },
                {
                  "text": {
                    "jp": "山が見ます"
                  }
                },
                {
                  "text": {
                    "jp": "山を見えます"
                  }
                }
              ],
              "explanation": {
                "zh": "自然看得见用「が見えます」。",
                "en": "Use ga miemasu for natural visibility."
              }
            }
          ]
        },
        {
          "id": "l27_g06",
          "pattern": "〜が聞こえます",
          "explanation": {
            "zh": "表示声音自然传来“听得见”，不是主动听。",
            "en": "Kikoemasu means a sound can be heard naturally."
          },
          "examples": [
            {
              "jp": "鳥の声が聞こえます。",
              "zh": "听得见鸟叫声。",
              "en": "I can hear birds."
            }
          ],
          "practice": [
            {
              "id": "l27_g06_p01",
              "skill": "grammar",
              "question": {
                "zh": "“听得见声音”应说？",
                "en": "How do you say 'I can hear a voice'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "声が聞こえます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "声を聞こえます"
                  }
                },
                {
                  "text": {
                    "jp": "声が聞きます"
                  }
                },
                {
                  "text": {
                    "jp": "声を聞けますです"
                  }
                }
              ],
              "explanation": {
                "zh": "自然听得见用「が聞こえます」。",
                "en": "Use ga kikoemasu for natural audibility."
              }
            }
          ]
        },
        {
          "id": "l27_g07",
          "pattern": "〜ができます：建成；交到；做好",
          "explanation": {
            "zh": "「できます」除了“能做”，也表示某物建成、事情完成或朋友交到。",
            "en": "Dekimasu can mean something is built, completed, or made, not only 'can do'."
          },

    {
      "type": "grammar",
      "id": "l03_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l03_g01",
          "pattern": "ここ / そこ / あそこ",
          "title": {
            "zh": "这里 / 那里 / 那边",
            "en": "here / there / over there"
          },
          "explanation": {
            "zh": "表示地点的指示词：近说话人用「ここ」，近听话人用「そこ」，离双方都远用「あそこ」。",
            "en": "Place demonstratives: 「ここ」 near speaker, 「そこ」 near listener, 「あそこ」 far from both."
          },
          "examples": [
            {
              "jp": "ここは 教室です。",
              "zh": "这里是教室。",
              "en": "This is the classroom."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "离双方都远的地点用？",
                "en": "Which refers to a place far from both?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ここ"
                  }
                },
                {
                  "text": {
                    "jp": "そこ"
                  }
                },
                {
                  "text": {
                    "jp": "あそこ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "どこ"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "靠近听话人的地点用？",
                "en": "Which refers to a place near the listener?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ここ"
                  }
                },
                {
                  "text": {
                    "jp": "そこ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "あそこ"
                  }
                },
                {
                  "text": {
                    "jp": "どちら"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l03_g02",
          "pattern": "～は どこですか",
          "title": {
            "zh": "～在哪里？",
            "en": "Where is ~?"
          },
          "explanation": {
            "zh": "询问地点时，用「名词は どこですか」。",
            "en": "Use 「Noun は どこですか」 to ask location."
          },
          "examples": [
            {
              "jp": "トイレは どこですか。",
              "zh": "洗手间在哪里？",
              "en": "Where is the toilet?"
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“食堂在哪里？”怎么说？",
                "en": "How do you say “Where is the cafeteria?”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "食堂は どこですか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "食堂は どちらです。"
                  }
                },
                {
                  "text": {
                    "jp": "食堂は ここですか。"
                  }
                },
                {
                  "text": {
                    "jp": "食堂 どこですか。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "询问地点时关键疑问词是？",
                "en": "Which question word asks place?"
              },
              "options": [
                {
                  "text": {
                    "jp": "だれ"
                  }
                },
                {
                  "text": {
                    "jp": "どこ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "なに"
                  }
                },
                {

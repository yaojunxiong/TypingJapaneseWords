          "id": "l10_v01",
          "jp": "あります",
          "kana": "あります",
          "zh": "有（物）",
          "en": "there is/are (things)",
          "tags": [
            "verb"
          ],
          "practice": [
            {
              "id": "l10_v01_p01",
              "skill": "vocab",
              "question": {
                "zh": "「あります」的词汇意思是？",
                "en": "What does あります mean?"
              },
              "options": [
                {
                  "text": {
                    "zh": "有（物）",
                    "en": "there is/are (things)"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "zh": "有（人/动物）",
                    "en": "there is/are (people/animals)"
                  }
                },
                {
                  "text": {
                    "zh": "上面",
                    "en": "on/above"
                  }
                },
                {
                  "text": {
                    "zh": "下面",
                    "en": "under"
                  }
                }
              ],
              "explanation": {
                "zh": "「あります」= 有（物）。",
                "en": "あります means there is/are (things)."

    {
      "type": "grammar",
      "id": "l10_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l10_g01",
          "pattern": "場所に 物/人が あります・います",
          "title": {
            "zh": "某处有某物/某人",
            "en": "There is ~ at ~"
          },
          "explanation": {
            "zh": "物品用「あります」，人和动物用「います」。",
            "en": "Use 「あります」 for things, 「います」 for people/animals."
          },
          "examples": [
            {
              "jp": "つくえの 上に 本が あります。",
              "zh": "桌子上有书。",
              "en": "There is a book on the desk."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“椅子下面有猫”是？",
                "en": "How to say “There is a cat under the chair”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "いすの したに ねこが います。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "いすの したに ねこが あります。"
                  }
                },
                {
                  "text": {
                    "jp": "いすの したで ねこが います。"
                  }
                },
                {
                  "text": {
                    "jp": "いすの したを ねこが います。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“书在桌上”应使用？",
                "en": "For books on desk, which verb?"
              },
              "options": [
                {
                  "text": {
                    "jp": "あります"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "います"
                  }
                },
                {
                  "text": {
                    "jp": "です"
                  }
                },
                {
                  "text": {
                    "jp": "します"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l10_g02",
          "pattern": "N1は N2に あります・います",
          "title": {
            "zh": "N1在N2",
            "en": "N1 is in/at N2"
          },
          "explanation": {
            "zh": "已知话题做主语时常用「N1は N2に あります/います」。",
            "en": "Use topic pattern 「N1 は N2 に あります/います」 for known subjects."
          },
          "examples": [
            {
              "jp": "トイレは あそこに あります。",
              "zh": "洗手间在那边。",
              "en": "The toilet is over there."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“老师在教室里”是？",
                "en": "How to say “The teacher is in the classroom”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生は 教室に います。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生は 教室に あります。"
                  }
                },
                {
                  "text": {
                    "jp": "先生が 教室を います。"
                  }
                },
                {
                  "text": {
                    "jp": "先生は 教室で あります。"
                  }
                }
              ]
            },
            {
              "question": {

    {
      "id": "l43-grammar",
      "type": "grammar",
      "title": {
        "zh": "语法 Grammar",
        "en": "Grammar"
      },
      "items": [
        {
          "id": "l43-grammar-01",
          "pattern": "Vます形語幹 + そうです",
          "zh": "表示看起来马上要发生某动作。",
          "en": "Shows that an action looks likely to happen soon.",
          "example": "雨が降りそうです。",
          "practice": [
            {
              "id": "l43-practice-01",
              "skill": "grammar",
              "question": {
                "zh": "表达：书快要掉下来了。",
                "en": "Say: The book looks like it is going to fall."
              },
              "options": [
                {
                  "text": {
                    "jp": "本が落ちそうです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "このレストランはよさそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このかばんは重そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このかばんは丈夫そうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示看起来马上要发生某动作。",
                "en": "Shows that an action looks likely to happen soon."
              }
            }
          ]
        },
        {
          "id": "l43-grammar-02",
          "pattern": "い形容詞語幹 + そうです",
          "zh": "根据外观看起来具有某性质，去掉 い 后接 そうです。",
          "en": "For i-adjectives, remove い and add そうです to describe appearance.",
          "example": "このケーキはおいしそうです。",
          "practice": [
            {
              "id": "l43-practice-02",
              "skill": "grammar",
              "question": {
                "zh": "表达：这个包看起来很重。",
                "en": "Say: This bag looks heavy."
              },
              "options": [
                {
                  "text": {
                    "jp": "このかばんは丈夫そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このかばんは重そうです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "このレストランはよさそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "本が落ちそうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "根据外观看起来具有某性质，去掉 い 后接 そうです。",
                "en": "For i-adjectives, remove い and add そうです to describe appearance."
              }
            }
          ]
        },
        {
          "id": "l43-grammar-03",
          "pattern": "な形容詞 + そうです",
          "zh": "な形容词直接接 そうです，表示看起来如此。",
          "en": "Attach そうです directly to a na-adjective to describe appearance.",
          "example": "この道具は便利そうです。",
          "practice": [
            {
              "id": "l43-practice-03",
              "skill": "grammar",
              "question": {
                "zh": "表达：这个包看起来很结实。",
                "en": "Say: This bag looks sturdy."
              },
              "options": [
                {
                  "text": {
                    "jp": "このかばんは重そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このレストランはよさそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このかばんは丈夫そうです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "本が落ちそうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "な形容词直接接 そうです，表示看起来如此。",
                "en": "Attach そうです directly to a na-adjective to describe appearance."
              }
            }
          ]
        },
        {
          "id": "l43-grammar-04",
          "pattern": "よさそうです / なさそうです",
          "zh": "いい 和 ない 的外观表达是不规则形式。",
          "en": "いい and ない have irregular-looking forms with そうです.",
          "example": "このホテルはよさそうです。時間がなさそうです。",
          "practice": [
            {
              "id": "l43-practice-04",
              "skill": "grammar",
              "question": {
                "zh": "表达：这家餐厅看起来不错。",
                "en": "Say: This restaurant looks good."
              },
              "options": [
                {
                  "text": {
                    "jp": "本が落ちそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このかばんは重そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このレストランはよさそうです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "このかばんは丈夫そうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "いい 和 ない 的外观表达是不规则形式。",
                "en": "いい and ない have irregular-looking forms with そうです."
              }
            }
          ]
        },
        {
          "id": "l43-grammar-05",
          "pattern": "Vそうにありません",
          "zh": "表示看起来不会发生某动作。",
          "en": "Shows that an action does not look likely to happen.",
          "example": "今日は雨が降りそうにありません。",
          "practice": [
            {
              "id": "l43-practice-05",
              "skill": "grammar",
              "question": {
                "zh": "表达：电车看起来不会来。",
                "en": "Say: The train does not look likely to come."
              },
              "options": [
                {
                  "text": {
                    "jp": "このかばんは重そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "本が落ちそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このかばんは丈夫そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "電車は来そうにありません。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "表示看起来不会发生某动作。",
                "en": "Shows that an action does not look likely to happen."
              }
            }
          ]
        },
        {
          "id": "l43-grammar-06",
          "pattern": "い形容詞くなさそうです",
          "zh": "い形容词的否定外观用 くなさそうです。",
          "en": "Use くなさそうです for negative appearance of i-adjectives.",
          "example": "この問題は難しくなさそうです。",
          "practice": [
            {
              "id": "l43-practice-06",
              "skill": "grammar",
              "question": {
                "zh": "表达：这道菜看起来不辣。",
                "en": "Say: This dish does not look spicy."
              },
              "options": [
                {
                  "text": {
                    "jp": "このかばんは丈夫そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このかばんは重そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "本が落ちそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "この料理は辛くなさそうです。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "い形容词的否定外观用 くなさそうです。",
                "en": "Use くなさそうです for negative appearance of i-adjectives."
              }
            }
          ]
        },
        {
          "id": "l43-grammar-07",
          "pattern": "な形容詞ではなさそうです",
          "zh": "な形容词的否定外观常用 ではなさそうです。",
          "en": "Use ではなさそうです for negative appearance of na-adjectives.",
          "example": "この部屋は静かではなさそうです。",
          "practice": [
            {
              "id": "l43-practice-07",
              "skill": "grammar",
              "question": {
                "zh": "表达：这个方法看起来不方便。",
                "en": "Say: This method does not look convenient."
              },
              "options": [
                {
                  "text": {
                    "jp": "このかばんは重そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "本が落ちそうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このかばんは丈夫そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "この方法は便利ではなさそうです。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "な形容词的否定外观常用 ではなさそうです。",
                "en": "Use ではなさそうです for negative appearance of na-adjectives."
              }
            }
          ]
        },
        {
          "id": "l43-grammar-08",
          "pattern": "Vてきます",
          "zh": "表示去做某事然后回来，常用于短暂离开。",
          "en": "Means go do something and come back, often for a brief departure.",
          "example": "ちょっと飲み物を買ってきます。",
          "practice": [
            {
              "id": "l43-practice-08",
              "skill": "grammar",
              "question": {
                "zh": "表达：我去买点饮料就回来。",
                "en": "Say: I will go buy drinks and come back."
              },
              "options": [
                {
                  "text": {
                    "jp": "飲み物を買ってきます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "このかばんは丈夫そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "このかばんは重そうです。"
                  }
                },
                {
                  "text": {
                    "jp": "本が落ちそうです。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示去做某事然后回来，常用于短暂离开。",
                "en": "Means go do something and come back, often for a brief departure."
              }
            }
          ]
        }
      ]
    },
    {
      "id": "l43-examples",
      "type": "examples",
      "title": {
        "zh": "例句 Examples",
        "en": "Examples"
      },
      "items": [
        {
          "id": "l43-example-01",
          "jp": "空が暗くなりました。雨が降りそうです。",
          "zh": "天空变暗了，看起来要下雨。",
          "en": "The sky has become dark. It looks like it will rain.",

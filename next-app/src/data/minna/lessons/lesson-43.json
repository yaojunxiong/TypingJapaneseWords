      "items": [
        {
          "id": "l43-mistake-01",
          "wrong": "このケーキはおいしいそうです。",
          "correct": "このケーキはおいしそうです。",
          "reason": {
            "zh": "い形容词接外观 そうです 时去掉 い。",
            "en": "Remove い before appearance そうです."
          }
        },
        {
          "id": "l43-mistake-02",
          "wrong": "このレストランはいいそうです。",
          "correct": "このレストランはよさそうです。",
          "reason": {
            "zh": "いい 的外观表达是不规则的 よさそうです。",
            "en": "いい becomes よさそうです in appearance expressions."
          }
        },
        {
          "id": "l43-mistake-03",
          "wrong": "飲み物を買っていきます。",
          "correct": "飲み物を買ってきます。",
          "reason": {
            "zh": "去买了再回来，用 てきます。",
            "en": "Use てきます when going to do something and returning."
          }
        }
      ]
    },

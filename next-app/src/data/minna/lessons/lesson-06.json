    {
      "type": "grammar",
      "id": "l06_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l06_g01",
          "pattern": "名词を 動词",
          "title": {
            "zh": "宾语 + 动词",
            "en": "Object + verb"
          },
          "explanation": {
            "zh": "动作对象后用「を」。",
            "en": "Use 「を」 after the object of an action."
          },
          "examples": [
            {
              "jp": "映画を 見ます。",
              "zh": "看电影。",
              "en": "I watch a movie."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“喝水”是？",
                "en": "How to say “drink water”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "水を 飲みます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "水で 飲みます。"
                  }
                },
                {
                  "text": {
                    "jp": "水が 飲みます。"
                  }
                },
                {
                  "text": {
                    "jp": "水に 飲みます。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "宾语后应接？",
                "en": "Which particle marks object?"
              },
              "options": [
                {
                  "text": {
                    "jp": "を"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "で"
                  }
                },
                {
                  "text": {
                    "jp": "に"
                  }
                },
                {
                  "text": {
                    "jp": "と"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l06_g02",
          "pattern": "何を 〜ますか",
          "title": {
            "zh": "问做什么",
            "en": "What do you do?"
          },
          "explanation": {
            "zh": "询问动作对象用「何を〜ますか」。",
            "en": "Use 「何を〜ますか」 to ask action object."
          },
          "examples": [
            {
              "jp": "何を 食べますか。",
              "zh": "吃什么？",
              "en": "What will you eat?"
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“你看什么？”是？",
                "en": "How to ask “What do you watch?”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "何を 見ますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "何が 見ますか。"
                  }
                },
                {
                  "text": {
                    "jp": "何で 見ますか。"

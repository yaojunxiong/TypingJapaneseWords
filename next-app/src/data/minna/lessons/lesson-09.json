    {
      "type": "grammar",
      "id": "l09_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l09_g01",
          "pattern": "名词が 好きです / 嫌いです",
          "title": {
            "zh": "喜欢/不喜欢",
            "en": "Like / dislike"
          },
          "explanation": {
            "zh": "表达喜好时常用「名词が 好き/嫌いです」。",
            "en": "Use 「N が 好き/嫌いです」 to express likes/dislikes."
          },
          "examples": [
            {
              "jp": "わたしは 音楽が 好きです。",
              "zh": "我喜欢音乐。",
              "en": "I like music."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“我喜欢足球”是？",
                "en": "How to say “I like soccer”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "わたしは サッカーが 好きです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "わたしは サッカーを 好きです。"
                  }
                },
                {
                  "text": {
                    "jp": "わたしは サッカーに 好きです。"
                  }
                },
                {
                  "text": {
                    "jp": "わたしは サッカーで 好きです。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“不喜欢料理”是？",
                "en": "How to say “dislike cooking”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "りょうりが 嫌いです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "りょうりが 下手です。"
                  }
                },
                {
                  "text": {
                    "jp": "りょうりが 好きです。"
                  }
                },
                {
                  "text": {
                    "jp": "りょうりを 嫌いです。"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l09_g02",
          "pattern": "名词が 上手です / 下手です",
          "title": {
            "zh": "擅长/不擅长",
            "en": "Good/poor at"
          },
          "explanation": {
            "zh": "表达技能能力常用「名词が 上手/下手です」。",
            "en": "Use 「N が 上手/下手です」 for skill levels."
          },
          "examples": [
            {
              "jp": "田中さんは 日本語が 上手です。",
              "zh": "田中先生日语很棒。",
              "en": "Mr. Tanaka is good at Japanese."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“我不擅长唱歌”是？",
                "en": "How to say “I am poor at singing”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "わたしは うたが 下手です。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "わたしは うたが 嫌いです。"
                  }
                },
                {
                  "text": {
                    "jp": "わたしは うたを 下手です。"
                  }
                },
                {
                  "text": {
                    "jp": "わたしは うたに 下手です。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“她擅长料理”是？",
                "en": "How to say “She is good at cooking”?"

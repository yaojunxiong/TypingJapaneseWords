          "id": "l04_e04",
          "jp": "毎日 六時に 起きます。",
          "zh": "我每天六点起床。",
          "en": "I wake up at six every day."
        },
        {
          "id": "l04_e05",
          "jp": "きのう 十一時に 寝ました。",
          "zh": "我昨天11点睡。",
          "en": "I went to bed at 11 yesterday."
        }
      ]
    },

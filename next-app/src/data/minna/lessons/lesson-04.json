    {
      "type": "grammar",
      "id": "l04_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l04_g01",
          "pattern": "今 〜時 〜分です",
          "title": {
            "zh": "现在几点",
            "en": "Telling the time"
          },
          "explanation": {
            "zh": "使用「今〜時〜分です」表达具体时间，30分常说「半」。",
            "en": "Use 「今〜時〜分です」 for clock time. 30 minutes is often 「半」."
          },
          "examples": [
            {
              "jp": "今 八時半です。",
              "zh": "现在八点半。",
              "en": "It is 8:30 now."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“八点半”应说？",
                "en": "How do you say 8:30?"
              },
              "options": [
                {
                  "text": {
                    "jp": "八時半です。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "八時三十分ですか。"
                  }
                },
                {
                  "text": {
                    "jp": "八時です。"
                  }
                },
                {
                  "text": {
                    "jp": "半八時です。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“三点十五分”应说？",
                "en": "How do you say 3:15?"
              },
              "options": [
                {
                  "text": {
                    "jp": "三時十五分です。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "三分十五時です。"
                  }
                },
                {
                  "text": {
                    "jp": "十五時三分です。"
                  }
                },
                {
                  "text": {
                    "jp": "三時半です。"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l04_g02",
          "pattern": "〜から 〜まで",
          "title": {
            "zh": "从〜到〜",
            "en": "From ~ to ~"
          },
          "explanation": {
            "zh": "表示时间范围，起点用「から」，终点用「まで」。",
            "en": "Use 「から」 for the starting point and 「まで」 for the ending point."
          },
          "examples": [
            {
              "jp": "学校は 九時から 五時までです。",
              "zh": "学校是9点到5点。",
              "en": "School is from 9 to 5."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“9点到5点”正确是？",
                "en": "Which means “from 9 to 5”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "九時から五時まで"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "九時まで五時から"
                  }
                },
                {
                  "text": {
                    "jp": "九時に五時まで"
                  }
                },
                {
                  "text": {
                    "jp": "九時で五時まで"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "范围句式是？",
                "en": "Which pattern expresses a range?"
              },
              "options": [
                {
                  "text": {
                    "jp": "AからBまで"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "AでBを"
                  }
                },
                {
                  "text": {
                    "jp": "AはBが"
                  }
                },
                {
                  "text": {
                    "jp": "AとBで"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l04_g03",
          "pattern": "〜曜日 / 何曜日",
          "title": {
            "zh": "星期表达",
            "en": "Weekday expressions"
          },
          "explanation": {
            "zh": "问星期用「何曜日ですか」。回答可用「〜曜日です」。",
            "en": "Ask weekdays with 「何曜日ですか」 and answer with 「〜曜日です」."
          },
          "examples": [
            {
              "jp": "休みは 何曜日ですか。日曜日です。",
              "zh": "休息日是星期几？星期日。",
              "en": "What day is your day off? Sunday."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "问“星期几”用？",
                "en": "How do you ask “what weekday”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "何曜日ですか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "何時ですか。"
                  }
                },
                {
                  "text": {
                    "jp": "何分ですか。"
                  }
                },
                {
                  "text": {
                    "jp": "どこですか。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“星期三”是？",
                "en": "Which is Wednesday?"
              },
              "options": [
                {
                  "text": {
                    "jp": "水曜日"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "木曜日"
                  }
                },
                {
                  "text": {
                    "jp": "金曜日"
                  }
                },
                {
                  "text": {
                    "jp": "火曜日"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l04_g04",
          "pattern": "ます形过去：〜ました / 〜ませんでした",
          "title": {
            "zh": "礼貌体过去与过去否定",
            "en": "Polite past and past negative"
          },
          "explanation": {
            "zh": "动词ます形过去用「〜ました」，过去否定用「〜ませんでした」。",
            "en": "Polite past is 「〜ました」 and past negative is 「〜ませんでした」."
          },
          "examples": [
            {
              "jp": "きのう 六時に 起きました。",
              "zh": "昨天六点起床了。",
              "en": "I woke up at six yesterday."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“昨天学习了”应说？",
                "en": "How to say “studied yesterday”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "きのう 勉強しました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "きのう 勉強します。"
                  }
                },
                {
                  "text": {
                    "jp": "きのう 勉強しません。"
                  }
                },
                {
                  "text": {
                    "jp": "きのう 勉強しませんでしたか。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“昨天没睡”应说？",
                "en": "How to say “did not sleep yesterday”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "きのう 寝ませんでした。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "きのう 寝ました。"
                  }
                },
                {
                  "text": {
                    "jp": "きのう 寝ません。"
                  }
                },
                {
                  "text": {
                    "jp": "きのう 寝ます。"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "examples",
      "id": "l04_examples",
      "title": {
        "zh": "核心例句",
        "en": "Core Examples",
        "ja": "基本例文"
      },
      "items": [

                },
                {
                  "text": {
                    "jp": "会いたいけど、今日はじゃない。"
                  }
                }
              ],
              "explanation": {
                "zh": "在口语中连接转折。",
                "en": "Connect contrast in casual speech."
              }
            }
          ]
        },
        {
          "id": "l20_g04",

              "explanation": {
                "zh": "朋友间常用的邀请方式。",
                "en": "A casual way to invite someone."
              }
            },
            {
              "id": "l20_g04_p02",
              "skill": "grammar",
              "question": {
                "zh": "“周末打球吗？”口语是？",

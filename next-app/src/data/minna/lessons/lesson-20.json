                {
                  "text": {
                    "jp": "おいしいけどで高い。"
                  }
                }
              ],
              "explanation": {
                "zh": "在口语中连接转折。",
                "en": "Connect contrast in casual speech."
              }
            },
            {
              "id": "l20_g03_p02",
              "skill": "grammar",
              "question": {
                "zh": "“想见你但今天不行”是？",

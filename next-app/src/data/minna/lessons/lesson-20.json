        {
          "id": "l20_g02",
          "pattern": "普通形（い形容词／な形容词／名词）",
          "title": {
            "zh": "形容词与名词普通形",
            "en": "Plain adjective/noun forms"
          },
          "explanation": {
            "zh": "掌握だ、じゃない、だった、じゃなかった。",
            "en": "Use da/janai/datta/janakatta with nouns and na-adjectives."
          },
          "examples": [
            {
              "jp": "この本、面白い。",
              "zh": "这本书很有趣。",
              "en": "This book is interesting."
            }
          ],
          "practice": [
            {
              "id": "l20_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“很安静”普通形是？",
                "en": "Plain form of \"It is quiet\"?"
              },
              "options": [
                {
                  "text": {
                    "jp": "静かだ。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "静かです。"
                  }
                },
                {
                  "text": {
                    "jp": "静かじゃない。"
                  }
                },
                {
                  "text": {
                    "jp": "静かだった。"
                  }
                }

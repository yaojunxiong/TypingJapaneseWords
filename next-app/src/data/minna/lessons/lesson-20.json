      },
      "items": [
        {
          "id": "l20_g01",
          "pattern": "普通形（动词）",
          "title": {
            "zh": "动词普通形",
            "en": "Plain verb forms"
          },
          "explanation": {
            "zh": "用于朋友间自然会话。",
            "en": "Used in natural casual speech with friends."
          },
          "examples": [
            {
              "jp": "あした映画を見る？",
              "zh": "明天看电影吗？",
              "en": "Will you watch a movie tomorrow?"
            }
          ],
          "practice": [
            {
              "id": "l20_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“不去”普通形是？",
                "en": "What is plain negative of iku?"
              },
              "options": [
                {
                  "text": {
                    "jp": "行かない"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "行きません"
                  }
                },
                {
                  "text": {
                    "jp": "行かないです"
                  }
                },
                {
                  "text": {
                    "jp": "行きない"
                  }
                }
              ],
              "explanation": {
                "zh": "用于朋友间自然会话。",
                "en": "Used in natural casual speech with friends."
              }
            },
            {
              "id": "l20_g01_p02",
              "skill": "grammar",
              "question": {

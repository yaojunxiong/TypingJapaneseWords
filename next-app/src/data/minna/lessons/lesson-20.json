          "id": "l20_q01",
          "question": {
            "zh": "「普通形」的意思是？",
            "en": "What does 普通形 mean?"
          },
          "options": [
            {
              "text": {
                "zh": "普通体",
                "en": "plain form"
              },
              "correct": true
            },
            {
              "text": {
                "zh": "需要",
                "en": "need"
              }
            },
            {
              "text": {
                "zh": "调查；查找",
                "en": "check/investigate"
              }
            },
            {
              "text": {
                "zh": "不同",
                "en": "be different"
              }
            }
          ],
          "explanation": {
            "zh": "「普通形」表示「普通体」。",
            "en": "普通形 means plain form."
          }

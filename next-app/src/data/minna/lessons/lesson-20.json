            "en": "A casual way to invite someone."
          },
          "examples": [
            {
              "jp": "いっしょに行かない？",
              "zh": "一起去吗？",
              "en": "Wanna go together?"
            }
          ],
          "practice": [
            {
              "id": "l20_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“一起吃饭吗？”口语是？",
                "en": "Casual: Shall we eat together?"
              },
              "options": [
                {
                  "text": {
                    "jp": "いっしょに食べない？"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "いっしょに食べませんか。"

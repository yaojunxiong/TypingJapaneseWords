      "items": [
        {
          "id": "l20_g01",
          "pattern": "普通形（动词）",
          "title": {
            "zh": "动词普通形",
            "en": "Plain verb forms"
          },
          "explanation": {
            "zh": "用于朋友间自然会话。",
            "en": "Used in natural casual speech with friends."
          },
          "examples": [
            {
              "jp": "あした映画を見る？",
              "zh": "明天看电影吗？",
              "en": "Will you watch a movie tomorrow?"
            }
          ],
          "practice": [
            {
              "id": "l20_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“不去”普通形是？",
                "en": "What is plain negative of iku?"
              },
              "options": [
                {
                  "text": {
                    "jp": "行かない"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "行きません"
                  }
                },
                {
                  "text": {
                    "jp": "行かないです"
                  }
                },
                {
                  "text": {
                    "jp": "行きない"
                  }
                }
              ],
              "explanation": {
                "zh": "用于朋友间自然会话。",
                "en": "Used in natural casual speech with friends."
              }
            },
            {
              "id": "l20_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“看了”普通过去形是？",
                "en": "Plain past of miru is?"
              },
              "options": [
                {
                  "text": {
                    "jp": "見た"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "見ました"
                  }
                },
                {
                  "text": {
                    "jp": "見るた"
                  }
                },
                {
                  "text": {
                    "jp": "見ないた"
                  }
                }
              ],
              "explanation": {
                "zh": "用于朋友间自然会话。",
                "en": "Used in natural casual speech with friends."
              }
            }
          ]
        },
        {
          "id": "l20_g02",
          "pattern": "普通形（い形容词／な形容词／名词）",
          "title": {
            "zh": "形容词与名词普通形",
            "en": "Plain adjective/noun forms"
          },
          "explanation": {
            "zh": "掌握だ、じゃない、だった、じゃなかった。",
            "en": "Use da/janai/datta/janakatta with nouns and na-adjectives."
          },
          "examples": [
            {
              "jp": "この本、面白い。",
              "zh": "这本书很有趣。",
              "en": "This book is interesting."
            }
          ],
          "practice": [
            {
              "id": "l20_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“很安静”普通形是？",
                "en": "Plain form of \"It is quiet\"?"
              },
              "options": [
                {
                  "text": {
                    "jp": "静かだ。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "静かです。"
                  }
                },
                {
                  "text": {
                    "jp": "静かじゃない。"
                  }
                },
                {
                  "text": {
                    "jp": "静かだった。"
                  }
                }
              ],
              "explanation": {
                "zh": "掌握だ、じゃない、だった、じゃなかった。",
                "en": "Use da/janai/datta/janakatta with nouns and na-adjectives."
              }
            },
            {
              "id": "l20_g02_p02",
              "skill": "grammar",
              "question": {
                "zh": "“不是学生”普通形是？",
                "en": "Plain negative of \"is a student\"?"
              },
              "options": [
                {
                  "text": {
                    "jp": "学生じゃない。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "学生ではありません。"
                  }
                },
                {
                  "text": {
                    "jp": "学生だった。"
                  }
                },
                {
                  "text": {
                    "jp": "学生です。"
                  }
                }
              ],
              "explanation": {
                "zh": "掌握だ、じゃない、だった、じゃなかった。",
                "en": "Use da/janai/datta/janakatta with nouns and na-adjectives."
              }
            }
          ]
        },
        {
          "id": "l20_g03",
          "pattern": "普通形 + けど",
          "title": {
            "zh": "转折连接",
            "en": "Contrast with kedo"
          },
          "explanation": {
            "zh": "在口语中连接转折。",
            "en": "Connect contrast in casual speech."
          },
          "examples": [
            {
              "jp": "行きたいけど、時間がない。",
              "zh": "想去，但没时间。",
              "en": "I want to go, but I have no time."
            }
          ],
          "practice": [
            {
              "id": "l20_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“好吃但是贵”是？",
                "en": "How to say: tasty but expensive?"
              },
              "options": [
                {
                  "text": {
                    "jp": "おいしいけど、高い。"
                  },

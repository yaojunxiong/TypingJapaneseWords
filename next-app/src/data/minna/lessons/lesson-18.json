    {
      "type": "grammar",
      "id": "l18_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l18_g01",
          "pattern": "V辞書形 ことができます",
          "title": {
            "zh": "能力表达",
            "en": "Can do~"
          },
          "explanation": {
            "zh": "表示会做某事。",
            "en": "Expresses one's ability."
          },
          "examples": [
            {
              "jp": "私はギターを弾くことができます。",
              "zh": "我会弹吉他。",
              "en": "I can play the guitar."
            }
          ],
          "practice": [
            {
              "id": "l18_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我会开车”是？",
                "en": "How to say: I can drive?"
              },
              "options": [
                {
                  "text": {
                    "jp": "私は車を運転することができます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "私は車を運転してことができます。"
                  }
                },
                {
                  "text": {
                    "jp": "私は車を運転しますことができます。"
                  }
                },
                {
                  "text": {
                    "jp": "私は車が運転ことができます。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示会做某事。",
                "en": "Expresses one's ability."
              }
            },
            {
              "id": "l18_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“你会做日本菜吗”是？",
                "en": "How to ask: Can you cook Japanese food?"
              },
              "options": [
                {
                  "text": {
                    "jp": "日本料理を作ることができますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "日本料理を作ってことができますか。"
                  }
                },
                {
                  "text": {
                    "jp": "日本料理を作りますことができますか。"
                  }
                },
                {
                  "text": {
                    "jp": "日本料理が作ることですか。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示会做某事。",
                "en": "Expresses one's ability."
              }
            }
          ]
        },
        {
          "id": "l18_g02",
          "pattern": "趣味は V辞書形 ことです",
          "title": {
            "zh": "爱好表达",
            "en": "Stating a hobby"
          },
          "explanation": {
            "zh": "用「ことです」把动词名词化。",
            "en": "Nominalize verbs with koto for hobbies."
          },
          "examples": [
            {
              "jp": "私の趣味は写真を撮ることです。",
              "zh": "我的爱好是拍照。",
              "en": "My hobby is taking photos."
            }
          ],
          "practice": [
            {
              "id": "l18_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我的爱好是听音乐”是？",
                "en": "How to say: My hobby is listening to music?"
              },

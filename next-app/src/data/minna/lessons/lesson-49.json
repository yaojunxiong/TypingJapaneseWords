    {
      "id": "l49-mistakes",
      "type": "mistakes",
      "title": {
        "zh": "常见错误 Common Mistakes",
        "en": "Common Mistakes"
      },
      "items": [
        {
          "id": "l49-mistake-01",
          "wrong": "私は明日いらっしゃいます。",
          "correct": "私は明日参ります。",
          "reason": {
            "zh": "尊敬语不能用来抬高自己；自己去/来用谦让语 参ります。",
            "en": "Do not use honorifics to elevate yourself; use humble 参ります for your own go/come."
          }
        },
        {
          "id": "l49-mistake-02",
          "wrong": "先生はコーヒーを飲まれになります。",
          "correct": "先生はコーヒーを召し上がります。",
          "reason": {
            "zh": "飲む 的特殊尊敬语是 召し上がります，不混用被动和 おVになります。",
            "en": "The special honorific for drink is 召し上がります; do not mix passive and おVになります."
          }
        },
        {
          "id": "l49-mistake-03",
          "wrong": "先生は資料をお見になります。",
          "correct": "先生は資料をご覧になります。",
          "reason": {
            "zh": "見る 的特殊尊敬语是 ご覧になります。",
            "en": "The special honorific for 見る is ご覧になります."
          }
        }
      ]
    },

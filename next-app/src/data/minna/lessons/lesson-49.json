    {
      "id": "l49-grammar",
      "type": "grammar",
      "title": {
        "zh": "语法 Grammar",
        "en": "Grammar"
      },
      "items": [
        {
          "id": "l49-grammar-01",
          "pattern": "尊敬受身：Vられます",
          "zh": "用被动形表示尊敬，形式较简单，但尊敬程度中等。",
          "en": "Use the passive form as an honorific form; it is simple and moderately respectful.",
          "example": "先生はもう帰られました。",
          "practice": [
            {
              "id": "l49-practice-01",
              "skill": "grammar",
              "question": {
                "zh": "表达：老师已经回去了。",
                "en": "Say honorifically: The teacher has already gone home."
              },
              "options": [
                {
                  "text": {
                    "jp": "先生はもう帰られました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生はこの資料をお読みになります。"
                  }
                },
                {
                  "text": {
                    "jp": "このカードをご利用になりますか。"
                  }
                },
                {
                  "text": {
                    "jp": "少々お待ちください。"
                  }
                }
              ],
              "explanation": {
                "zh": "用被动形表示尊敬，形式较简单，但尊敬程度中等。",
                "en": "Use the passive form as an honorific form; it is simple and moderately respectful."
              }
            }
          ]
        },
        {
          "id": "l49-grammar-02",
          "pattern": "お + Vます形語幹 + になります",
          "zh": "尊敬语常用结构，用于对方或上级的动作。",
          "en": "Common honorific structure for actions of the other person or a superior.",
          "example": "社長は新聞をお読みになります。",
          "practice": [
            {
              "id": "l49-practice-02",
              "skill": "grammar",
              "question": {
                "zh": "表达：老师要读这份资料。",
                "en": "Say honorifically: The teacher will read this document."
              },
              "options": [
                {
                  "text": {
                    "jp": "先生はこの資料をお読みになります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "少々お待ちください。"
                  }
                },
                {
                  "text": {
                    "jp": "先生はもう帰られました。"
                  }
                },
                {
                  "text": {
                    "jp": "このカードをご利用になりますか。"
                  }
                }
              ],
              "explanation": {
                "zh": "尊敬语常用结构，用于对方或上级的动作。",
                "en": "Common honorific structure for actions of the other person or a superior."
              }
            }
          ]
        },
        {
          "id": "l49-grammar-03",
          "pattern": "ご + 漢語名詞 + になります",
          "zh": "部分汉语词可用 ご + 名词 + になります。",
          "en": "Some Sino-Japanese nouns use ご + noun + になります.",
          "example": "こちらをご利用になりますか。",
          "practice": [
            {
              "id": "l49-practice-03",
              "skill": "grammar",
              "question": {
                "zh": "表达：您使用这张卡吗？",
                "en": "Say honorifically: Will you use this card?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生はもう帰られました。"
                  }
                },
                {
                  "text": {
                    "jp": "このカードをご利用になりますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生はこの資料をお読みになります。"
                  }
                },
                {
                  "text": {
                    "jp": "少々お待ちください。"
                  }
                }
              ],
              "explanation": {
                "zh": "部分汉语词可用 ご + 名词 + になります。",
                "en": "Some Sino-Japanese nouns use ご + noun + になります."
              }
            }
          ]
        },
        {
          "id": "l49-grammar-04",
          "pattern": "お / ご + Vください",
          "zh": "礼貌地请对方做某事，常见于服务和通知。",
          "en": "Politely asks the other person to do something, often in service contexts or notices.",
          "example": "少々お待ちください。こちらをご覧ください。",
          "practice": [
            {
              "id": "l49-practice-04",
              "skill": "grammar",
              "question": {
                "zh": "表达：请稍等。",
                "en": "Say politely: Please wait a moment."
              },
              "options": [
                {
                  "text": {
                    "jp": "このカードをご利用になりますか。"
                  }
                },
                {
                  "text": {
                    "jp": "先生はもう帰られました。"
                  }
                },
                {
                  "text": {
                    "jp": "先生はこの資料をお読みになります。"
                  }
                },
                {
                  "text": {
                    "jp": "少々お待ちください。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "礼貌地请对方做某事，常见于服务和通知。",
                "en": "Politely asks the other person to do something, often in service contexts or notices."
              }
            }
          ]
        },
        {
          "id": "l49-grammar-05",
          "pattern": "いらっしゃいます",
          "zh": "行きます、来ます、います 的特殊尊敬语。",
          "en": "Special honorific form for 行きます, 来ます, and います.",
          "example": "先生は会議室にいらっしゃいます。",
          "practice": [
            {
              "id": "l49-practice-05",
              "skill": "grammar",
              "question": {
                "zh": "表达：老师在会议室。",
                "en": "Say honorifically: The teacher is in the meeting room."
              },
              "options": [
                {
                  "text": {
                    "jp": "このカードをご利用になりますか。"
                  }
                },
                {
                  "text": {
                    "jp": "先生は会議室にいらっしゃいます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生はこの資料をお読みになります。"
                  }
                },
                {
                  "text": {
                    "jp": "先生はもう帰られました。"
                  }
                }
              ],
              "explanation": {
                "zh": "行きます、来ます、います 的特殊尊敬语。",
                "en": "Special honorific form for 行きます, 来ます, and います."
              }
            }
          ]
        },
        {
          "id": "l49-grammar-06",
          "pattern": "召し上がります / ご覧になります",
          "zh": "食べます/飲みます 用 召し上がります；見ます 用 ご覧になります。",
          "en": "Use 召し上がります for eat/drink and ご覧になります for see/watch.",
          "example": "先生はコーヒーを召し上がりました。資料をご覧になりました。",
          "practice": [
            {
              "id": "l49-practice-06",
              "skill": "grammar",
              "question": {
                "zh": "表达：社长看了资料。",
                "en": "Say honorifically: The president looked at the document."
              },
              "options": [
                {
                  "text": {
                    "jp": "先生はこの資料をお読みになります。"
                  }
                },
                {
                  "text": {
                    "jp": "先生はもう帰られました。"
                  }
                },
                {
                  "text": {
                    "jp": "社長は資料をご覧になりました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "このカードをご利用になりますか。"
                  }
                }
              ],
              "explanation": {
                "zh": "食べます/飲みます 用 召し上がります；見ます 用 ご覧になります。",
                "en": "Use 召し上がります for eat/drink and ご覧になります for see/watch."
              }
            }
          ]
        },
        {
          "id": "l49-grammar-07",
          "pattern": "おっしゃいます / なさいます",
          "zh": "言います 用 おっしゃいます；します 用 なさいます。",
          "en": "Use おっしゃいます for say and なさいます for do.",
          "example": "先生は何とおっしゃいましたか。週末は何をなさいますか。",
          "practice": [
            {
              "id": "l49-practice-07",
              "skill": "grammar",
              "question": {
                "zh": "表达：老师说了什么？",
                "en": "Say honorifically: What did the teacher say?"
              },
              "options": [

        {
          "id": "l49-quiz-01",
          "question": {
            "zh": "「老师已经回去了。」尊敬表达是？",
            "en": "Which is honorific: The teacher has already gone home?"
          },
          "options": [
            {
              "text": "先生はもう帰られました。",
              "correct": true
            },
            {
              "text": "先生はもう帰らせました。",
              "correct": false
            },
            {
              "text": "先生はもう参りました。",
              "correct": false
            },
            {
              "text": "何を食べいたしますか。"
            }
          ],
          "explanation": {
            "zh": "尊敬被动用 帰られました；参りました 是自己动作的谦让语。",
            "en": "Use honorific passive 帰られました; 参りました is humble for your own action."
          }
        },
        {
          "id": "l49-quiz-02",

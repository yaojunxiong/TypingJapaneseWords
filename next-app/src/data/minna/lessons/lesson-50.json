    {
      "id": "l50-mistakes",
      "type": "mistakes",
      "title": {
        "zh": "常见错误 Common Mistakes",
        "en": "Common Mistakes"
      },
      "items": [
        {
          "id": "l50-mistake-01",
          "wrong": "先生の資料をご覧しました。",
          "correct": "先生の資料を拝見しました。",
          "reason": {
            "zh": "自己看对方资料用谦让语 拝見します；ご覧になります 是对方看的尊敬语。",
            "en": "Use humble 拝見します for your own seeing; ご覧になります is honorific for the other person's seeing."
          }
        },
        {
          "id": "l50-mistake-02",
          "wrong": "私は明日いらっしゃいます。",
          "correct": "私は明日参ります。",
          "reason": {
            "zh": "自己去/来用 参ります，不用尊敬语 いらっしゃいます。",
            "en": "Use 参ります for your own go/come, not honorific いらっしゃいます."
          }
        },
        {
          "id": "l50-mistake-03",
          "wrong": "お客様をお案内します。",
          "correct": "お客様をご案内します。",
          "reason": {
            "zh": "案内 是汉语词动作，谦让形式通常用 ご案内します。",
            "en": "案内 is a Sino-Japanese action noun, so use ご案内します."
          }
        }
      ]
    },

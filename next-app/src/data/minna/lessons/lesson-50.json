    {
      "id": "l50-grammar",
      "type": "grammar",
      "title": {
        "zh": "语法 Grammar",
        "en": "Grammar"
      },
      "items": [
        {
          "id": "l50-grammar-01",
          "pattern": "お + Vます形語幹 + します",
          "zh": "谦让语基本形式，用于降低自己一方为对方做的动作。",
          "en": "Basic humble form for actions done by your side for the other person.",
          "example": "荷物をお持ちします。",
          "practice": [
            {
              "id": "l50-practice-01",
              "skill": "grammar",
              "question": {
                "zh": "表达：我来拿行李。",
                "en": "Say humbly: I will carry the luggage."
              },
              "options": [
                {
                  "text": {
                    "jp": "山田と申します。"
                  }
                },
                {
                  "text": {
                    "jp": "荷物をお持ちします。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "会場をご案内します。"
                  }
                },
                {
                  "text": {
                    "jp": "明日3時に参ります。"
                  }
                }
              ],
              "explanation": {
                "zh": "谦让语基本形式，用于降低自己一方为对方做的动作。",
                "en": "Basic humble form for actions done by your side for the other person."
              }
            }
          ]
        },
        {
          "id": "l50-grammar-02",
          "pattern": "ご + 漢語名詞 + します",
          "zh": "汉语词动作常用 ご + 名词 + します。",
          "en": "Many Sino-Japanese action nouns use ご + noun + します.",
          "example": "会場をご案内します。",
          "practice": [
            {
              "id": "l50-practice-02",
              "skill": "grammar",
              "question": {
                "zh": "表达：我带您去会场。",
                "en": "Say humbly: I will guide you to the venue."
              },
              "options": [
                {
                  "text": {
                    "jp": "荷物をお持ちします。"
                  }
                },
                {
                  "text": {
                    "jp": "山田と申します。"
                  }
                },
                {
                  "text": {
                    "jp": "会場をご案内します。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "明日3時に参ります。"
                  }
                }
              ],
              "explanation": {
                "zh": "汉语词动作常用 ご + 名词 + します。",
                "en": "Many Sino-Japanese action nouns use ご + noun + します."
              }
            }
          ]
        },
        {
          "id": "l50-grammar-03",
          "pattern": "参ります / おります",
          "zh": "自己一方的 行きます・来ます 用 参ります；います 用 おります。",
          "en": "Use 参ります for your side's go/come and おります for your side's be.",
          "example": "明日3時に参ります。私は受付におります。",
          "practice": [
            {
              "id": "l50-practice-03",
              "skill": "grammar",
              "question": {
                "zh": "表达：我明天三点去。",
                "en": "Say humbly: I will go at 3 tomorrow."
              },
              "options": [
                {
                  "text": {
                    "jp": "山田と申します。"
                  }
                },
                {
                  "text": {
                    "jp": "荷物をお持ちします。"
                  }
                },
                {
                  "text": {
                    "jp": "明日3時に参ります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "会場をご案内します。"
                  }
                }
              ],
              "explanation": {
                "zh": "自己一方的 行きます・来ます 用 参ります；います 用 おります。",
                "en": "Use 参ります for your side's go/come and おります for your side's be."
              }
            }
          ]
        },
        {
          "id": "l50-grammar-04",
          "pattern": "申します / いたします",
          "zh": "自己一方的 言います 用 申します；します 用 いたします。",
          "en": "Use 申します for your side's say/be called and いたします for do.",
          "example": "山田と申します。私が確認いたします。",
          "practice": [
            {
              "id": "l50-practice-04",
              "skill": "grammar",
              "question": {
                "zh": "表达：我叫山田。",
                "en": "Say humbly: My name is Yamada."
              },
              "options": [
                {
                  "text": {
                    "jp": "会場をご案内します。"
                  }
                },
                {
                  "text": {
                    "jp": "山田と申します。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "明日3時に参ります。"
                  }
                },
                {
                  "text": {
                    "jp": "荷物をお持ちします。"
                  }
                }
              ],
              "explanation": {
                "zh": "自己一方的 言います 用 申します；します 用 いたします。",
                "en": "Use 申します for your side's say/be called and いたします for do."
              }
            }
          ]
        },
        {
          "id": "l50-grammar-05",
          "pattern": "拝見します / 存じます",
          "zh": "自己一方的 見ます 用 拝見します；知っています/思います 可用 存じます。",
          "en": "Use 拝見します for your side's seeing and 存じます for knowing/thinking.",
          "example": "資料を拝見しました。その件は存じております。",
          "practice": [
            {
              "id": "l50-practice-05",
              "skill": "grammar",
              "question": {
                "zh": "表达：我看了资料。",
                "en": "Say humbly: I looked at the document."
              },
              "options": [
                {
                  "text": {
                    "jp": "会場をご案内します。"
                  }
                },
                {
                  "text": {
                    "jp": "明日3時に参ります。"
                  }
                },
                {
                  "text": {
                    "jp": "荷物をお持ちします。"
                  }
                },
                {
                  "text": {
                    "jp": "資料を拝見しました。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "自己一方的 見ます 用 拝見します；知っています/思います 可用 存じます。",
                "en": "Use 拝見します for your side's seeing and 存じます for knowing/thinking."
              }
            }
          ]
        },
        {
          "id": "l50-grammar-06",
          "pattern": "伺います",
          "zh": "自己一方的 行きます、聞きます、訪問します 可用 伺います。",
          "en": "Use 伺います for your side's go, ask, hear, or visit.",
          "example": "明日先生のお宅へ伺います。お名前を伺ってもよろしいですか。",
          "practice": [
            {
              "id": "l50-practice-06",
              "skill": "grammar",
              "question": {
                "zh": "表达：明天我去拜访老师家。",
                "en": "Say humbly: I will visit the teacher's home tomorrow."
              },
              "options": [
                {
                  "text": {
                    "jp": "会場をご案内します。"
                  }
                },
                {
                  "text": {
                    "jp": "荷物をお持ちします。"
                  }
                },
                {
                  "text": {
                    "jp": "明日3時に参ります。"
                  }
                },
                {
                  "text": {
                    "jp": "明日先生のお宅へ伺います。"
                  },
                  "correct": true
                }
              ],
              "explanation": {
                "zh": "自己一方的 行きます、聞きます、訪問します 可用 伺います。",
                "en": "Use 伺います for your side's go, ask, hear, or visit."
              }
            }
          ]
        },
        {
          "id": "l50-grammar-07",
          "pattern": "いただきます / ございます",
          "zh": "自己吃喝或领受用 いただきます；あります/です 的礼貌形式可用 ございます。",
          "en": "Use いただきます for receiving/eating/drinking; use ございます as a polite form of あります/です.",
          "example": "お茶をいただきます。資料はこちらにございます。",
          "practice": [
            {
              "id": "l50-practice-07",
              "skill": "grammar",
              "question": {
                "zh": "表达：资料在这里。",
                "en": "Say politely: The document is here."
              },
              "options": [
                {
                  "text": {
                    "jp": "資料はこちらにございます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "荷物をお持ちします。"
                  }
                },
                {
                  "text": {
                    "jp": "会場をご案内します。"
                  }
                },
                {
                  "text": {
                    "jp": "明日3時に参ります。"
                  }
                }
              ],
              "explanation": {
                "zh": "自己吃喝或领受用 いただきます；あります/です 的礼貌形式可用 ございます。",
                "en": "Use いただきます for receiving/eating/drinking; use ございます as a polite form of あります/です."
              }
            }
          ]
        },
        {
          "id": "l50-grammar-08",
          "pattern": "謙譲語は自分側の動作",
          "zh": "谦让语用于降低自己一方；对方动作要用尊敬语。",
          "en": "Humble language lowers your side; use honorific language for the other person's actions.",
          "example": "私が参ります。先生がいらっしゃいます。",
          "practice": [
            {
              "id": "l50-practice-08",

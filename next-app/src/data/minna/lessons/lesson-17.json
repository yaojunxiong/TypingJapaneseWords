              "question": {
                "zh": "「ないでください」的词汇意思是？",
                "en": "What does ないでください mean?"
              },
              "options": [
                {
                  "text": {
                    "zh": "请不要〜",
                    "en": "please don't~"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "zh": "必须〜",
                    "en": "must~"

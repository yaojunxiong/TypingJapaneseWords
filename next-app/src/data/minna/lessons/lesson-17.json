      "items": [
        {
          "id": "l17_g01",
          "pattern": "Vないで ください",
          "title": {
            "zh": "否定请求",
            "en": "Negative request"
          },
          "explanation": {
            "zh": "礼貌要求对方不要做某事。",
            "en": "Politely ask someone not to do something."
          },
          "examples": [
            {
              "jp": "ここにごみを捨てないでください。",
              "zh": "请不要在这里扔垃圾。",
              "en": "Please do not throw trash here."
            }
          ],
          "practice": [
            {
              "id": "l17_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“请不要忘记作业”是？",
                "en": "How to say: Please do not forget homework?"
              },
              "options": [
                {
                  "text": {
                    "jp": "宿題を忘れないでください。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "宿題を忘れてください。"
                  }
                },
                {
                  "text": {
                    "jp": "宿題を忘れなくてください。"
                  }
                },
                {
                  "text": {
                    "jp": "宿題が忘れないでください。"
                  }
                }
              ],
              "explanation": {
                "zh": "礼貌要求对方不要做某事。",
                "en": "Politely ask someone not to do something."
              }

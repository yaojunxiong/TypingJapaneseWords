    {
      "type": "grammar",
      "id": "l28_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l28_g01",
          "pattern": "ます形去ます + ながら",
          "explanation": {
            "zh": "表示同一个人同时做两个动作，后面的动作是主要动作。",
            "en": "Shows one person doing two actions at the same time; the second action is the main one."
          },
          "examples": [
            {
              "jp": "音楽を聞きながら、勉強します。",
              "zh": "一边听音乐一边学习。",
              "en": "I study while listening to music."
            }
          ],
          "practice": [
            {
              "id": "l28_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "「听音乐ながら学习」正确的是？",
                "en": "Which is correct: study while listening to music?"
              },
              "options": [
                {
                  "text": {
                    "jp": "音楽を聞きながら、勉強します"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "音楽を聞いてながら、勉強します"
                  }
                },
                {
                  "text": {
                    "jp": "音楽を聞くながら、勉強します"
                  }
                },
                {
                  "text": {
                    "jp": "音楽を聞きますながら、勉強します"
                  }
                }
              ],
              "explanation": {
                "zh": "ながら前接ます形去ます。",
                "en": "Nagara attaches to the masu-stem."
              }
            }
          ]
        },
        {
          "id": "l28_g02",
          "pattern": "ながら的主语限制",
          "explanation": {
            "zh": "两个动作通常由同一个主语完成。",
            "en": "The two actions are usually done by the same subject."
          },
          "examples": [
            {
              "jp": "テレビを見ながら、ご飯を食べます。",
              "zh": "一边看电视一边吃饭。",
              "en": "I eat while watching TV."
            }
          ],
          "practice": [
            {
              "id": "l28_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "ながら句中主要动作通常在哪里？",
                "en": "Where is the main action in a nagara sentence?"
              },
              "options": [
                {
                  "text": {
                    "zh": "后半句",
                    "en": "In the second clause"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "zh": "前半句"
                  }
                },
                {
                  "text": {
                    "zh": "两个都不能是主要动作"
                  }
                },
                {
                  "text": {
                    "zh": "只在名词前"
                  }
                }
              ],
              "explanation": {
                "zh": "ながら前面的动作是伴随动作。",
                "en": "The nagara action is the accompanying action."
              }
            }
          ]
        },
        {
          "id": "l28_g03",
          "pattern": "ています：习惯",
          "explanation": {
            "zh": "「ています」除了正在进行，也可表示长期习惯。",
            "en": "Te imasu can describe a regular habit, not only an action in progress."
          },
          "examples": [
            {
              "jp": "毎朝ジョギングをしています。",
              "zh": "每天早上跑步。",
              "en": "I jog every morning."
            }
          ],
          "practice": [
            {
              "id": "l28_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "表示“每天练习”自然的是？",
                "en": "Which naturally means 'I practice every day'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "毎日練習しています"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "毎日練習してあります"
                  }
                },
                {
                  "text": {
                    "jp": "毎日練習しながらです"
                  }
                },
                {
                  "text": {
                    "jp": "毎日練習しましたいます"
                  }
                }
              ],
              "explanation": {
                "zh": "习惯可用「ています」。",
                "en": "Te imasu can express habits."
              }
            }
          ]
        },
        {
          "id": "l28_g04",
          "pattern": "ています：职业 / 所属",
          "explanation": {
            "zh": "表示从事某职业或在某处工作，也常用「ています」。",
            "en": "Te imasu also describes jobs or ongoing affiliation."
          },
          "examples": [
            {
              "jp": "父は銀行で働いています。",
              "zh": "父亲在银行工作。",
              "en": "My father works at a bank."
            }
          ],
          "practice": [
            {
              "id": "l28_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“在大学教书”自然的是？",
                "en": "Which naturally means 'teaches at a university'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "大学で教えています"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "大学で教えてあります"
                  }
                },
                {
                  "text": {
                    "jp": "大学で教えながらです"
                  }
                },
                {
                  "text": {
                    "jp": "大学に教えています"
                  }
                }
              ],
              "explanation": {
                "zh": "工作地点用「で」，职业状态用「ています」。",
                "en": "Use de for workplace and te imasu for the ongoing job."
              }
            }
          ]
        },
        {
          "id": "l28_g05",
          "pattern": "普通形 + し、普通形 + し",
          "explanation": {
            "zh": "列举多个理由或特点，暗示还有其他理由。",
            "en": "Lists multiple reasons or features and implies there may be more."
          },
          "examples": [
            {
              "jp": "この店は安いし、おいしいし、よく来ます。",
              "zh": "这家店又便宜又好吃，所以常来。",
              "en": "This restaurant is cheap and tasty, so I come often."
            }
          ],
          "practice": [
            {
              "id": "l28_g05_p01",
              "skill": "grammar",
              "question": {
                "zh": "「又便宜又方便」正确的是？",
                "en": "Which means 'cheap and convenient'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "安いし、便利だし"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "安いし、便利し"
                  }
                },
                {
                  "text": {
                    "jp": "安いで、便利だし"
                  }
                },
                {
                  "text": {
                    "jp": "安くし、便利だし"
                  }
                }
              ],
              "explanation": {
                "zh": "な形容词/名词用「だし」。",
                "en": "Na-adjectives and nouns use da shi."
              }
            }
          ]
        },
        {
          "id": "l28_g06",
          "pattern": "名词 / な形容词 + だし",
          "explanation": {
            "zh": "名词和な形容词列举理由时要加「だし」。",
            "en": "Nouns and na-adjectives take da shi when listing reasons."
          },
          "examples": [
            {
              "jp": "駅も近いし、静かだし、この部屋がいいです。",
              "zh": "车站也近，又安静，这个房间不错。",
              "en": "The station is close and it is quiet, so this room is good."
            }
          ],
          "practice": [
            {
              "id": "l28_g06_p01",
              "skill": "grammar",
              "question": {
                "zh": "「认真又热心」正确的是？",
                "en": "Which means 'serious and enthusiastic'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "まじめだし、熱心だし"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "まじめし、熱心し"
                  }
                },
                {
                  "text": {
                    "jp": "まじめでし、熱心でし"
                  }
                },
                {
                  "text": {
                    "jp": "まじめなだし、熱心なだし"
                  }
                }
              ],
              "explanation": {
                "zh": "な形容词词干 + だし。",
                "en": "Use the na-adjective stem + da shi."
              }
            }
          ]
        },
        {
          "id": "l28_g07",
          "pattern": "それに",
          "explanation": {
            "zh": "补充同方向信息，意思是“而且”。",
            "en": "Adds another point in the same direction: moreover."
          },
          "examples": [
            {
              "jp": "この店は安いです。それに、おいしいです。",
              "zh": "这家店便宜，而且好吃。",
              "en": "This restaurant is cheap. Moreover, it is tasty."
            }
          ],
          "practice": [
            {
              "id": "l28_g07_p01",
              "skill": "grammar",
              "question": {
                "zh": "补充优点时用？",
                "en": "Which connector adds another positive point?"
              },
              "options": [
                {
                  "text": {
                    "jp": "それに"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "それで"
                  }
                },
                {
                  "text": {
                    "jp": "でも"
                  }
                },
                {
                  "text": {
                    "jp": "だからながら"
                  }

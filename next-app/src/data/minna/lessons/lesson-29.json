    {
      "type": "grammar",
      "id": "l29_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l29_g01",
          "pattern": "自動詞 + ています",
          "explanation": {
            "zh": "描述动作发生后留下的状态，重点是“现在是什么状态”。",
            "en": "Describes the state that remains after an action happened."
          },
          "examples": [
            {
              "jp": "ドアが開いています。",
              "zh": "门开着。",
              "en": "The door is open."
            }
          ],
          "practice": [
            {
              "id": "l29_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“门开着”正确的是？",
                "en": "How do you say 'The door is open'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ドアが開いています"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ドアを開いています"
                  }
                },
                {
                  "text": {
                    "jp": "ドアが開けています"
                  }
                },
                {
                  "text": {
                    "jp": "ドアを開けてあります"
                  }
                }
              ],
              "explanation": {
                "zh": "自动词「開きます」描述状态，用「が」。",
                "en": "Use the intransitive akimasu with ga."
              }
            }
          ]
        },
        {
          "id": "l29_g02",
          "pattern": "N が + 自動詞",
          "explanation": {
            "zh": "自动词句里，发生变化的对象通常用「が」。",
            "en": "The thing that changes state is usually marked with ga."
          },
          "examples": [
            {
              "jp": "電気がついています。",
              "zh": "灯亮着。",
              "en": "The light is on."
            }
          ],
          "practice": [
            {
              "id": "l29_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“灯亮着”正确的是？",
                "en": "How do you say 'The light is on'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "電気がついています"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "電気をついています"
                  }
                },
                {
                  "text": {
                    "jp": "電気がつけています"
                  }
                },
                {
                  "text": {
                    "jp": "電気をつけてあります"
                  }
                }
              ],
              "explanation": {
                "zh": "「つきます」是自动词。",
                "en": "Tsukimasu is intransitive here."
              }
            }
          ]
        },
        {
          "id": "l29_g03",
          "pattern": "閉まっています / 消えています",
          "explanation": {
            "zh": "用自动词て形 + います描述“关着、灭着”等结果状态。",
            "en": "Use intransitive te-form + imasu for states such as closed or off."
          },
          "examples": [
            {
              "jp": "窓が閉まっています。",
              "zh": "窗户关着。",
              "en": "The window is closed."
            }
          ],
          "practice": [
            {
              "id": "l29_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“窗户关着”正确的是？",
                "en": "How do you say 'The window is closed'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "窓が閉まっています"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "窓を閉まっています"
                  }
                },
                {
                  "text": {
                    "jp": "窓が閉めています"
                  }
                },
                {
                  "text": {
                    "jp": "窓を閉めています"
                  }
                }
              ],
              "explanation": {
                "zh": "自动词「閉まります」用「が」。",
                "en": "Use intransitive shimarimasu with ga."
              }
            }
          ]
        },
        {
          "id": "l29_g04",
          "pattern": "壊れています / 割れています",
          "explanation": {
            "zh": "设备、物品损坏后的状态用自动词结果状态表达。",
            "en": "Use intransitive result-state expressions for broken objects."
          },
          "examples": [
            {
              "jp": "エレベーターが壊れています。",
              "zh": "电梯坏了。",
              "en": "The elevator is broken."
            }
          ],
          "practice": [
            {
              "id": "l29_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“杯子碎了/裂了”正确的是？",
                "en": "How do you say 'The cup is broken/cracked'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "コップが割れています"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "コップを割れています"
                  }
                },
                {
                  "text": {
                    "jp": "コップが割っています"
                  }
                },
                {
                  "text": {
                    "jp": "コップを割っています"
                  }
                }
              ],
              "explanation": {
                "zh": "「割れます」是自动词。",
                "en": "Waremasu is intransitive."
              }
            }
          ]
        },
        {
          "id": "l29_g05",
          "pattern": "〜てしまいました：遗憾 / 意外",
          "explanation": {
            "zh": "表达不小心、遗憾、糟糕等感觉。",
            "en": "Expresses regret, accident, or an unwanted result."
          },
          "examples": [
            {
              "jp": "財布をなくしてしまいました。",
              "zh": "把钱包弄丢了。",
              "en": "I lost my wallet."
            }
          ],
          "practice": [
            {
              "id": "l29_g05_p01",
              "skill": "grammar",
              "question": {
                "zh": "“把护照忘了”应说？",
                "en": "How do you say 'I forgot my passport' with regret?"
              },
              "options": [
                {
                  "text": {
                    "jp": "パスポートを忘れてしまいました"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "パスポートを忘れています"
                  }
                },
                {
                  "text": {
                    "jp": "パスポートが忘れてしまいました"
                  }
                },
                {
                  "text": {
                    "jp": "パスポートを忘れましたいます"
                  }
                }
              ],
              "explanation": {
                "zh": "遗憾用「てしまいました」。",
                "en": "Use te shimaimashita for regret."
              }
            }
          ]
        },
        {
          "id": "l29_g06",
          "pattern": "〜てしまいました：完成",
          "explanation": {
            "zh": "也可表示动作完全做完，语气不一定负面。",
            "en": "It can also mean the action is completely finished, not necessarily negative."
          },
          "examples": [
            {
              "jp": "宿題をしてしまいました。",
              "zh": "作业做完了。",
              "en": "I finished my homework."
            }
          ],
          "practice": [
            {
              "id": "l29_g06_p01",
              "skill": "grammar",
              "question": {
                "zh": "“作业全做完了”是？",
                "en": "How do you say 'I finished all my homework'?"
              },
              "options": [

    {
      "type": "grammar",
      "id": "l35_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l35_g01",
          "pattern": "一类动词条件形：う段 → え段 + ば",
          "explanation": {
            "zh": "行く→行けば、飲む→飲めば、話す→話せば。",
            "en": "Group 1 verbs change final u-sound to e-sound plus ba: iku to ikeba."
          },
          "examples": [
            {
              "jp": "駅へ行けば、わかります。",
              "zh": "去车站的话就知道了。",
              "en": "If you go to the station, you will know."
            }
          ],
          "practice": [
            {
              "id": "l35_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "「行く」的条件形是？",
                "en": "Conditional form of iku?"
              },
              "options": [
                {
                  "text": {
                    "jp": "行けば"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "行くば"
                  }
                },
                {
                  "text": {
                    "jp": "行きば"
                  }
                },
                {
                  "text": {
                    "jp": "行ったらば"
                  }
                }
              ],
              "explanation": {
                "zh": "く→けば。",
                "en": "Ku changes to keba."
              }
            }
          ]
        },
        {
          "id": "l35_g02",
          "pattern": "二类动词条件形：ます形去ます + れば",
          "explanation": {
            "zh": "食べる→食べれば、見る→見れば。",
            "en": "Group 2 verbs use stem + reba: taberu to tabereba."
          },
          "examples": [
            {
              "jp": "薬を飲めば、よくなります。",
              "zh": "吃药的话会好。",
              "en": "If you take medicine, you will get better."
            }
          ],
          "practice": [
            {
              "id": "l35_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "「食べる」的条件形是？",
                "en": "Conditional form of taberu?"
              },
              "options": [
                {
                  "text": {
                    "jp": "食べれば"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "食べるば"
                  }
                },
                {
                  "text": {
                    "jp": "食べば"
                  }
                },
                {
                  "text": {
                    "jp": "食べたらば"
                  }
                }
              ],
              "explanation": {
                "zh": "二类动词去る加れば。",
                "en": "Drop ru and add reba."
              }
            }
          ]
        },
        {
          "id": "l35_g03",
          "pattern": "三类条件形：すれば / 来れば",
          "explanation": {
            "zh": "する→すれば、来る→来れば（くれば）。",
            "en": "Irregulars: suru to sureba, kuru to kureba."
          },
          "examples": [
            {
              "jp": "練習すれば、上手になります。",
              "zh": "练习的话会变擅长。",
              "en": "If you practice, you will improve."
            }
          ],
          "practice": [
            {
              "id": "l35_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "「する」的条件形是？",
                "en": "Conditional form of suru?"
              },
              "options": [
                {
                  "text": {
                    "jp": "すれば"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "するば"
                  }
                },
                {
                  "text": {
                    "jp": "しれば"
                  }
                },
                {
                  "text": {
                    "jp": "したらば"
                  }
                }
              ],
              "explanation": {
                "zh": "する→すれば。",
                "en": "Suru becomes sureba."
              }
            }
          ]
        },
        {
          "id": "l35_g04",
          "pattern": "い形容词：〜ければ",
          "explanation": {
            "zh": "去掉い，加ければ：安い→安ければ。",
            "en": "Remove i and add kereba: yasui to yasukereba."
          },
          "examples": [
            {
              "jp": "安ければ、買います。",
              "zh": "便宜的话就买。",
              "en": "If it is cheap, I will buy it."
            }
          ],
          "practice": [
            {
              "id": "l35_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "「高い」的条件形是？",
                "en": "Conditional form of takai?"
              },
              "options": [
                {
                  "text": {
                    "jp": "高ければ"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "高いば"
                  }
                },
                {
                  "text": {
                    "jp": "高くれば"
                  }
                },
                {
                  "text": {
                    "jp": "高かったらば"
                  }
                }
              ],
              "explanation": {
                "zh": "い形容词去い加ければ。",
                "en": "Remove i and add kereba."
              }
            }
          ]
        },
        {
          "id": "l35_g05",
          "pattern": "な形容词 / 名词：なら",
          "explanation": {
            "zh": "承接话题：“如果是……的话”。",
            "en": "Nara picks up a topic: if it is about..."
          },
          "examples": [
            {
              "jp": "日本語を勉強するなら、この本がいいです。",
              "zh": "如果学日语的话，这本书不错。",
              "en": "If you are studying Japanese, this book is good."
            }
          ],
          "practice": [
            {
              "id": "l35_g05_p01",
              "skill": "grammar",
              "question": {
                "zh": "“如果是京都的话，我知道”是？",
                "en": "How do you say 'If it is Kyoto, I know'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "京都なら、知っています"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "京都ば、知っています"
                  }
                },
                {
                  "text": {
                    "jp": "京都であればなら、知っています"
                  }
                },
                {
                  "text": {
                    "jp": "京都だったらなら、知っています"
                  }
                }
              ],
              "explanation": {
                "zh": "承接话题用なら。",
                "en": "Use nara to pick up a topic."
              }
            }
          ]
        },
        {
          "id": "l35_g06",
          "pattern": "疑问词 + ばいいですか",
          "explanation": {
            "zh": "询问建议、方法：“怎么/去哪/问谁才好？”",
            "en": "Asks for advice or method: how/where/whom should I...?"
          },
          "examples": [
            {
              "jp": "駅へ行きたいんですが、どう行けばいいですか。",
              "zh": "我想去车站，怎么走好？",
              "en": "I want to go to the station. How should I get there?"
            }
          ],
          "practice": [
            {
              "id": "l35_g06_p01",
              "skill": "grammar",
              "question": {
                "zh": "“该问谁好？”是？",
                "en": "How do you ask 'Whom should I ask?'"
              },
              "options": [
                {
                  "text": {
                    "jp": "だれに聞けばいいですか"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "だれを聞けばいいですか"
                  }
                },
                {
                  "text": {
                    "jp": "だれに聞くばいいですか"
                  }
                },
                {
                  "text": {
                    "jp": "だれに聞いたらばいいですか"
                  }
                }
              ],
              "explanation": {
                "zh": "聞く→聞けば。",
                "en": "Kiku becomes kikeba."
              }
            }
          ]
        },
        {
          "id": "l35_g07",
          "pattern": "〜ば、〜",
          "explanation": {
            "zh": "条件成立时，后项成立。常用于一般条件、建议、方法。",
            "en": "If the condition holds, the result follows. Useful for general conditions and advice."
          },
          "examples": [
            {
              "jp": "ここを押せば、ドアが開きます。",
              "zh": "按这里的话，门会开。",
              "en": "If you press here, the door opens."
            }
          ],
          "practice": [
            {
              "id": "l35_g07_p01",
              "skill": "grammar",
              "question": {
                "zh": "“按这里就会动”是？",
                "en": "How do you say 'If you press here, it will move'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ここを押せば、動きます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ここを押すば、動きます"
                  }
                },
                {
                  "text": {
                    "jp": "ここを押してば、動きます"
                  }
                },
                {
                  "text": {
                    "jp": "ここを押したらば、動きます"
                  }
                }
              ],
              "explanation": {
                "zh": "押す→押せば。",
                "en": "Osu becomes oseba."
              }
            }
          ]
        },
        {
          "id": "l35_g08",
          "pattern": "なければ",
          "explanation": {
            "zh": "ない形去い + ければ，表示“不……的话”。",
            "en": "For negative conditionals, replace nai with nakereba."
          },
          "examples": [
            {
              "jp": "時間がなければ、明日しましょう。",
              "zh": "如果没有时间，明天做吧。",
              "en": "If there is no time, let's do it tomorrow."
            }
          ],
          "practice": [
            {
              "id": "l35_g08_p01",
              "skill": "grammar",
              "question": {

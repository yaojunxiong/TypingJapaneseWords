    {
      "type": "grammar",
      "id": "l37_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l37_g01",
          "pattern": "一类动词受身形：ない形去ない + れます",
          "explanation": {
            "zh": "書きます→書かれます、呼びます→呼ばれます。",
            "en": "Group 1 passive uses the nai-stem + remasu: kakimasu to kakaremasu."
          },
          "examples": [
            {
              "jp": "先生に名前を呼ばれました。",
              "zh": "被老师叫了名字。",
              "en": "My name was called by the teacher."
            }
          ],
          "practice": [
            {
              "id": "l37_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "「書きます」的受身形是？",
                "en": "Passive form of kakimasu?"
              },
              "options": [
                {
                  "text": {
                    "jp": "書かれます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "書きられます"
                  }
                },
                {
                  "text": {
                    "jp": "書けられます"
                  }
                },
                {
                  "text": {
                    "jp": "書かせます"
                  }
                }
              ],
              "explanation": {
                "zh": "書かない→書かれます。",
                "en": "Kakanai stem + remasu."
              }
            }
          ]
        },
        {
          "id": "l37_g02",
          "pattern": "二类动词受身形：ます形去ます + られます",
          "explanation": {
            "zh": "褒めます→褒められます、見ます→見られます。",
            "en": "Group 2 passive uses the stem + raremasu."
          },
          "examples": [
            {
              "jp": "先生に褒められました。",
              "zh": "被老师表扬了。",
              "en": "I was praised by the teacher."
            }
          ],
          "practice": [
            {
              "id": "l37_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "「褒めます」的受身形是？",
                "en": "Passive form of homemasu?"
              },
              "options": [
                {
                  "text": {
                    "jp": "褒められます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "褒めれます"
                  }
                },
                {
                  "text": {
                    "jp": "褒めされます"
                  }
                },
                {
                  "text": {
                    "jp": "褒めますられます"
                  }
                }
              ],
              "explanation": {
                "zh": "二类动词去ます加られます。",
                "en": "Stem + raremasu."
              }
            }
          ]
        },
        {
          "id": "l37_g03",
          "pattern": "三类受身形：されます / 来られます",
          "explanation": {
            "zh": "します→されます、来ます→来られます。",
            "en": "Irregular passive: shimasu to saremasu, kimasu to koraremasu."
          },
          "examples": [
            {
              "jp": "パーティーに招待されました。",
              "zh": "被邀请参加派对。",
              "en": "I was invited to a party."
            }
          ],
          "practice": [
            {
              "id": "l37_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "「招待します」的受身形是？",
                "en": "Passive form of shoutai shimasu?"
              },
              "options": [
                {
                  "text": {
                    "jp": "招待されます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "招待しられます"
                  }
                },
                {
                  "text": {
                    "jp": "招待しますられます"
                  }
                },
                {
                  "text": {
                    "jp": "招待させます"
                  }
                }
              ],
              "explanation": {
                "zh": "します→されます。",
                "en": "Shimasu becomes saremasu."
              }
            }
          ]
        },
        {
          "id": "l37_g04",
          "pattern": "人 は 人 に V受身",
          "explanation": {
            "zh": "动作来源用「に」。表示“被某人……”。",
            "en": "Use ni for the person who performs the action."
          },
          "examples": [
            {
              "jp": "わたしは母に叱られました。",
              "zh": "我被妈妈骂了。",
              "en": "I was scolded by my mother."
            }
          ],
          "practice": [
            {
              "id": "l37_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“被老师表扬”是？",
                "en": "How do you say 'was praised by the teacher'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生に褒められました"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生を褒められました"
                  }
                },
                {
                  "text": {
                    "jp": "先生が褒めました"
                  }
                },
                {
                  "text": {
                    "jp": "先生で褒められました"
                  }
                }
              ],
              "explanation": {
                "zh": "动作来源用に。",
                "en": "Use ni for the agent."
              }
            }
          ]
        },
        {
          "id": "l37_g05",
          "pattern": "物 が V受身",
          "explanation": {
            "zh": "物作主语时，常用于“被建造、被发明、被发现”等客观叙述。",
            "en": "Object-subject passive is used for things being built, invented, discovered, etc."
          },
          "examples": [
            {
              "jp": "この寺は500年前に建てられました。",
              "zh": "这座寺庙建于500年前。",
              "en": "This temple was built 500 years ago."
            }
          ],
          "practice": [
            {
              "id": "l37_g05_p01",
              "skill": "grammar",
              "question": {
                "zh": "“这座桥建于去年”是？",
                "en": "How do you say 'This bridge was built last year'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "この橋は去年建てられました"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "この橋は去年建てました"
                  }
                },
                {
                  "text": {
                    "jp": "この橋が去年建てました"
                  }
                },
                {
                  "text": {
                    "jp": "この橋は去年建てされました"
                  }
                }
              ],
              "explanation": {
                "zh": "物作主语用受身形。",
                "en": "Use passive when the thing is the subject."
              }
            }
          ]
        },
        {
          "id": "l37_g06",
          "pattern": "作品 / 発明 / 発見 + 受身",
          "explanation": {
            "zh": "说明作品由谁创作、东西由谁发明或发现。",
            "en": "States who created, invented, or discovered something."
          },
          "examples": [
            {
              "jp": "この歌は多くの人に歌われています。",
              "zh": "这首歌被很多人唱。",
              "en": "This song is sung by many people."
            }
          ],
          "practice": [
            {
              "id": "l37_g06_p01",
              "skill": "grammar",
              "question": {
                "zh": "“电话是贝尔发明的”是？",
                "en": "How do you say 'The telephone was invented by Bell'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "電話はベルによって発明されました"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "電話はベルに発明しました"
                  }
                },
                {
                  "text": {
                    "jp": "電話がベルを発明されました"
                  }
                },
                {
                  "text": {
                    "jp": "電話はベルで発明しました"
                  }
                }
              ],
              "explanation": {
                "zh": "正式说明发明者常用「によって」。",
                "en": "Ni yotte is often used for inventors/creators."
              }
            }
          ]
        },
        {
          "id": "l37_g07",
          "pattern": "持ち物 は 人 に V受身",
          "explanation": {
            "zh": "自己的东西被别人怎么样，常带受害感。",
            "en": "When something belonging to you is affected by someone, it often carries adversity."
          },
          "examples": [
            {
              "jp": "わたしは弟にカメラを壊されました。",
              "zh": "我的相机被弟弟弄坏了。",
              "en": "My camera was broken by my younger brother."
            }
          ],
          "practice": [
            {
              "id": "l37_g07_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我的钱包被偷了”是？",
                "en": "How do you say 'My wallet was stolen'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "財布を盗まれました"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "財布が盗みました"
                  }
                },
                {
                  "text": {
                    "jp": "財布を盗みられました"
                  }
                },
                {
                  "text": {
                    "jp": "財布に盗まれました"
                  }
                }
              ],
              "explanation": {
                "zh": "盗みます→盗まれます。",
                "en": "Nusumimasu becomes nusumaremasu."
              }
            }
          ]
        },
        {
          "id": "l37_g08",
          "pattern": "受害被动",
          "explanation": {
            "zh": "别人动作间接影响自己时，可用受身表达困扰或不满。",
            "en": "Adversity passive shows that someone else's action negatively affected you."
          },
          "examples": [
            {
              "jp": "雨に降られて、困りました。",
              "zh": "被雨淋了，很困扰。",
              "en": "I was caught in the rain and had trouble."
            }
          ],
          "practice": [
            {
              "id": "l37_g08_p01",
              "skill": "grammar",
              "question": {
                "zh": "“被雨淋了”是？",
                "en": "How do you say 'I was caught in the rain'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "雨に降られました"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "雨を降られました"
                  }
                },
                {
                  "text": {
                    "jp": "雨が降られました"
                  }
                },
                {
                  "text": {
                    "jp": "雨に降りました"
                  }
                }
              ],
              "explanation": {
                "zh": "受害被动常用「雨に降られる」。",
                "en": "The adversity passive uses ame ni furareru."
              }
            }
          ]
        }
      ]
    },

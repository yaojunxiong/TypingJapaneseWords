  "subtitle": {
    "zh": "条件「たら・ても」",
    "en": "Conditional tara and temo",
    "ja": "たら・ても"
  },
  "focus": {
    "zh": "学习「〜たら」假定/确定条件和「〜ても」逆接条件。",
    "en": "Learn tara for conditional timing/hypothesis and temo for concession.",
    "ja": "「〜たら」と「〜ても」で条件表現を完成させます。"
  },

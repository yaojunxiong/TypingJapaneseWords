    {
      "type": "grammar",
      "id": "l25_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l25_g01",
          "pattern": "Vたら、〜",
          "title": {
            "zh": "如果……就……",
            "en": "If/when ... then ..."
          },
          "explanation": {
            "zh": "表示条件或某时点之后。",
            "en": "Marks condition or sequence after completion."
          },
          "examples": [
            {
              "jp": "時間があったら、映画を見ます。",
              "zh": "如果有时间就看电影。",
              "en": "If I have time, I will watch a movie."
            }
          ],
          "practice": [
            {
              "id": "l25_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“如果下雨就在家”是？",
                "en": "How to say: If it rains, I stay home?"
              },
              "options": [
                {
                  "text": {
                    "jp": "雨が降ったら、うちにいます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "雨が降るたら、うちにいます。"
                  }
                },
                {
                  "text": {
                    "jp": "雨が降っても、うちにいます。"
                  }
                },
                {
                  "text": {
                    "jp": "雨が降ったら、うちがいます。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示条件或某时点之后。",
                "en": "Marks condition or sequence after completion."
              }
            },
            {
              "id": "l25_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“到了12点就吃饭”是？",
                "en": "How to say: When it becomes 12, I eat lunch?"
              },
              "options": [
                {
                  "text": {
                    "jp": "十二時になったら、ごはんを食べます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "十二時になるたら、ごはんを食べます。"
                  }
                },
                {
                  "text": {
                    "jp": "十二時になって、ごはんを食べます。"
                  }
                },
                {
                  "text": {
                    "jp": "十二時でなったら、ごはんを食べます。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示条件或某时点之后。",
                "en": "Marks condition or sequence after completion."
              }
            }
          ]
        },
        {
          "id": "l25_g02",
          "pattern": "もし 〜たら、〜",
          "title": {
            "zh": "假定条件",
            "en": "Hypothetical condition"
          },
          "explanation": {
            "zh": "用「もし」让假设语气更明显。",
            "en": "Moshi emphasizes hypothetical condition."
          },
          "examples": [
            {
              "jp": "もし宝くじが当たったら、旅行します。",
              "zh": "如果中了彩票，我就去旅行。",
              "en": "If I win the lottery, I will travel."
            }
          ],
          "practice": [

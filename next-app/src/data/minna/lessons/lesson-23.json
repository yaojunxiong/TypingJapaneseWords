      "type": "grammar",
      "id": "l23_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l23_g01",
          "pattern": "Vると、〜",
          "title": {
            "zh": "自然结果条件",
            "en": "Natural result condition"
          },
          "explanation": {
            "zh": "前项发生后后项自然发生。",
            "en": "When A happens, B naturally follows."
          },
          "examples": [
            {
              "jp": "このボタンを押すと、ドアが開きます。",
              "zh": "按下这个按钮门就会开。",
              "en": "If you press this button, the door opens."
            }
          ],
          "practice": [
            {
              "id": "l23_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“一到春天花就开”是？",
                "en": "How to say: Flowers bloom when spring comes?"
              },
              "options": [
                {
                  "text": {
                    "jp": "春になると、花が咲きます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "春になったら、花が咲きます。"
                  }
                },
                {
                  "text": {
                    "jp": "春でなると、花が咲きます。"
                  }
                },
                {
                  "text": {
                    "jp": "春にと、花が咲きます。"
                  }
                }
              ],
              "explanation": {
                "zh": "前项发生后后项自然发生。",
                "en": "When A happens, B naturally follows."
              }
            },
            {
              "id": "l23_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“左转就有银行”是？",
                "en": "How to say: Turn left and there is a bank?"
              },
              "options": [
                {
                  "text": {
                    "jp": "左へ曲がると、銀行があります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "左へ曲がって、銀行があります。"
                  }
                },
                {
                  "text": {
                    "jp": "左へ曲がるが、銀行があります。"
                  }
                },
                {
                  "text": {
                    "jp": "左へ曲がると、銀行がいます。"
                  }
                }
              ],
              "explanation": {
                "zh": "前项发生后后项自然发生。",
                "en": "When A happens, B naturally follows."
              }
            }
          ]
        },
        {
          "id": "l23_g02",
          "pattern": "Nのとき / Vるとき",
          "title": {
            "zh": "……的时候",
            "en": "When ..."
          },
          "explanation": {
            "zh": "表示某个时间点或场景。",
            "en": "Marks the time/occasion of an action."
          },
          "examples": [
            {
              "jp": "日本へ行くとき、パスポートが要ります。",
              "zh": "去日本的时候需要护照。",
              "en": "You need a passport when going to Japan."
            }
          ],
          "practice": [
            {
              "id": "l23_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“过马路的时候要小心”是？",
                "en": "How to say: Be careful when crossing the road?"
              },
              "options": [
                {
                  "text": {
                    "jp": "道を渡るとき、気をつけます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "道を渡ってとき、気をつけます。"
                  }
                },
                {
                  "text": {
                    "jp": "道が渡るとき、気をつけます。"
                  }
                },
                {
                  "text": {
                    "jp": "道を渡るのとき、気をつけます。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示某个时间点或场景。",
                "en": "Marks the time/occasion of an action."
              }
            },
            {
              "id": "l23_g02_p02",
              "skill": "grammar",
              "question": {
                "zh": "“学生的时候住在大阪”是？",
                "en": "How to say: I lived in Osaka when I was a student?"
              },
              "options": [
                {
                  "text": {
                    "jp": "学生のとき、大阪に住んでいました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "学生とき、大阪に住んでいました。"
                  }
                },
                {
                  "text": {
                    "jp": "学生がとき、大阪に住んでいました。"
                  }
                },
                {
                  "text": {
                    "jp": "学生でとき、大阪に住んでいました。"
                  }
                }
              ],
              "explanation": {
                "zh": "表示某个时间点或场景。",
                "en": "Marks the time/occasion of an action."
              }
            }
          ]
        },
        {
          "id": "l23_g03",
          "pattern": "Vたとき",
          "title": {
            "zh": "做了之后那个时点",
            "en": "When (after doing)"
          },
          "explanation": {
            "zh": "强调动作完成后的时点。",
            "en": "Refers to the time point after completion."
          },
          "examples": [
            {
              "jp": "家へ帰ったとき、雨が降りました。",
              "zh": "回到家时下雨了。",
              "en": "When I got home, it started raining."
            }
          ],
          "practice": [
            {
              "id": "l23_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“看完电影的时候”是？",
                "en": "How to say: when I finished watching the movie?"
              },
              "options": [
                {
                  "text": {
                    "jp": "映画を見たとき"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "映画を見るとき"
                  }
                },
                {
                  "text": {
                    "jp": "映画を見てとき"
                  }
                },
                {
                  "text": {
                    "jp": "映画が見たとき"
                  }
                }
              ],
              "explanation": {
                "zh": "强调动作完成后的时点。",
                "en": "Refers to the time point after completion."
              }
            },
            {
              "id": "l23_g03_p02",
              "skill": "grammar",
              "question": {
                "zh": "“拿到工资时很开心”是？",
                "en": "How to say: I was happy when I got my salary?"
              },
              "options": [
                {
                  "text": {
                    "jp": "給料をもらったとき、うれしかったです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "給料をもらうとき、うれしかったです。"
                  }
                },
                {
                  "text": {
                    "jp": "給料をもらってとき、うれしかったです。"
                  }
                },
                {
                  "text": {
                    "jp": "給料がもらったとき、うれしかったです。"
                  }
                }
              ],
              "explanation": {
                "zh": "强调动作完成后的时点。",
                "en": "Refers to the time point after completion."
              }
            }
          ]
        },
        {
          "id": "l23_g04",
          "pattern": "〜ときは、〜",
          "title": {
            "zh": "给出建议/规则",
            "en": "Rules and advice by situation"
          },
          "explanation": {
            "zh": "在某种场景下应当做什么。",
            "en": "What to do in a particular situation."
          },
          "examples": [
            {
              "jp": "困ったときは、先生に聞いてください。",
              "zh": "遇到困难时请问老师。",
              "en": "When in trouble, please ask the teacher."
            }
          ],
          "practice": [
            {
              "id": "l23_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“不懂的时候请问”是？",
                "en": "How to say: Ask when you do not understand?"
              },
              "options": [
                {
                  "text": {
                    "jp": "わからないときは、聞いてください。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "わからないとき、聞いてもいいです。"
                  }
                },
                {
                  "text": {
                    "jp": "わからないときは、聞きますか。"
                  }
                },
                {
                  "text": {
                    "jp": "わからないときで、聞いてください。"
                  }
                }
              ],
              "explanation": {
                "zh": "在某种场景下应当做什么。",
                "en": "What to do in a particular situation."
              }
            },
            {
              "id": "l23_g04_p02",
              "skill": "grammar",
              "question": {
                "zh": "“危险时不要碰”是？",
                "en": "How to say: Do not touch when dangerous?"
              },
              "options": [
                {
                  "text": {
                    "jp": "危険なときは、触らないでください。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "危険ときは、触らないでください。"
                  }
                },
                {
                  "text": {
                    "jp": "危険のときは、触ってください。"
                  }
                },
                {
                  "text": {
                    "jp": "危険なとき、触ってはいけませんか。"
                  }
                }
              ],
              "explanation": {
                "zh": "在某种场景下应当做什么。",
                "en": "What to do in a particular situation."
              }
            }
          ]
        }
      ]
    },
    {
      "type": "examples",
      "id": "l23_examples",
      "title": {
        "zh": "核心例句",
        "en": "Core Examples",
        "ja": "基本例文"
      },
      "items": [
        {
          "id": "l23_e01",
          "jp": "この道をまっすぐ行くと、駅があります。",
          "zh": "这条路直走就到车站。",
          "en": "If you go straight on this road, you will find the station."
        },
        {
          "id": "l23_e02",
          "jp": "日本へ行くとき、何を持って行きますか。",
          "zh": "去日本的时候你会带什么？",
          "en": "What will you bring when going to Japan?"
        },
        {
          "id": "l23_e03",
          "jp": "角を曲がったとき、古い店が見えました。",
          "zh": "拐角后看见了一家老店。",
          "en": "When I turned the corner, I saw an old shop."
        },
        {
          "id": "l23_e04",
          "jp": "困ったときは、友だちに相談します。",
          "zh": "遇到困难时我会和朋友商量。",
          "en": "When I am in trouble, I consult my friends."
        },
        {
          "id": "l23_e05",
          "jp": "夜、暗い道を歩くときは注意してください。",
          "zh": "晚上走暗路时请注意。",
          "en": "Please be careful when walking on dark roads at night."
        }
      ]
    },

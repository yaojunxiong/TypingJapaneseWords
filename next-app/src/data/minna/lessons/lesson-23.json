          "options": [
            {
              "text": {
                "jp": "このボタンを押すと、ドアが開きます。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "日本へ行くとき、パスポートが要ります。"
              }
            },
            {
              "text": {
                "jp": "家へ帰ったとき、雨が降りました。"
              }
            },
            {
              "text": {
                "jp": "困ったときは、先生に聞いてください。"
              }
            }
          ],
          "explanation": {
            "zh": "正确句型是「Vると、〜」。",
            "en": "The correct pattern is \"Vると、〜\"."
          }
        },
        {
          "id": "l23_q03",
          "question": {

            }
          ],
          "explanation": {
            "zh": "表示某个时间点或场景。",
            "en": "Marks the time/occasion of an action."
          }
        },
        {
          "id": "l23_q04",
          "question": {
            "zh": "与「这条路直走就到车站。」对应的日语句子是？",

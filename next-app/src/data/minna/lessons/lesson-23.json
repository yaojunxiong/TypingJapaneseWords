              }
            },
            {
              "text": {
                "jp": "角を曲がったとき、古い店が見えました。"
              }
            },
            {
              "text": {
                "jp": "困ったときは、友だちに相談します。"
              }
            }
          ],
          "explanation": {
            "zh": "对应句子是「この道をまっすぐ行くと、駅があります。」。",
            "en": "The matching sentence is \"この道をまっすぐ行くと、駅があります。\"."
          }
        }
      ]
    }

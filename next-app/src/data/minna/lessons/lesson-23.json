    {
      "type": "grammar",
      "id": "l23_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l23_g01",
          "pattern": "Vると、〜",
          "title": {
            "zh": "自然结果条件",
            "en": "Natural result condition"
          },
          "explanation": {
            "zh": "前项发生后后项自然发生。",
            "en": "When A happens, B naturally follows."
          },
          "examples": [
            {
              "jp": "このボタンを押すと、ドアが開きます。",
              "zh": "按下这个按钮门就会开。",
              "en": "If you press this button, the door opens."
            }
          ],
          "practice": [
            {
              "id": "l23_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“一到春天花就开”是？",
                "en": "How to say: Flowers bloom when spring comes?"
              },
              "options": [
                {
                  "text": {
                    "jp": "春になると、花が咲きます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "春になったら、花が咲きます。"
                  }
                },
                {
                  "text": {
                    "jp": "春でなると、花が咲きます。"
                  }
                },
                {
                  "text": {
                    "jp": "春にと、花が咲きます。"
                  }
                }
              ],
              "explanation": {
                "zh": "前项发生后后项自然发生。",
                "en": "When A happens, B naturally follows."
              }
            },
            {
              "id": "l23_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“左转就有银行”是？",
                "en": "How to say: Turn left and there is a bank?"
              },
              "options": [
                {
                  "text": {
                    "jp": "左へ曲がると、銀行があります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "左へ曲がって、銀行があります。"
                  }
                },
                {
                  "text": {
                    "jp": "左へ曲がるが、銀行があります。"
                  }
                },
                {
                  "text": {
                    "jp": "左へ曲がると、銀行がいます。"
                  }
                }
              ],
              "explanation": {
                "zh": "前项发生后后项自然发生。",
                "en": "When A happens, B naturally follows."
              }
            }
          ]
        },
        {
          "id": "l23_g02",
          "pattern": "Nのとき / Vるとき",
          "title": {
            "zh": "……的时候",

            {
              "text": {
                "zh": "转弯",
                "en": "turn (direction)"
              }
            }
          ],
          "explanation": {
            "zh": "「押します」表示「按」。",
            "en": "押します means push."
          }
        },
        {
          "id": "l23_q02",
          "question": {
            "zh": "哪一句最符合语法「Vると、〜」？",
            "en": "Which sentence best matches pattern \"Vると、〜\"?"

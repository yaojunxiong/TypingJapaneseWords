    {
      "type": "grammar",
      "id": "l24_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l24_g01",
          "pattern": "N1 は 私に N2を くれます",
          "title": {
            "zh": "给我（方）",
            "en": "Giving to me/us"
          },
          "explanation": {
            "zh": "主语给“我方”时用くれます。",
            "en": "Use kuremasu when someone gives to me/us."
          },
          "examples": [
            {
              "jp": "友だちは私に本をくれました。",
              "zh": "朋友给了我一本书。",
              "en": "My friend gave me a book."
            }
          ],
          "practice": [
            {
              "id": "l24_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“老师给了我礼物”是？",
                "en": "How to say: The teacher gave me a present?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生は私にプレゼントをくれました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生は私にプレゼントをあげました。"
                  }
                },
                {
                  "text": {
                    "jp": "先生は私がプレゼントをくれました。"
                  }
                },
                {
                  "text": {
                    "jp": "先生は私をプレゼントをくれました。"
                  }
                }
              ],

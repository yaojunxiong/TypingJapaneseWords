    {
      "type": "grammar",
      "id": "l08_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l08_g01",
          "pattern": "い形容词 / な形容词 + です",
          "title": {
            "zh": "形容词肯定句",
            "en": "Adjective affirmative"
          },
          "explanation": {
            "zh": "い形容词直接接です；な形容词词干后接です。",
            "en": "i-adjectives take 「です」 directly; na-adjectives use stem + 「です」."
          },
          "examples": [
            {
              "jp": "この 町は にぎやかです。",
              "zh": "这个城市很热闹。",
              "en": "This town is lively."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "哪一个是な形容词句？",
                "en": "Which is a na-adjective sentence?"
              },
              "options": [
                {
                  "text": {
                    "jp": "この へやは しずかです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "この へやは しずかいです。"
                  }
                },
                {
                  "text": {
                    "jp": "この へやは しずかくです。"
                  }
                },
                {
                  "text": {
                    "jp": "この へやは しずかなです。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "哪一个是い形容词句？",
                "en": "Which is an i-adjective sentence?"
              },
              "options": [
                {
                  "text": {
                    "jp": "この 本は おもしろいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "この 本は おもしろです。"
                  }
                },
                {
                  "text": {
                    "jp": "この 本は おもしろなです。"
                  }
                },
                {
                  "text": {
                    "jp": "この 本は おもしろくなです。"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l08_g02",
          "pattern": "否定：〜くないです / 〜じゃありません",
          "title": {
            "zh": "形容词否定",
            "en": "Adjective negative"
          },
          "explanation": {
            "zh": "い形容词去い+くないです；な形容词用「じゃありません」。",
            "en": "i-adj: drop 「い」 + 「くないです」; na-adj: 「じゃありません」."
          },
          "examples": [
            {
              "jp": "この 映画は おもしろくないです。",
              "zh": "这部电影不好看。",
              "en": "This movie is not interesting."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“不忙”是？",
                "en": "How to say “not busy”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "いそがしくないです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "いそがしいじゃありません。"
                  }
                },
                {
                  "text": {
                    "jp": "いそがしじゃありません。"
                  }
                },
                {
                  "text": {
                    "jp": "いそがないです。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“不安静”是？",
                "en": "How to say “not quiet”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "しずかじゃありません。"
                  },
                  "correct": true
                },
                {
                  "text": {

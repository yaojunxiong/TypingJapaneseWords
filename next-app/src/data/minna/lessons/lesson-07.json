    {
      "type": "grammar",
      "id": "l07_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l07_g01",
          "pattern": "人に 物を あげます",
          "title": {
            "zh": "给某人某物",
            "en": "Give something to someone"
          },
          "explanation": {
            "zh": "给出方用「あげます」，对象前用「に」。",
            "en": "Use 「あげます」 for giving; mark the receiver with 「に」."
          },
          "examples": [
            {
              "jp": "わたしは 友達に 本を あげました。",
              "zh": "我给朋友一本书。",
              "en": "I gave a book to my friend."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“给老师礼物”是？",
                "en": "How to say “give a present to the teacher”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生に プレゼントを あげます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生を プレゼントに あげます。"
                  }
                },
                {
                  "text": {
                    "jp": "先生で プレゼントを あげます。"
                  }
                },
                {
                  "text": {
                    "jp": "先生へ プレゼントが あげます。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "授予对象常用助词？",
                "en": "Which particle marks receiver?"
              },
              "options": [
                {
                  "text": {
                    "jp": "に"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "を"
                  }
                },
                {
                  "text": {
                    "jp": "で"
                  }
                },
                {
                  "text": {
                    "jp": "と"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l07_g02",
          "pattern": "人に 物を もらいます",
          "title": {
            "zh": "从某人收到某物",
            "en": "Receive something from someone"
          },
          "explanation": {
            "zh": "接收方用「もらいます」，来源前多用「に」。",

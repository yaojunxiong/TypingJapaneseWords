      "type": "grammar",
      "id": "l07_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l07_g01",
          "pattern": "人に 物を あげます",
          "title": {
            "zh": "给某人某物",
            "en": "Give something to someone"
          },
          "explanation": {
            "zh": "给出方用「あげます」，对象前用「に」。",
            "en": "Use 「あげます」 for giving; mark the receiver with 「に」."
          },
          "examples": [
            {
              "jp": "わたしは 友達に 本を あげました。",
              "zh": "我给朋友一本书。",
              "en": "I gave a book to my friend."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“给老师礼物”是？",
                "en": "How to say “give a present to the teacher”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生に プレゼントを あげます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生を プレゼントに あげます。"
                  }
                },
                {
                  "text": {
                    "jp": "先生で プレゼントを あげます。"
                  }
                },
                {
                  "text": {
                    "jp": "先生へ プレゼントが あげます。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "授予对象常用助词？",
                "en": "Which particle marks receiver?"
              },
              "options": [
                {
                  "text": {
                    "jp": "に"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "を"
                  }
                },
                {
                  "text": {
                    "jp": "で"
                  }
                },
                {
                  "text": {
                    "jp": "と"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l07_g02",
          "pattern": "人に 物を もらいます",
          "title": {
            "zh": "从某人收到某物",
            "en": "Receive something from someone"
          },
          "explanation": {
            "zh": "接收方用「もらいます」，来源前多用「に」。",
            "en": "Use 「もらいます」 from receiver perspective; source is marked by 「に」."
          },
          "examples": [
            {
              "jp": "わたしは 先生に 手紙を もらいました。",
              "zh": "我收到老师的信。",
              "en": "I received a letter from my teacher."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“我从朋友那儿借到书/收到书”是？",
                "en": "How to say “I received a book from a friend”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "友達に 本を もらいました。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "友達を 本に もらいました。"
                  }
                },
                {
                  "text": {
                    "jp": "友達で 本を もらいました。"
                  }
                },
                {
                  "text": {
                    "jp": "友達と 本を もらいました。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“收到”动词是？",
                "en": "Which verb means “receive”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "もらいます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "あげます"
                  }
                },
                {
                  "text": {
                    "jp": "かします"
                  }
                },
                {
                  "text": {
                    "jp": "ならいます"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l07_g03",
          "pattern": "人に 〜を かします / おしえます",
          "title": {
            "zh": "借给/教给某人",
            "en": "Lend/teach to someone"
          },
          "explanation": {
            "zh": "「かします・おしえます」也使用「人に」结构。",
            "en": "「かします / おしえます」 also take 「人に」."
          },
          "examples": [
            {
              "jp": "先生は わたしに 日本語を おしえます。",
              "zh": "老师教我日语。",
              "en": "The teacher teaches me Japanese."
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“借给朋友伞”是？",
                "en": "How to say “lend an umbrella to a friend”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "友達に 傘を かします。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "友達で 傘を かします。"
                  }
                },
                {
                  "text": {
                    "jp": "友達を 傘に かします。"
                  }
                },
                {
                  "text": {
                    "jp": "友達と 傘を かします。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“向老师学日语”可说？",
                "en": "How to say “learn Japanese from teacher”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "先生に 日本語を ならいます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "先生を 日本語に ならいます。"
                  }
                },
                {
                  "text": {
                    "jp": "先生で 日本語を ならいます。"
                  }
                },
                {
                  "text": {
                    "jp": "先生と 日本語を ならいます。"
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "l07_g04",
          "pattern": "もう 〜ましたか",
          "title": {
            "zh": "已经〜了吗",
            "en": "Have you already ~?"
          },
          "explanation": {
            "zh": "询问某动作是否已经完成。否定回答常用「まだです」。",
            "en": "Ask whether an action has already happened. Negative often uses 「まだです」."
          },
          "examples": [
            {
              "jp": "もう 昼ご飯を 食べましたか。",
              "zh": "已经吃午饭了吗？",
              "en": "Have you already had lunch?"
            }
          ],
          "practice": [
            {
              "question": {
                "zh": "“已经回家了吗？”是？",
                "en": "How to ask “Have you gone home already?”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "もう うちへ 帰りましたか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "もう うちへ 帰りますか。"
                  }
                },
                {
                  "text": {
                    "jp": "まだ うちへ 帰りましたか。"
                  }
                },
                {
                  "text": {
                    "jp": "うちへ もう 帰りますか。"
                  }
                }
              ]
            },
            {
              "question": {
                "zh": "“还没有”常用？",
                "en": "How to say “not yet”?"
              },
              "options": [
                {
                  "text": {
                    "jp": "まだです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "もうです。"
                  }
                },
                {
                  "text": {
                    "jp": "いいです。"
                  }
                },
                {
                  "text": {
                    "jp": "はいです。"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "examples",
      "id": "l07_examples",
      "title": {
        "zh": "核心例句",
        "en": "Core Examples",
        "ja": "基本例文"
      },
      "items": [
        {
          "id": "l07_e01",
          "jp": "わたしは 妹に はしを あげました。",
          "zh": "我给妹妹筷子。",
          "en": "I gave chopsticks to my younger sister."
        },
        {
          "id": "l07_e02",
          "jp": "先生に 日本語の 本を もらいました。",

          "zh": "我把伞借给朋友。",
          "en": "I lent an umbrella to my friend."
        },
        {
          "id": "l07_e04",
          "jp": "きのう 先生に 日本語を ならいました。",
          "zh": "昨天向老师学习了日语。",
          "en": "I learned Japanese from my teacher yesterday."
        },
        {
          "id": "l07_e05",
          "jp": "もう 宿題を しましたか。",
          "zh": "已经做作业了吗？",
          "en": "Have you already done your homework?"
        }
      ]

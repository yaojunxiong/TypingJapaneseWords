      "type": "grammar",
      "id": "l16_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l16_g01",
          "pattern": "い形容词くて／な形容词で",
          "title": {
            "zh": "形容词连接",
            "en": "Connecting adjectives"
          },
          "explanation": {
            "zh": "把两个描述自然连接。",
            "en": "Connect two descriptions naturally."
          },
          "examples": [
            {
              "jp": "この町は静かで、きれいです。",
              "zh": "这个城市安静又漂亮。",
              "en": "This town is quiet and beautiful."
            }
          ],
          "practice": [
            {
              "id": "l16_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“便宜又好吃”是？",
                "en": "How to say: cheap and tasty?"
              },
              "options": [
                {
                  "text": {
                    "jp": "安くて、おいしいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "安いで、おいしいです。"
                  }
                },
                {
                  "text": {
                    "jp": "安くで、おいしいです。"
                  }
                },
                {
                  "text": {
                    "jp": "安いくて、おいしいです。"
                  }
                }
              ],
              "explanation": {
                "zh": "把两个描述自然连接。",
                "en": "Connect two descriptions naturally."
              }
            },
            {
              "id": "l16_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“亲切又开朗”是？",
                "en": "How to say: kind and cheerful?"
              },
              "options": [
                {
                  "text": {
                    "jp": "親切で、明るいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "親切くて、明るいです。"
                  }
                },
                {
                  "text": {
                    "jp": "親切に、明るいです。"
                  }
                },
                {
                  "text": {
                    "jp": "親切が、明るいです。"
                  }
                }
              ],
              "explanation": {
                "zh": "把两个描述自然连接。",
                "en": "Connect two descriptions naturally."
              }
            }
          ]
        },
        {
          "id": "l16_g02",
          "pattern": "N1 は N2 が 〜です",
          "title": {
            "zh": "某人某方面……",
            "en": "N1 has N2 that is~"
          },
          "explanation": {
            "zh": "描述人或事物的具体特征。",
            "en": "Describe specific features of someone/something."
          },
          "examples": [
            {
              "jp": "山田さんは目が大きいです。",
              "zh": "山田的眼睛很大。",
              "en": "Ms. Yamada has big eyes."
            }
          ],
          "practice": [
            {
              "id": "l16_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“王先生个子高”是？",
                "en": "How to say: Mr. Wang is tall?"
              },
              "options": [
                {
                  "text": {
                    "jp": "王さんは背が高いです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "王さんは背を高いです。"
                  }
                },
                {

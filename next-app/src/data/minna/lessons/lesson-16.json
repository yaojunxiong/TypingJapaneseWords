      "type": "grammar",
      "id": "l16_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l16_g01",
          "pattern": "い形容词くて／な形容词で",
          "title": {
            "zh": "形容词连接",
            "en": "Connecting adjectives"
          },
          "explanation": {
            "zh": "把两个描述自然连接。",
            "en": "Connect two descriptions naturally."
          },
          "examples": [
            {
              "jp": "この町は静かで、きれいです。",
              "zh": "这个城市安静又漂亮。",
              "en": "This town is quiet and beautiful."
            }
          ],
          "practice": [
            {
              "id": "l16_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“便宜又好吃”是？",
                "en": "How to say: cheap and tasty?"
              },
              "options": [
                {
                  "text": {
                    "jp": "安くて、おいしいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "安いで、おいしいです。"
                  }
                },
                {
                  "text": {
                    "jp": "安くで、おいしいです。"
                  }
                },
                {
                  "text": {
                    "jp": "安いくて、おいしいです。"
                  }
                }
              ],
              "explanation": {
                "zh": "把两个描述自然连接。",
                "en": "Connect two descriptions naturally."
              }
            },
            {
              "id": "l16_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“亲切又开朗”是？",
                "en": "How to say: kind and cheerful?"
              },
              "options": [
                {
                  "text": {
                    "jp": "親切で、明るいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "親切くて、明るいです。"
                  }
                },
                {
                  "text": {
                    "jp": "親切に、明るいです。"
                  }
                },
                {
                  "text": {
                    "jp": "親切が、明るいです。"
                  }
                }
              ],
              "explanation": {
                "zh": "把两个描述自然连接。",
                "en": "Connect two descriptions naturally."
              }
            }
          ]
        },
        {
          "id": "l16_g02",
          "pattern": "N1 は N2 が 〜です",
          "title": {
            "zh": "某人某方面……",
            "en": "N1 has N2 that is~"
          },
          "explanation": {
            "zh": "描述人或事物的具体特征。",
            "en": "Describe specific features of someone/something."
          },
          "examples": [
            {
              "jp": "山田さんは目が大きいです。",
              "zh": "山田的眼睛很大。",
              "en": "Ms. Yamada has big eyes."
            }
          ],
          "practice": [
            {
              "id": "l16_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“王先生个子高”是？",
                "en": "How to say: Mr. Wang is tall?"
              },
              "options": [
                {
                  "text": {
                    "jp": "王さんは背が高いです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "王さんは背を高いです。"
                  }
                },
                {
                  "text": {
                    "jp": "王さんは背が高くです。"
                  }
                },
                {
                  "text": {
                    "jp": "王さんの背は高いがです。"
                  }
                }
              ],
              "explanation": {
                "zh": "描述人或事物的具体特征。",
                "en": "Describe specific features of someone/something."
              }
            },
            {
              "id": "l16_g02_p02",
              "skill": "grammar",
              "question": {
                "zh": "“这只狗耳朵很短”是？",
                "en": "How to say: This dog has short ears?"
              },
              "options": [
                {
                  "text": {
                    "jp": "この犬は耳が短いです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "この犬は耳を短いです。"
                  }
                },
                {
                  "text": {
                    "jp": "この犬で耳が短いです。"
                  }
                },
                {
                  "text": {
                    "jp": "この犬は耳が短くです。"
                  }
                }
              ],
              "explanation": {
                "zh": "描述人或事物的具体特征。",
                "en": "Describe specific features of someone/something."
              }
            }
          ]
        },
        {
          "id": "l16_g03",
          "pattern": "Vて、Vて、Vます",
          "title": {
            "zh": "动作并列",
            "en": "Listing actions"
          },
          "explanation": {
            "zh": "用て形连接多个连续动作。",
            "en": "Use te-form to list multiple actions."
          },
          "examples": [
            {
              "jp": "朝起きて、走って、シャワーを浴びます。",
              "zh": "早上起床、跑步、再冲澡。",
              "en": "I wake up, run, and take a shower."
            }
          ],
          "practice": [
            {
              "id": "l16_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“听音乐、唱歌、跳舞”是？",
                "en": "How to say: listen to music, sing and dance?"
              },
              "options": [
                {
                  "text": {
                    "jp": "音楽を聞いて、歌って、踊ります。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "音楽を聞きて、歌って、踊ります。"
                  }
                },
                {
                  "text": {
                    "jp": "音楽を聞いて、歌い、踊ります。"
                  }
                },
                {
                  "text": {
                    "jp": "音楽で聞いて、歌って、踊ります。"
                  }
                }
              ],
              "explanation": {
                "zh": "用て形连接多个连续动作。",
                "en": "Use te-form to list multiple actions."
              }
            },
            {
              "id": "l16_g03_p02",
              "skill": "grammar",
              "question": {
                "zh": "“回家、做饭、吃饭”是？",
                "en": "How to say: go home, cook, and eat?"
              },
              "options": [
                {
                  "text": {
                    "jp": "うちへ帰って、料理して、食べます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "うちへ帰りて、料理して、食べます。"
                  }
                },
                {
                  "text": {
                    "jp": "うちへ帰って、料理します、食べます。"
                  }
                },
                {
                  "text": {
                    "jp": "うちを帰って、料理して、食べます。"
                  }
                }
              ],
              "explanation": {
                "zh": "用て形连接多个连续动作。",
                "en": "Use te-form to list multiple actions."
              }
            }
          ]
        },
        {
          "id": "l16_g04",
          "pattern": "どうしてですか",
          "title": {
            "zh": "询问原因",
            "en": "Asking reason"
          },
          "explanation": {
            "zh": "用于追问理由，常配合「〜からです」。",
            "en": "Ask for a reason, often answered with kara desu."
          },
          "examples": [
            {
              "jp": "どうして運動しますか。健康だからです。",
              "zh": "为什么运动？因为健康。",
              "en": "Why exercise? Because of health."
            }
          ],
          "practice": [
            {
              "id": "l16_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“因为喜欢唱歌”是？",
                "en": "How to say: Because I like singing?"
              },
              "options": [
                {
                  "text": {
                    "jp": "歌が好きだからです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "歌が好きでからです。"
                  }
                },
                {
                  "text": {
                    "jp": "歌が好きですからだ。"
                  }
                },
                {
                  "text": {
                    "jp": "歌を好きだからです。"
                  }
                }
              ],
              "explanation": {
                "zh": "用于追问理由，常配合「〜からです」。",
                "en": "Ask for a reason, often answered with kara desu."
              }
            },
            {
              "id": "l16_g04_p02",
              "skill": "grammar",
              "question": {
                "zh": "问“为什么学日语？”是？",
                "en": "How to ask: Why do you study Japanese?"
              },
              "options": [
                {
                  "text": {
                    "jp": "どうして日本語を勉強しますか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "どうして日本語が勉強しますか。"
                  }
                },
                {
                  "text": {
                    "jp": "どうして日本語を勉強ですか。"
                  }
                },
                {
                  "text": {
                    "jp": "どうして日本語で勉強します。"
                  }
                }
              ],
              "explanation": {
                "zh": "用于追问理由，常配合「〜からです」。",
                "en": "Ask for a reason, often answered with kara desu."
              }
            }
          ]
        }
      ]
    },
    {
      "type": "examples",
      "id": "l16_examples",
      "title": {
        "zh": "核心例句",

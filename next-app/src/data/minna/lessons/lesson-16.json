      },
      "items": [
        {
          "id": "l16_e01",
          "jp": "この歌は短くて、覚えやすいです。",
          "zh": "这首歌短而且好记。",
          "en": "This song is short and easy to remember."
        },
        {
          "id": "l16_e02",
          "jp": "妹は手が小さくて、字がきれいです。",
          "zh": "我妹妹手小，字也漂亮。",
          "en": "My sister has small hands and beautiful handwriting."
        },
        {
          "id": "l16_e03",
          "jp": "朝起きて、コーヒーを飲んで、会社へ行きます。",
          "zh": "早上起床后喝咖啡再去公司。",
          "en": "I wake up, drink coffee, and go to work."
        },
        {
          "id": "l16_e04",
          "jp": "田中さんは親切で、みんなに人気があります。",
          "zh": "田中很亲切，大家都喜欢他。",
          "en": "Mr. Tanaka is kind and popular with everyone."
        },
        {
          "id": "l16_e05",
          "jp": "どうして毎日走りますか。健康だからです。",
          "zh": "你为什么每天跑步？因为想保持健康。",
          "en": "Why do you run every day? Because of health."
        }
      ]
    },

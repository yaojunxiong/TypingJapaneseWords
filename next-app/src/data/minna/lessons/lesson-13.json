  "subtitle": {
    "zh": "想要与愿望",
    "en": "Wants and desires",
    "ja": "欲しい・たい形"
  },
  "focus": {
    "zh": "学习「ほしい」「たいです」表达愿望，并用「〜から」说明原因。",
    "en": "Learn to express desires with hoshii/tai and give reasons with kara.",
    "ja": "「ほしい」「たいです」と「〜から」で希望と理由を言います。"
  },

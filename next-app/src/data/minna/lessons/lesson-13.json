    {
      "type": "grammar",
      "id": "l13_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l13_g01",
          "pattern": "N が ほしいです",
          "title": {
            "zh": "想要某物",
            "en": "Want a thing"
          },
          "explanation": {
            "zh": "用「が」表示想要的对象。",
            "en": "Use ga to mark the desired object."
          },
          "examples": [
            {
              "jp": "新しいカメラがほしいです。",
              "zh": "我想要一台新相机。",
              "en": "I want a new camera."
            }
          ],
          "practice": [
            {
              "id": "l13_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我想要时间”是？",
                "en": "How to say: I want time?"
              },
              "options": [
                {
                  "text": {
                    "jp": "時間がほしいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "時間をほしいです。"
                  }
                },
                {
                  "text": {
                    "jp": "時間にほしいです。"
                  }
                },
                {
                  "text": {
                    "jp": "時間はほしいか。"
                  }
                }
              ],
              "explanation": {
                "zh": "用「が」表示想要的对象。",
                "en": "Use ga to mark the desired object."
              }
            },
            {
              "id": "l13_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“她想要礼物”最自然是？",
                "en": "Most natural: She wants a present?"
              },
              "options": [
                {
                  "text": {
                    "jp": "彼女はプレゼントがほしいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "彼女はプレゼントをほしいです。"
                  }
                },
                {
                  "text": {
                    "jp": "彼女にプレゼントがほしいです。"
                  }
                },
                {
                  "text": {
                    "jp": "彼女はプレゼントほしいですか。"
                  }
                }
              ],
              "explanation": {
                "zh": "用「が」表示想要的对象。",
                "en": "Use ga to mark the desired object."
              }
            }
          ]
        },
        {
          "id": "l13_g02",
          "pattern": "V ます形 + たいです",
          "title": {
            "zh": "想做某事",
            "en": "Want to do"
          },
          "explanation": {
            "zh": "动词ます形去ます后接たい。",
            "en": "Attach tai to the verb stem (masu-stem)."
          },
          "examples": [
            {
              "jp": "日本へ旅行したいです。",
              "zh": "我想去日本旅行。",
              "en": "I want to travel to Japan."
            }
          ],
          "practice": [
            {
              "id": "l13_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“我想喝咖啡”是？",
                "en": "How to say: I want to drink coffee?"
              },
              "options": [
                {
                  "text": {
                    "jp": "コーヒーを飲みたいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "コーヒーを飲むたいです。"
                  }
                },
                {
                  "text": {
                    "jp": "コーヒーが飲みますたいです。"
                  }
                },
                {
                  "text": {
                    "jp": "コーヒーに飲みたいです。"
                  }
                }
              ],
              "explanation": {
                "zh": "动词ます形去ます后接たい。",
                "en": "Attach tai to the verb stem (masu-stem)."
              }
            },
            {
              "id": "l13_g02_p02",
              "skill": "grammar",
              "question": {
                "zh": "“想买手机”是？",
                "en": "How to say: want to buy a phone?"
              },
              "options": [
                {
                  "text": {
                    "jp": "スマホを買いたいです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "スマホを買いますたいです。"
                  }
                },
                {
                  "text": {
                    "jp": "スマホが買いたいですか。"
                  }
                },
                {
                  "text": {
                    "jp": "スマホに買いたいです。"
                  }
                }
              ],
              "explanation": {
                "zh": "动词ます形去ます后接たい。",
                "en": "Attach tai to the verb stem (masu-stem)."
              }
            }
          ]
        },
        {
          "id": "l13_g03",
          "pattern": "どこへ行きたいですか",
          "title": {
            "zh": "愿望问句",
            "en": "Asking desire"
          },
          "explanation": {
            "zh": "询问对方想去哪里、想做什么。",
            "en": "Ask where/what someone wants to do."
          },
          "examples": [
            {
              "jp": "週末どこへ行きたいですか。",
              "zh": "周末你想去哪里？",
              "en": "Where do you want to go this weekend?"
            }
          ],
          "practice": [
            {
              "id": "l13_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“你想吃什么？”是？",
                "en": "How to ask: What do you want to eat?"
              },
              "options": [
                {
                  "text": {
                    "jp": "何を食べたいですか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "何が食べますか。"
                  }
                },
                {
                  "text": {
                    "jp": "何を食べるですか。"
                  }
                },
                {
                  "text": {
                    "jp": "何で食べたいですか。"
                  }
                }
              ],
              "explanation": {
                "zh": "询问对方想去哪里、想做什么。",
                "en": "Ask where/what someone wants to do."
              }
            },
            {
              "id": "l13_g03_p02",
              "skill": "grammar",
              "question": {
                "zh": "“你想什么时候出发？”是？",
                "en": "How to ask: When do you want to leave?"
              },
              "options": [
                {
                  "text": {
                    "jp": "いつ出かけたいですか。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "いつ出かけますたいですか。"
                  }
                },
                {
                  "text": {
                    "jp": "いつを出かけたいですか。"
                  }
                },
                {
                  "text": {
                    "jp": "いつに出かけですか。"
                  }
                }
              ],
              "explanation": {
                "zh": "询问对方想去哪里、想做什么。",
                "en": "Ask where/what someone wants to do."
              }
            }
          ]
        },
        {
          "id": "l13_g04",
          "pattern": "〜から、〜",
          "title": {
            "zh": "说明理由",
            "en": "Giving a reason"
          },
          "explanation": {
            "zh": "用「から」说明原因。",
            "en": "Use kara to state the reason."
          },
          "examples": [
            {
              "jp": "時間がないですから、行きません。",
              "zh": "因为没时间，所以不去。",
              "en": "I won't go because I don't have time."
            }
          ],
          "practice": [
            {
              "id": "l13_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "“因为很忙，所以不休息”是？",
                "en": "How to say: Because I am busy, I do not rest?"
              },
              "options": [
                {
                  "text": {
                    "jp": "忙しいですから、休みません。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "忙しいからです、休みません。"
                  }
                },
                {
                  "text": {
                    "jp": "忙しいをから、休みません。"
                  }
                },
                {
                  "text": {
                    "jp": "忙しいですので、休みませんか。"
                  }
                }
              ],
              "explanation": {
                "zh": "用「から」说明原因。",
                "en": "Use kara to state the reason."
              }
            },
            {
              "id": "l13_g04_p02",
              "skill": "grammar",
              "question": {
                "zh": "哪句是“因为下雨，所以在家”？",
                "en": "Which means: Because it rains, I stay home?"
              },
              "options": [
                {
                  "text": {
                    "jp": "雨ですから、うちにいます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "雨が、うちにいますから。"
                  }
                },
                {
                  "text": {
                    "jp": "雨から、うちでいます。"
                  }
                },
                {
                  "text": {
                    "jp": "雨をから、うちにいます。"
                  }
                }
              ],
              "explanation": {
                "zh": "用「から」说明原因。",
                "en": "Use kara to state the reason."
              }
            }
          ]
        }
      ]
    },
    {
      "type": "examples",
      "id": "l13_examples",
      "title": {
        "zh": "核心例句",
        "en": "Core Examples",
        "ja": "基本例文"
      },
      "items": [
        {
          "id": "l13_e01",
          "jp": "私は新しい辞書がほしいです。",
          "zh": "我想要一本新词典。",
          "en": "I want a new dictionary."
        },
        {
          "id": "l13_e02",
          "jp": "週末に海へ行きたいです。",
          "zh": "周末我想去海边。",
          "en": "I want to go to the sea this weekend."
        },
        {
          "id": "l13_e03",
          "jp": "何を食べたいですか。",
          "zh": "你想吃什么？",
          "en": "What do you want to eat?"
        },
        {
          "id": "l13_e04",
          "jp": "お金がありませんから、買いません。",
          "zh": "因为没有钱，所以不买。",
          "en": "I will not buy it because I have no money."
        },
        {
          "id": "l13_e05",
          "jp": "夏休みに温泉へ行きたいです。",
          "zh": "暑假我想去温泉。",
          "en": "I want to go to a hot spring during summer vacation."
        }
      ]
    },
    {
      "type": "quiz",

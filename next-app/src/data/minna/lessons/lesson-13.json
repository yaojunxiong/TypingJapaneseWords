      },
      "items": [
        {
          "id": "l13_q01",
          "question": {
            "zh": "「欲しい」的意思是？",
            "en": "What does 欲しい mean?"
          },
          "options": [
            {
              "text": {
                "zh": "想要",
                "en": "want (thing)"
              },
              "correct": true
            },
            {
              "text": {
                "zh": "想借",
                "en": "want to borrow"
              }
            },
            {
              "text": {
                "zh": "想买",
                "en": "want to buy"
              }
            },
            {
              "text": {
                "zh": "想喝",
                "en": "want to drink"
              }
            }
          ],
          "explanation": {
            "zh": "「欲しい」表示「想要」。",
            "en": "欲しい means want (thing)."
          }
        },
        {
          "id": "l13_q02",
          "question": {
            "zh": "哪一句最符合语法「N が ほしいです」？",
            "en": "Which sentence best matches pattern \"N が ほしいです\"?"
          },
          "options": [
            {
              "text": {
                "jp": "新しいカメラがほしいです。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "日本へ旅行したいです。"
              }
            },
            {
              "text": {
                "jp": "週末どこへ行きたいですか。"
              }
            },
            {
              "text": {
                "jp": "時間がないですから、行きません。"
              }
            }
          ],
          "explanation": {
            "zh": "正确句型是「N が ほしいです」。",
            "en": "The correct pattern is \"N が ほしいです\"."
          }
        },
        {
          "id": "l13_q03",
          "question": {
            "zh": "关于「V ます形 + たいです」最恰当的是？",
            "en": "Which usage best fits \"V ます形 + たいです\"?"
          },
          "options": [
            {
              "text": {
                "jp": "コーヒーを飲みたいです。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "コーヒーを飲むたいです。"
              }
            },
            {
              "text": {
                "jp": "コーヒーが飲みますたいです。"
              }
            },
            {
              "text": {
                "jp": "コーヒーに飲みたいです。"
              }
            }
          ],
          "explanation": {
            "zh": "动词ます形去ます后接たい。",
            "en": "Attach tai to the verb stem (masu-stem)."
          }
        },
        {
          "id": "l13_q04",
          "question": {
            "zh": "与「我想要一本新词典。」对应的日语句子是？",
            "en": "Which Japanese sentence matches \"I want a new dictionary.\"?"
          },
          "options": [
            {
              "text": {
                "jp": "私は新しい辞書がほしいです。"
              },
              "correct": true
            },
            {
              "text": {
                "jp": "週末に海へ行きたいです。"
              }
            },
            {
              "text": {
                "jp": "何を食べたいですか。"
              }
            },
            {
              "text": {
                "jp": "お金がありませんから、買いません。"
              }
            }
          ],
          "explanation": {
            "zh": "对应句子是「私は新しい辞書がほしいです。」。",
            "en": "The matching sentence is \"私は新しい辞書がほしいです。\"."
          }
        }
      ]
    }

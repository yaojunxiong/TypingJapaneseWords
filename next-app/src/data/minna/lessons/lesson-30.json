    {
      "type": "grammar",
      "id": "l30_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l30_g01",
          "pattern": "他動詞て形 + あります",
          "explanation": {
            "zh": "表示有人为了某个目的已经做好，结果还保留着。",
            "en": "Shows someone has done something for a purpose and the result remains."
          },
          "examples": [
            {
              "jp": "窓が開けてあります。",
              "zh": "窗户已经开好了。",
              "en": "The window has been opened."
            }
          ],
          "practice": [
            {
              "id": "l30_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“窗户已经开好了”正确的是？",
                "en": "How do you say 'The window has been opened'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "窓が開けてあります"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "窓を開いてあります"
                  }
                },
                {
                  "text": {
                    "jp": "窓が開いてあります"
                  }
                },
                {
                  "text": {
                    "jp": "窓を開けています"
                  }
                }
              ],
              "explanation": {
                "zh": "人为结果用他动词て形 + あります。",
                "en": "Prepared result: transitive te-form + arimasu."
              }
            }
          ]
        },
        {
          "id": "l30_g02",
          "pattern": "N に N が Vてあります",
          "explanation": {
            "zh": "说明某处已经放好、写好、贴好某物。",
            "en": "Shows that something has been placed, written, or posted somewhere."
          },
          "examples": [
            {
              "jp": "黒板に予定が書いてあります。",
              "zh": "黑板上写着日程。",
              "en": "The schedule is written on the blackboard."
            }
          ],
          "practice": [
            {
              "id": "l30_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“墙上贴着地图”正确的是？",
                "en": "How do you say 'A map is posted on the wall'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "壁に地図が貼ってあります"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "壁を地図が貼ってあります"
                  }
                },
                {
                  "text": {
                    "jp": "壁に地図を貼っています"
                  }
                },
                {
                  "text": {
                    "jp": "壁が地図に貼ってあります"
                  }
                }
              ],
              "explanation": {
                "zh": "地点に + 物が + 他动词てあります。",
                "en": "Place ni + thing ga + transitive te arimasu."
              }
            }
          ]
        },
        {
          "id": "l30_g03",
          "pattern": "目的がある結果状態",
          "explanation": {
            "zh": "「てあります」通常暗示有人有目的地做了准备。",
            "en": "Te arimasu usually implies someone prepared it intentionally."
          },
          "examples": [
            {
              "jp": "会議の資料がコピーしてあります。",
              "zh": "会议资料已经复印好了。",
              "en": "The meeting materials have been copied."
            }
          ],
          "practice": [
            {
              "id": "l30_g03_p01",
              "skill": "grammar",
              "question": {
                "zh": "“资料已经复印好了”是？",
                "en": "How do you say 'The materials have been copied'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "資料がコピーしてあります"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "資料をコピーしてあります"
                  }
                },
                {
                  "text": {
                    "jp": "資料がコピーしています"
                  }
                },
                {
                  "text": {
                    "jp": "資料をコピーになっています"
                  }
                }
              ],
              "explanation": {
                "zh": "准备好的物用「が」。",
                "en": "The prepared item is marked with ga."
              }
            }
          ]
        },
        {
          "id": "l30_g04",
          "pattern": "自動詞ています vs 他動詞てあります",
          "explanation": {
            "zh": "「開いています」只描述状态；「開けてあります」暗示有人事先开好。",
            "en": "Aite imasu only describes a state; akete arimasu implies someone opened it in advance."
          },
          "examples": [
            {
              "jp": "ドアが開いています。 / ドアが開けてあります。",
              "zh": "门开着。/ 门已经开好了。",
              "en": "The door is open. / The door has been opened."
            }
          ],
          "practice": [
            {
              "id": "l30_g04_p01",
              "skill": "grammar",
              "question": {
                "zh": "强调“有人把门开好了”应选？",
                "en": "Which emphasizes someone opened the door in advance?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ドアが開けてあります"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ドアが開いています"
                  }
                },
                {
                  "text": {
                    "jp": "ドアを開いています"
                  }
                },
                {
                  "text": {
                    "jp": "ドアが開きます"
                  }
                }
              ],
              "explanation": {
                "zh": "人为准备结果用「開けてあります」。",
                "en": "Use akete arimasu for a prepared result."
              }
            }
          ]
        },
        {
          "id": "l30_g05",
          "pattern": "て形 + おきます",
          "explanation": {
            "zh": "为了将来方便，事先做某事。",
            "en": "Do something in advance for future convenience."
          },
          "examples": [
            {
              "jp": "旅行の前にホテルを予約しておきます。",
              "zh": "旅行前先订好酒店。",
              "en": "I will reserve a hotel before the trip."
            }
          ],
          "practice": [
            {
              "id": "l30_g05_p01",
              "skill": "grammar",
              "question": {
                "zh": "“开会前先复印资料”是？",
                "en": "How do you say 'copy the materials before the meeting'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "会議の前に資料をコピーしておきます"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "会議の前に資料がコピーしておきます"
                  }
                },
                {
                  "text": {
                    "jp": "会議の前に資料をコピーしてありますします"
                  }
                },
                {
                  "text": {
                    "jp": "会議の前に資料をコピーながらです"
                  }
                }
              ],
              "explanation": {
                "zh": "事先准备：て形 + おきます。",
                "en": "Preparation: te-form + okimasu."
              }
            }
          ]
        },
        {
          "id": "l30_g06",
          "pattern": "〜ておいてください",
          "explanation": {
            "zh": "请求对方事先做好某事。",
            "en": "Ask someone to do something in advance."
          },
          "examples": [
            {
              "jp": "資料を読んでおいてください。",
              "zh": "请事先读好资料。",
              "en": "Please read the materials in advance."
            }
          ],
          "practice": [
            {
              "id": "l30_g06_p01",
              "skill": "grammar",
              "question": {
                "zh": "“请先准备好”是？",
                "en": "How do you say 'Please prepare it in advance'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "準備しておいてください"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "準備してありますください"
                  }
                },
                {
                  "text": {
                    "jp": "準備していますください"
                  }
                },
                {
                  "text": {
                    "jp": "準備しながらください"
                  }
                }
              ],
              "explanation": {
                "zh": "请求预先动作：ておいてください。",
                "en": "Request prior preparation with te oite kudasai."
              }
            }
          ]
        },
        {
          "id": "l30_g07",
          "pattern": "そのままにしておきます",
          "explanation": {
            "zh": "表示保持原样、先不改变。",
            "en": "Means to leave something as it is."
          },
          "examples": [
            {
              "jp": "この机はそのままにしておいてください。",
              "zh": "这张桌子请保持原样。",
              "en": "Please leave this desk as it is."
            }
          ],
          "practice": [
            {
              "id": "l30_g07_p01",
              "skill": "grammar",
              "question": {
                "zh": "“请保持原样”是？",
                "en": "How do you say 'Please leave it as it is'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "そのままにしておいてください"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "そのままにしてありますください"
                  }
                },
                {
                  "text": {
                    "jp": "そのままになっていますください"
                  }
                },
                {
                  "text": {
                    "jp": "そのままでしてあります"
                  }
                }
              ],
              "explanation": {
                "zh": "固定常用表达。",
                "en": "This is a common fixed expression."
              }
            }
          ]
        },
        {
          "id": "l30_g08",
          "pattern": "使ったあとで戻しておきます",
          "explanation": {
            "zh": "表示用完后先放回、整理好，方便之后使用。",
            "en": "Return or tidy something after use so it is ready later."
          },
          "examples": [
            {
              "jp": "使ったあとで、元の場所に戻しておきます。",
              "zh": "用完后先放回原处。",
              "en": "After using it, put it back in its original place."
            }
          ],
          "practice": [
            {
              "id": "l30_g08_p01",
              "skill": "grammar",
              "question": {
                "zh": "“用完后请放回原处”是？",
                "en": "How do you say 'Please put it back after use'?"
              },
              "options": [
                {
                  "text": {
                    "jp": "使ったあとで、元の場所に戻しておいてください"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "使ったあとで、元の場所が戻しておいてください"
                  }
                },
                {
                  "text": {
                    "jp": "使ったあとで、元の場所に戻っています"
                  }
                },
                {
                  "text": {
                    "jp": "使ったあとで、元の場所に戻ってあります"
                  }
                }
              ],
              "explanation": {
                "zh": "他动词「戻します」用ておいてください。",
                "en": "Use the transitive modoshimasu with te oite kudasai."
              }
            }
          ]
        }
      ]
    },

    {
      "type": "grammar",
      "id": "l12_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l12_g01",
          "pattern": "い形容词 かったです／くなかったです",
          "title": {
            "zh": "い形容词过去式",
            "en": "Past of i-adjectives"
          },
          "explanation": {
            "zh": "描述过去状态：高かった、安くなかった。",
            "en": "Describe past states with i-adjective past forms."
          },
          "examples": [
            {
              "jp": "昨日は暑かったです。",
              "zh": "昨天很热。",
              "en": "It was hot yesterday."
            }
          ],
          "practice": [
            {
              "id": "l12_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“昨天不冷”是？",
                "en": "How to say: It was not cold yesterday?"
              },
              "options": [
                {
                  "text": {
                    "jp": "昨日は寒くなかったです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "昨日は寒かったないです。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日は寒いじゃありません。"
                  }
                },
                {
                  "text": {
                    "jp": "昨日は寒いなかったです。"
                  }
                }
              ],
              "explanation": {
                "zh": "描述过去状态：高かった、安くなかった。",
                "en": "Describe past states with i-adjective past forms."
              }
            },
            {
              "id": "l12_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“考试很难”过去式是？",
                "en": "Past form of \"The exam is difficult\"?"
              },
              "options": [
                {
                  "text": {
                    "jp": "試験は難しかったです。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "試験は難しいでした。"
                  }
                },
                {
                  "text": {
                    "jp": "試験は難しくでした。"
                  }
                },
                {
                  "text": {
                    "jp": "試験は難しかったないです。"
                  }
                }
              ],
              "explanation": {
                "zh": "描述过去状态：高かった、安くなかった。",
                "en": "Describe past states with i-adjective past forms."
              }
            }
          ]
        },
        {
          "id": "l12_g02",
          "pattern": "な形容词／名词 でした／じゃありませんでした",
          "title": {
            "zh": "な形容词与名词过去式",
            "en": "Past of na-adjectives/nouns"
          },
          "explanation": {
            "zh": "过去肯定用でした，否定用じゃありませんでした。",
            "en": "Use deshita / ja arimasen deshita for past forms."
          },
          "examples": [
            {
              "jp": "去年ここは静かでした。",
              "zh": "去年这里很安静。",
              "en": "It was quiet here last year."
            }
          ],
          "practice": [
            {
              "id": "l12_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“以前不方便”是？",
                "en": "How to say: It was not convenient before?"
              },
              "options": [
                {
                  "text": {
                    "jp": "前は便利じゃありませんでした。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "前は便利くなかったです。"
                  }
                },
                {
                  "text": {
                    "jp": "前は便利ではないです。"
                  }
                },
                {
                  "text": {
                    "jp": "前は便利かったです。"
                  }
                }
              ],
              "explanation": {
                "zh": "过去肯定用でした，否定用じゃありませんでした。",
                "en": "Use deshita / ja arimasen deshita for past forms."
              }
            },
            {

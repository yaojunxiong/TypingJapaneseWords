    {
      "type": "grammar",
      "id": "l14_grammar",
      "title": {
        "zh": "核心语法",
        "en": "Core Grammar",
        "ja": "基本文法"
      },
      "items": [
        {
          "id": "l14_g01",
          "pattern": "Vて ください",
          "title": {
            "zh": "礼貌请求",
            "en": "Polite request"
          },
          "explanation": {
            "zh": "请对方做某事。",
            "en": "Politely request someone to do something."
          },
          "examples": [
            {
              "jp": "ここに名前を書いてください。",
              "zh": "请在这里写名字。",
              "en": "Please write your name here."
            }
          ],
          "practice": [
            {
              "id": "l14_g01_p01",
              "skill": "grammar",
              "question": {
                "zh": "“请等一下”是？",
                "en": "How to say: Please wait a moment?"
              },
              "options": [
                {
                  "text": {
                    "jp": "ちょっと待ってください。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "ちょっと待ちください。"
                  }
                },
                {
                  "text": {
                    "jp": "ちょっと待つください。"
                  }
                },
                {
                  "text": {
                    "jp": "ちょっと待ってくれます。"
                  }
                }
              ],
              "explanation": {
                "zh": "请对方做某事。",
                "en": "Politely request someone to do something."
              }
            },
            {
              "id": "l14_g01_p02",
              "skill": "grammar",
              "question": {
                "zh": "“请开窗”是？",
                "en": "How to say: Please open the window?"
              },
              "options": [
                {
                  "text": {
                    "jp": "窓を開けてください。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "窓が開けてください。"
                  }
                },
                {
                  "text": {
                    "jp": "窓を開けますください。"
                  }
                },
                {
                  "text": {
                    "jp": "窓を開いてください。"
                  }
                }
              ],
              "explanation": {
                "zh": "请对方做某事。",
                "en": "Politely request someone to do something."
              }
            }
          ]
        },
        {
          "id": "l14_g02",
          "pattern": "Vて、Vます",
          "title": {
            "zh": "动作顺序",
            "en": "Action sequence"
          },
          "explanation": {
            "zh": "表示先后发生的动作。",
            "en": "Shows actions in sequence."
          },
          "examples": [
            {
              "jp": "朝ごはんを食べて、学校へ行きます。",
              "zh": "吃完早饭去学校。",
              "en": "I eat breakfast and go to school."
            }
          ],
          "practice": [
            {
              "id": "l14_g02_p01",
              "skill": "grammar",
              "question": {
                "zh": "“看书后睡觉”是？",
                "en": "How to say: read a book and then sleep?"
              },
              "options": [
                {
                  "text": {
                    "jp": "本を読んで、寝ます。"
                  },
                  "correct": true
                },
                {
                  "text": {
                    "jp": "本を読んで寝て。"
                  }

# Brevo SMTP for business email notifications (workflow etc.)
# These are already configured in Vercel environment variables.
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=
# BREVO_SMTP_PASS=
# EMAIL_FROM=   (optional, defaults to BREVO_SMTP_USER)
# ADMIN_NOTIFICATION_EMAIL=   (admin receives workflow notifications)
# (legacy: ADMIN_EMAIL is also accepted as fallback for ADMIN_NOTIFICATION_EMAIL)


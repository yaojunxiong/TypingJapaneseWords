{
  "name": "minna-next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local-recitation": "LOCAL_RECITATION_TOOL=1 next dev --port 3003",
    "video-worker": "node --env-file=.env.local --import=tsx/esm scripts/recitation-video-worker.ts",
    "video-worker:check": "node --env-file=.env.local --import=tsx/esm scripts/recitation-video-worker-check.ts",

    "react-dom": "19.1.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.17",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.18",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }

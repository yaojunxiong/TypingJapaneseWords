        { "no": "4", "text": "あの 方は どなたですか。", "cn": "那位是谁？" },
        { "text": "ワットさんです。さくら大学の 先生です。", "cn": "是瓦特先生。是樱花大学的老师。" },
        { "no": "5", "text": "グプタさんは 会社員ですか。", "cn": "古普塔先生是公司职员吗？" },
        { "text": "はい、会社員です。", "cn": "是的，是公司职员。" },
        { "text": "カリナさんも 会社員ですか。", "cn": "卡莉娜也是公司职员吗？" },
        { "text": "いいえ、［カリナさんは］学生です。", "cn": "不，卡莉娜是学生。" },

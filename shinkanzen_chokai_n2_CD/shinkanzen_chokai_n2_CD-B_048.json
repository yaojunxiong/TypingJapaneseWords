[
  {
    "start": "00:00:03,759",
    "end": "00:00:04,480",
    "jp": "3番",
    "zh": "3号"
  },
  {
    "start": "00:00:04,480",
    "end": "00:00:10,320",
    "jp": "男の人が先輩にフリーマーケットに必要なものについて聞いています",
    "zh": "一个男人问他的长者在跳蚤市场上需要什么"
  },
  {
    "start": "00:00:10,320",
    "end": "00:00:14,000",
    "jp": "男の人はこれから何を準備しますか?",
    "zh": "这个男人现在会做什么？"
  },
  {
    "start": "00:00:15,060",
    "end": "00:00:18,100",
    "jp": "フリーマーケットで物を売るのはじめてなんですが",
    "zh": "这是我第一次在跳蚤市场上出售商品。"
  },
  {
    "start": "00:00:18,100",
    "end": "00:00:21,000",
    "jp": "他に必要な物があったら教えていただけますか?",
    "zh": "❌ 翻译失败"
  },
  {
    "start": "00:00:21,719",
    "end": "00:00:24,179",
    "jp": "売る物は一応ここにまとめてあるんですけど",
    "zh": "❌ 翻译失败"
  },
  {
    "start": "00:00:24,179",
    "end": "00:00:29,339",
    "jp": "えっと、まずはこれみんな並べるんだから",
    "zh": "好吧，首先，我将它们排成一行"
  },
  {
    "start": "00:00:29,339",
    "end": "00:00:32,299",
    "jp": "下に敷く大きいシートがいるね",
    "zh": "下面有一张大床单"
  },
  {
    "start": "00:00:32,299",
    "end": "00:00:34,479",
    "jp": "毛布ぐらいの大きさの",
    "zh": "毯子的大小"
  },
  {
    "start": "00:00:34,479",
    "end": "00:00:35,340",
    "jp": "分かりました",
    "zh": "理解"
  },
  {
    "start": "00:00:35,340",
    "end": "00:00:37,960",
    "jp": "根札はもう付けてあるね",
    "zh": "根标签已经连接"
  },
  {
    "start": "00:00:37,960",
    "end": "00:00:41,299",
    "jp": "あと、これお金を入れる袋だよね",
    "zh": "另外，这是一个赚钱的包"
  },
  {
    "start": "00:00:42,060",
    "end": "00:00:44,200",
    "jp": "あ、お釣り用意してある?",
    "zh": "哦，您准备好改变了吗？"
  },
  {
    "start": "00:00:44,859",
    "end": "00:00:47,100",
    "jp": "これぐらいで足りるでしょうか?",
    "zh": "这够了吗？"
  },
  {
    "start": "00:00:47,219",
    "end": "00:00:49,619",
    "jp": "もっと細かいお金がないと",
    "zh": "没有更多详细的钱"
  },
  {
    "start": "00:00:49,619",
    "end": "00:00:52,000",
    "jp": "あと、この紙は何?",
    "zh": "这是什么论文？"
  },
  {
    "start": "00:00:52,000",
    "end": "00:00:54,700",
    "jp": "ああ、これは包む紙です",
    "zh": "啊，这是包装纸"
  },
  {
    "start": "00:00:54,700",
    "end": "00:00:57,939",
    "jp": "うーん、ドットお客さんが来ると",
    "zh": "❌ 翻译失败"
  },
  {
    "start": "00:00:57,939",
    "end": "00:01:01,140",
    "jp": "包んでる時間ないかもしれないよ",
    "zh": "❌ 翻译失败"
  },
  {
    "start": "00:01:01,140",
    "end": "00:01:05,980",
    "jp": "ポンと袋に入れてすぐ渡せるようにした方がいいんじゃないかな",
    "zh": "❌ 翻译失败"
  },
  {
    "start": "00:01:05,980",
    "end": "00:01:09,920",
    "jp": "袋は代償できるだけたくさんあった方がいいね",
    "zh": "❌ 翻译失败"
  },
  {
    "start": "00:01:09,920",
    "end": "00:01:12,859",
    "jp": "じゃあ、こんなレジ袋でいいでしょうか?",
    "zh": "❌ 翻译失败"
  },
  {
    "start": "00:01:13,480",
    "end": "00:01:16,659",
    "jp": "うーん、紙袋の方が喜ばれると思うけど",
    "zh": "嗯，我认为纸袋会更令人愉悦"
  },
  {
    "start": "00:01:16,659",
    "end": "00:01:17,859",
    "jp": "分かりました",
    "zh": "❌ 翻译失败"
  },
  {
    "start": "00:01:17,859",
    "end": "00:01:21,200",
    "jp": "チーン",
    "zh": "张"
  },
  {
    "start": "00:01:21,200",
    "end": "00:01:25,359",
    "jp": "男の人はこれから何を準備しますか?",
    "zh": "这个男人现在会做什么？"
  }
]
    "jp": "練習4",
    "zh": "练习4"
  },
  {
    "start": "00:00:03,560",
    "end": "00:00:03,960",
    "jp": "1",
    "zh": "1"
  },
  {
    "start": "00:00:03,960",
    "end": "00:00:05,900",
    "jp": "レジ袋いりませんカード",
    "zh": "不需要塑料袋"
  },
  {
    "start": "00:00:05,900",
    "end": "00:00:07,919",
    "jp": "というのをご存知ですか",
    "zh": "你知道吗？"
  },
  {
    "start": "00:00:07,919",
    "end": "00:00:10,339",
    "jp": "スーパーのレジでこのカードを",
    "zh": "在超市的登记册上制作这张卡"
  },
  {
    "start": "00:00:10,339",
    "end": "00:00:12,000",
    "jp": "買い物カゴに入れるんです",
    "zh": "我会把它添加到我的购物车中"
  },
  {
    "start": "00:00:12,519",
    "end": "00:00:14,419",
    "jp": "そうするとレジ袋を",
    "zh": "那你可以做一个塑料袋"
  },
  {
    "start": "00:00:14,419",
    "end": "00:00:15,820",
    "jp": "断ることができる",
    "zh": "你可以拒绝"
  },
  {
    "start": "00:00:15,820",
    "end": "00:00:17,980",
    "jp": "というものです",
    "zh": "就是这样"
  },
  {
    "start": "00:00:17,980",
    "end": "00:00:20,280",
    "jp": "袋はいりませんと声に出して",
    "zh": "我大声说我不需要袋子"
  },
  {
    "start": "00:00:20,280",
    "end": "00:00:22,239",
    "jp": "言うのが面倒だと思う人がいる",
    "zh": "有人发现很麻烦"
  },
  {
    "start": "00:00:22,239",
    "end": "00:00:24,420",
    "jp": "ことから作られたんですね",
    "zh": "它是由此制成的"
  },
  {
    "start": "00:00:24,420",
    "end": "00:00:26,100",
    "jp": "しかしこのカード",
    "zh": "但是这张卡"
  },
  {
    "start": "00:00:26,100",
    "end": "00:00:28,820",
    "jp": "ができてレジ袋を断る人は",
    "zh": "那些做到了并拒绝使用塑料袋的人"
  },
  {
    "start": "00:00:28,820",
    "end": "00:00:30,820",
    "jp": "増えているのでしょうか",
    "zh": "它在增加吗？"
  },
  {
    "start": "00:00:31,359",
    "end": "00:00:33,799",
    "jp": "それよりもしレジ袋に",
    "zh": "而不是那是一个塑料袋"
  },
  {
    "start": "00:00:33,799",
    "end": "00:00:35,240",
    "jp": "5円でも10円でも",
    "zh": "5日元或10日元"
  },
  {
    "start": "00:00:35,240",
    "end": "00:00:36,820",
    "jp": "お金がかかるとなれば",
    "zh": "如果花钱"
  },
  {
    "start": "00:00:37,380",
    "end": "00:00:39,100",
    "jp": "少し面倒でも自分の",
    "zh": "有点麻烦，但这是我自己的"
  },
  {
    "start": "00:00:39,100",
    "end": "00:00:40,960",
    "jp": "袋を持っていくんじゃないかと思います",
    "zh": "我想我会带一个书包"
  }
]
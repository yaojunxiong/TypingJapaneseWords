    "jp": "練習2",
    "zh": "练习2"
  },
  {
    "start": "00:00:03,319",
    "end": "00:00:03,799",
    "jp": "1",
    "zh": "1"
  },
  {
    "start": "00:00:03,799",
    "end": "00:00:07,799",
    "jp": "家で女の人と男の人が話しています",
    "zh": "一个女人和一个男人在家聊天"
  },
  {
    "start": "00:00:07,799",
    "end": "00:00:11,699",
    "jp": "女の人はこの後まず何をすればいいですか",
    "zh": "一个女人之后应该做什么？"
  },
  {
    "start": "00:00:15,660",
    "end": "00:00:16,620",
    "jp": "うわー",
    "zh": "哇"
  },
  {
    "start": "00:00:16,620",
    "end": "00:00:19,039",
    "jp": "こんなに細かく割れちゃって",
    "zh": "破碎了"
  },
  {
    "start": "00:00:19,039",
    "end": "00:00:21,039",
    "jp": "どうしよう",
    "zh": "我应该怎么办"
  },
  {
    "start": "00:00:22,719",
    "end": "00:00:23,199",
    "jp": "あっ",
    "zh": "啊"
  },
  {
    "start": "00:00:23,199",
    "end": "00:00:25,000",
    "jp": "いったい",
    "zh": "我勒个去"
  },
  {
    "start": "00:00:25,699",
    "end": "00:00:27,219",
    "jp": "血が出ちゃった",
    "zh": "我开始流血"
  },
  {
    "start": "00:00:27,219",
    "end": "00:00:29,300",
    "jp": "落ち着いて落ち着いて",
    "zh": "冷静而平静"
  },
  {
    "start": "00:00:29,300",
    "end": "00:00:33,359",
    "jp": "割れたガラスをそのまま手で触るから怪我をするんだよ",
    "zh": "您受伤是因为您用手触摸破碎的玻璃。"
  },
  {
    "start": "00:00:33,359",
    "end": "00:00:36,039",
    "jp": "ガラスを片付けるのは後回し",
    "zh": "放开玻璃是一个延迟"
  },
  {
    "start": "00:00:36,039",
    "end": "00:00:39,759",
    "jp": "それよりまずは血が出ている指に伴奏膏を貼って",
    "zh": "首先，将伴奏石膏放在您的血腥手指上"
  },
  {
    "start": "00:00:39,759",
    "end": "00:00:43,500",
    "jp": "その前にティッシュで血を拭き取らないと",
    "zh": "在此之前，您必须用纸巾擦除血液"
  },
  {
    "start": "00:00:43,500",
    "end": "00:00:44,000",
    "jp": "はい",
    "zh": "是的"
  },
  {
    "start": "00:00:44,000",
    "end": "00:00:46,280",
    "jp": "ティッシュと伴奏膏",
    "zh": "组织和伴奏石膏"
  },
  {
    "start": "00:00:46,280",
    "end": "00:00:49,700",
    "jp": "片付けるときはゴムの手袋しないとダメだよ",
    "zh": "清洁橡胶手套需要戴上"
  }
]
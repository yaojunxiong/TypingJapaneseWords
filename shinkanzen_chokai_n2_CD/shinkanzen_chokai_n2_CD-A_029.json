[
  {
    "start": "00:00:00,000",
    "end": "00:00:03,240",
    "jp": "練習1-2",
    "zh": "练习1-2"
  },
  {
    "start": "00:00:04,459",
    "end": "00:00:04,940",
    "jp": "1",
    "zh": "1"
  },
  {
    "start": "00:00:04,940",
    "end": "00:00:09,519",
    "jp": "先生が試験の時に必要なものについて話しています",
    "zh": "老师谈论您的考试需要什么"
  },
  {
    "start": "00:00:09,519",
    "end": "00:00:13,660",
    "jp": "女の人はこれから何を準備しますか?",
    "zh": "女人从现在开始做什么？"
  },
  {
    "start": "00:00:13,960",
    "end": "00:00:15,960",
    "jp": "試験明日だっけ",
    "zh": "明天考试吗？"
  },
  {
    "start": "00:00:15,960",
    "end": "00:00:18,039",
    "jp": "持っていくものもう準備した?",
    "zh": "您是否已经准备好自己想带来的东西了？"
  },
  {
    "start": "00:00:18,879",
    "end": "00:00:19,359",
    "jp": "はい",
    "zh": "是的"
  },
  {
    "start": "00:00:19,359",
    "end": "00:00:22,960",
    "jp": "受験表と筆記用具はカバンに入れてあります",
    "zh": "考试纸和写作用具在您的包里"
  },
  {
    "start": "00:00:22,960",
    "end": "00:00:26,000",
    "jp": "他に何か必要なものありますか?",
    "zh": "我还需要什么吗？"
  },
  {
    "start": "00:00:27,039",
    "end": "00:00:30,800",
    "jp": "うーんあの試験会場広くて寒いから",
    "zh": "嗯，那个考试场地宽敞而寒冷"
  },
  {
    "start": "00:00:30,800",
    "end": "00:00:34,539",
    "jp": "薄い毛布とかザブトンとかあった方がいいよ",
    "zh": "最好有一条薄薄的毯子或Zabton"
  },
  {
    "start": "00:00:34,539",
    "end": "00:00:36,679",
    "jp": "毛布なら家にあると思います",
    "zh": "我想我在家有毯子"
  },
  {
    "start": "00:00:37,200",
    "end": "00:00:38,960",
    "jp": "それを持っていけばいいかな",
    "zh": "也许我应该带"
  },
  {
    "start": "00:00:38,960",
    "end": "00:00:40,039",
    "jp": "そうだね",
    "zh": "我同意"
  },
  {
    "start": "00:00:40,460",
    "end": "00:00:42,399",
    "jp": "あ飲み物も",
    "zh": "哦，也喝"
  },
  {
    "start": "00:00:42,399",
    "end": "00:00:46,219",
    "jp": "暖かいものの方がいいからペットボトルじゃない方がいいね",
    "zh": "最好使用温暖的食物，因此最好不要使用塑料瓶。"
  },
  {
    "start": "00:00:46,219",
    "end": "00:00:47,899",
    "jp": "すぐ冷たくなっちゃうから",
    "zh": "很快就变冷了"
  },
  {
    "start": "00:00:47,899",
    "end": "00:00:50,340",
    "jp": "はい飲み物と",
    "zh": "是的，喝酒"
  },
  {
    "start": "00:00:50,780",
    "end": "00:00:53,380",
    "jp": "あ時計は?いつもどうしてる?",
    "zh": "哦，时钟呢？你一直在做什么？"
  },
  {
    "start": "00:00:53,380",
    "end": "00:00:57,240",
    "jp": "いつもは携帯電話の時計を使ってるんですけど",
    "zh": "我通常使用手机手表"
  },
  {
    "start": "00:00:57,240",
    "end": "00:00:58,939",
    "jp": "それはまずいね",
    "zh": "那很糟糕"
  },
  {
    "start": "00:00:58,939",
    "end": "00:01:00,920",
    "jp": "試験中は使えないんだよ",
    "zh": "考试期间无法使用"
  },
  {
    "start": "00:01:00,920",
    "end": "00:01:02,460",
    "jp": "あそうか",
    "zh": "我懂了"
  },
  {
    "start": "00:01:02,460",
    "end": "00:01:03,219",
    "jp": "わかりました",
    "zh": "知道了"
  }
]
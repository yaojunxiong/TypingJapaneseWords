[
  {
    "start": "00:00:03,520",
    "end": "00:00:04,080",
    "jp": "3",
    "zh": "3"
  },
  {
    "start": "00:00:04,080",
    "end": "00:00:09,039",
    "jp": "女の人が男の人に電話をかけて話しています",
    "zh": "一个女人在打电话给男人说话"
  },
  {
    "start": "00:00:09,039",
    "end": "00:00:12,720",
    "jp": "もしもし鈴木です中田くん",
    "zh": "如果是铃木，nakata-kun"
  },
  {
    "start": "00:00:12,720",
    "end": "00:00:14,839",
    "jp": "あ、野添ちゃん何",
    "zh": "哦，Nozoe-chan呢？"
  },
  {
    "start": "00:00:14,839",
    "end": "00:00:17,839",
    "jp": "あの明日のことなんだけど",
    "zh": "那是明天"
  },
  {
    "start": "00:00:17,839",
    "end": "00:00:20,100",
    "jp": "うん3時だったよね",
    "zh": "是的是3点"
  },
  {
    "start": "00:00:20,100",
    "end": "00:00:24,660",
    "jp": "うん実は急に先生と会うことになっちゃって",
    "zh": "是的，我突然不得不见我的老师。"
  },
  {
    "start": "00:00:24,660",
    "end": "00:00:25,739",
    "jp": "そうなの",
    "zh": "是这样吗？"
  },
  {
    "start": "00:00:26,500",
    "end": "00:00:29,739",
    "jp": "うん論文のことで来週会うことになってたんだけど",
    "zh": "是的，我本来应该在下周见面有关论文"
  },
  {
    "start": "00:00:30,640",
    "end": "00:00:33,600",
    "jp": "先生に急な用事ができちゃったらしくて",
    "zh": "显然，老师突然有事。"
  },
  {
    "start": "00:00:33,600",
    "end": "00:00:36,060",
    "jp": "明日しか会いてないって言われちゃって",
    "zh": "有人告诉我明天只会见面"
  },
  {
    "start": "00:00:36,060",
    "end": "00:00:37,799",
    "jp": "ふーん",
    "zh": "唔"
  },
  {
    "start": "00:00:37,799",
    "end": "00:00:44,899",
    "jp": "次に会えるとしたら2週間先だからその間論文の話ができないのも心配で",
    "zh": "如果我下次可以再次见面，那是两个星期的路程，所以我担心在此期间我将无法谈论这篇论文。"
  },
  {
    "start": "00:00:44,899",
    "end": "00:00:46,740",
    "jp": "研究室に行くことにしちゃったんだ",
    "zh": "我决定去实验室"
  },
  {
    "start": "00:00:47,299",
    "end": "00:00:48,500",
    "jp": "そっか",
    "zh": "我懂了"
  },
  {
    "start": "00:00:48,500",
    "end": "00:00:53,299",
    "jp": "急にキャンセルして本当にごめんね今度なんかおごるから",
    "zh": "抱歉，我突然取消了，我有一天会对待您"
  },
  {
    "start": "00:00:53,299",
    "end": "00:00:59,359",
    "jp": "わかった何ご馳走してもらおうかな考えとくよ",
    "zh": "我明白，我会考虑吃什么"
  },
  {
    "start": "00:01:01,859",
    "end": "00:01:05,980",
    "jp": "女の人はどうして友達に電話をかけましたか",
    "zh": "女人为什么打电话给朋友？"
  },
  {
    "start": "00:01:06,939",
    "end": "00:01:09,280",
    "jp": "1約束を確認するため",
    "zh": "1来确认承诺"
  },
  {
    "start": "00:01:10,659",
    "end": "00:01:13,200",
    "jp": "2先生の都合を知らせるため",
    "zh": "2通知老师的便利"
  },
  {
    "start": "00:01:14,540",
    "end": "00:01:17,400",
    "jp": "3ご馳走することを約束するため",
    "zh": "3保证有待遇"
  },
  {
    "start": "00:01:18,760",
    "end": "00:01:21,480",
    "jp": "4明日の約束を断るため",
    "zh": "4拒绝明天的承诺"
  },
  {
    "start": "00:01:25,040",
    "end": "00:01:27,840",
    "jp": "4明日の約束を断るため",
    "zh": "4拒绝明天的承诺"
  }
]
[
  {
    "start": "00:00:00,000",
    "end": "00:00:02,000",
    "jp": "例題2",
    "zh": "示例2"
  },
  {
    "start": "00:00:02,620",
    "end": "00:00:06,679",
    "jp": "朝、家で女の人と男の人が話しています。",
    "zh": "一个女人和一个男人在早上在家聊天。"
  },
  {
    "start": "00:00:07,379",
    "end": "00:00:10,560",
    "jp": "男の人はこの後まず何をしますか?",
    "zh": "一个人之后会做什么？"
  },
  {
    "start": "00:00:11,679",
    "end": "00:00:16,780",
    "jp": "えーっと、こっちが朝ごはんで、こっちがお弁当用で。",
    "zh": "好吧，这是早餐，这是午餐。"
  },
  {
    "start": "00:00:17,179",
    "end": "00:00:20,079",
    "jp": "そろそろ朝ごはんできるから食べて。",
    "zh": "我很快就可以吃早餐，所以吃。"
  },
  {
    "start": "00:00:25,960",
    "end": "00:00:29,179",
    "jp": "洗濯終わったみたいだけど、俺補そうか。",
    "zh": "看来我已经洗完了，但我想是的。"
  },
  {
    "start": "00:00:29,179",
    "end": "00:00:33,039",
    "jp": "お願いできる?後で新聞も撮ってきてね。",
    "zh": "你能吗？请稍后给报纸拍照。"
  },
  {
    "start": "00:00:33,280",
    "end": "00:00:34,780",
    "jp": "私お弁当作っちゃうから。",
    "zh": "我做午餐。"
  },
  {
    "start": "00:00:34,920",
    "end": "00:00:35,859",
    "jp": "うん、いいよ。",
    "zh": "是的，很好。"
  },
  {
    "start": "00:00:36,159",
    "end": "00:00:39,700",
    "jp": "あ、いけない。資源ゴミの日、今日だった。",
    "zh": "哦，这是不可能的。今天是资源浪费的一天。"
  },
  {
    "start": "00:00:40,219",
    "end": "00:00:41,520",
    "jp": "ちょっと行ってきてくれる?",
    "zh": "你会出来片刻吗？"
  },
  {
    "start": "00:00:41,960",
    "end": "00:00:44,799",
    "jp": "うん。ここにある瓶と缶だけでいい?",
    "zh": "是的。可以有瓶子可以在这里吗？"
  },
  {
    "start": "00:00:45,600",
    "end": "00:00:46,960",
    "jp": "これ干したら行ってくれよ。",
    "zh": "当我干燥时，我会去。"
  },
  {
    "start": "00:00:47,179",
    "end": "00:00:51,299",
    "jp": "あ、でも缶の回収がそろそろ来ちゃうから先にお願い。",
    "zh": "哦，但是我会尽快收集一些罐子，所以请先做。"
  },
  {
    "start": "00:00:51,920",
    "end": "00:00:53,280",
    "jp": "あと、この瓶も。",
    "zh": "还有这个瓶子。"
  },
  {
    "start": "00:00:53,560",
    "end": "00:00:53,960",
    "jp": "わかった。",
    "zh": "理解。"
  }
]
    "jp": "そうねお父さんは使わないわね",
    "zh": "是的，爸爸不使用它"
  },
  {
    "start": "00:00:32,780",
    "end": "00:00:36,100",
    "jp": "でも修理するのもお金がかかるでしょ",
    "zh": "但是维修也会花钱"
  },
  {
    "start": "00:00:36,100",
    "end": "00:00:37,460",
    "jp": "買い換えてもいいんじゃない",

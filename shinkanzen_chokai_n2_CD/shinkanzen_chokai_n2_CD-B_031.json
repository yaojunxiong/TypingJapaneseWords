  },
  {
    "start": "00:00:02,560",
    "end": "00:00:06,419",
    "jp": "家族3人がテレビについて話しています",
    "zh": "三个家庭成员谈论电视"
  },
  {
    "start": "00:00:07,040",
    "end": "00:00:08,000",
    "jp": "ああまただ",
    "zh": "哦，又来了"
  },
  {
    "start": "00:00:08,699",
    "end": "00:00:11,279",
    "jp": "ねえテレビまたおかしいよ",
    "zh": "嘿电视又很奇怪"
  },
  {
    "start": "00:00:11,279",
    "end": "00:00:13,300",
    "jp": "そろそろ買い換えようよ",
    "zh": "我很快就会买一个新的"
  },
  {
    "start": "00:00:13,300",
    "end": "00:00:16,899",
    "jp": "ああ最近時々線が入るのよね",
